---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ImmigrationCategories from '~/components/ImmigrationCategories.astro';
import ServiceSections from '~/components/ServiceSections.astro';
import HelpCta from '~/components/HelpCta.astro';

const title = 'USCIS Immigration Document Preparation | Imverica Legal Solutions';
const description =
  'USCIS immigration form preparation in English, Russian, Ukrainian, and Spanish — I-485, I-130, I-765, I-589, N-400, I-131, I-90, U4U re-parole, TPS. California Registered LDA & Immigration Consultant; document preparation at the client\'s direction. Immigration court (EOIR): paralegal support for attorneys only.';
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/immigration"
  slug="/immigration"
>
  <ImmigrationCategories />
  <ServiceSections
    include={['immigration-consultant-california', 'eoir-documents', 'document-translation-california']}
    kicker="USCIS · Immigration document preparation"
    heading="USCIS petitions, prepared at your direction"
    intro="Imverica Legal Solutions is a California-registered Immigration Consultant and Legal Document Assistant. We prepare USCIS petitions at the client’s direction — accurately, organized, and on time. Immigration court (EOIR) cases need a licensed attorney or a DOJ-accredited representative; we work on them only as a paralegal under an attorney’s direction. We are not a law firm and do not provide legal advice."
  />
  <HelpCta />
</BaseLayout>
