---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import SampleForm from '~/components/SampleForm.astro';
import CTAStrip from '~/components/CTAStrip.astro';

const lang = 'ru' as const;
const title = 'Подготовка документов I-765 — разрешение на работу (EAD) | Imverica';
const description = 'California Registered LDA готовит форму I-765 по указанию клиента. Категорию eligibility выбирает клиент или лицензированный адвокат. Подготовка документов без юридических консультаций.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'I-765 Employment Authorization Document Preparation',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  description: 'Подготовка документов по форме I-765 (Application for Employment Authorization) по поручению заявителя.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ru/i-765-work-permit-help"
  slug="/i-765-work-permit-help" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[schema]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Employment Authorization · 8 CFR §274a.12"
    heading="I-765 — Application for Employment Authorization"
    sub="Готовим форму I-765 с категорией eligibility и сведениями, которые вы предоставили. Категорию выбираете вы или лицензированный адвокат. Подготовка документов по вашему указанию — не юридическая консультация."
    ctaPrimary={{ href: '/#get-started?form=I-765', text: 'Начать пакет I-765' }}
  />

  <LandingBody related={[
    { href: '/ru/i-485-help', label: 'I-485 — Adjustment of status (concurrent I-765 c)(9))' },
    { href: '/ru/i-589-asylum-help', label: 'I-589 — Pending asylum и сроки подачи I-765 по категории (c)(8)' },
    { href: '/ru/lda', label: 'Кто такой California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      Форма I-765 — это заявление на Employment Authorization Document
      (EAD), физическую карту, которая нужна не-гражданину, чтобы
      подтвердить разрешение на работу в США. Мы готовим I-765 по указанию
      заявителя, используя категорию eligibility, которую выбрал заявитель
      или лицензированный адвокат. Imverica не определяет подходящую
      категорию и не даёт юридических консультаций.
    </p>

    <h2>Примеры кодов категорий eligibility</h2>
    <p>
      USCIS использует коды категорий, включая приведённые ниже. Это общая
      информация, а не определение права на подачу. Категории, доказательства,
      пошлины и правила подачи могут изменяться. Перед подачей проверьте
      актуальную страницу и инструкции Form I-765 на сайте USCIS. Если вы не
      уверены, какая категория подходит, обратитесь к лицензированному
      иммиграционному адвокату.
    </p>
    <ul>
      <li><strong>(c)(8)</strong> — Некоторые заявители с pending asylum application.</li>
      <li><strong>(c)(9)</strong> — Некоторые заявители с pending Form I-485.</li>
      <li><strong>(a)(12)</strong> / <strong>(c)(19)</strong> — Некоторые заявители или получатели Temporary Protected Status.</li>
      <li><strong>(c)(33)</strong> — Некоторые заявители DACA.</li>
      <li><strong>(c)(11)</strong> — Некоторые лица с parole.</li>
      <li><strong>(a)(18)</strong> — Некоторые супруги лиц со статусом L-1.</li>
      <li><strong>(c)(26)</strong> — Некоторые супруги со статусом H-4.</li>
      <li><strong>(c)(14)</strong> — Некоторые лица, получившие deferred action.</li>
    </ul>

    <h2>Что нам нужно от вас для I-765</h2>
    <ul>
      <li>Биографические данные (юридическое имя, прежние имена, DOB, страна рождения, страна гражданства)</li>
      <li>SSN, если ранее выдавался, или запрос карты SSA через саму I-765</li>
      <li>Текущие и предыдущие адреса в США</li>
      <li>Последний I-94 или admission record; биографическая страница паспорта; любая предыдущая EAD</li>
      <li>Доказательства категории eligibility (квитанция pending I-589 для (c)(8), pending I-485 для (c)(9), TPS registration для (a)(12) и т. д.)</li>
      <li>Две passport-style фотографии (мы предоставляем спецификацию)</li>
    </ul>

    <h2>Filing fee и fee waiver</h2>
    <p>
      Размер filing fee для I-765 и возможность запросить fee waiver зависят
      от категории подачи, основного benefit request и действующих правил
      USCIS. Форму I-912 нельзя использовать с любой формой или категорией.
      Перед подачей проверьте актуальные страницы и инструкции USCIS для I-765
      и I-912. Imverica готовит I-912 только по указанию клиента или
      лицензированного адвоката; мы не определяем право на fee waiver и не
      обещаем его одобрение USCIS.
    </p>

    <p><strong>Проверено:</strong> 18 октября 2026 года.</p>

    <h2>Официальные ресурсы USCIS</h2>
    <ul>
      <li><a href="https://www.uscis.gov/i-765" target="_blank" rel="noopener noreferrer">Страница Form I-765 и актуальные инструкции</a></li>
      <li><a href="https://www.uscis.gov/i-912" target="_blank" rel="noopener noreferrer">Страница Form I-912 о fee waiver и актуальные инструкции</a></li>
    </ul>

    <cite>
      <strong>Источник:</strong> Immigration and Nationality Act §274A
      (employment authorization); 8 C.F.R. §274a.12 (категории
      иностранцев, имеющих право работать); 8 C.F.R. §274a.13
      (заявление); USCIS Policy Manual Volume 10 (Employment
      Authorization).
    </cite>
  </LandingBody>

  <SampleForm form="i-765" lang="ru" />

  <CTAStrip lang="ru"
    heading="Начните заявку I-765 на разрешение на работу"
    sub="Многоязычная анкета. Можно сохранить и продолжить. Фиксированная цена. Подготовка документов по вашему поручению — без юридических консультаций."
    primaryHref="/#get-started?form=I-765"
    primaryText="Начать анкету I-765"
  />
</BaseLayout>
