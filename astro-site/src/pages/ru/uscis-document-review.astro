---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'ru' as const;
const title = 'Техническая проверка полноты пакета USCIS в Калифорнии | Imverica';
const description =
  'Техническая проверка самостоятельно подготовленного пакета USCIS для клиентов в Калифорнии: пустые поля, внутренняя согласованность, редакции, подписи и выбранный клиентом официальный чек-лист.';

const faqs: FaqItem[] = [
  {
    q: 'Что такое проверка документов USCIS?',
    a: 'Вы сами выбираете и готовите формы и официальный чек-лист. Мы отмечаем пустые поля, внутренние расхождения, устаревшие редакции и отсутствующие подписи и сравниваем материалы с выбранным вами чек-листом. Вы получаете письменные технические замечания.'
  },
  {
    q: 'Это то же самое, что юридическая консультация?',
    a: 'Нет. Проверка техническая, а не юридическая. Мы не оцениваем eligibility, не выбираем форму, доказательства, категорию сбора или адрес подачи, не толкуем ответы, не прогнозируем результат и не выбираем стратегию.'
  },
  {
    q: 'Какие готовые пакеты можно проверить?',
    a: 'Самостоятельно действующий клиент в Калифорнии может заказать техническую проверку уже заполненного и выбранного им пакета USCIS. Клиент заранее указывает формы, категорию подачи, официальный чек-лист и документы.'
  },
  {
    q: 'Сколько занимает техническая проверка?',
    a: 'Imverica письменно подтверждает ориентировочный срок после получения полного пакета и согласования объёма. Срок рассмотрения USCIS не зависит от Imverica и не обещается.'
  },
  {
    q: 'Сколько стоит проверка документов?',
    a: 'Фиксированная смета письменно подтверждается после получения готового пакета и согласования технического объёма. Работа начинается только после вашего одобрения.'
  },
  {
    q: 'Можно ли общаться и присылать документы по-русски?',
    a: 'Да. Анкета и переписка доступны на русском, украинском, английском и испанском. Сертифицированный перевод выбранных клиентом документов — отдельная услуга по запросу клиента.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Техническая проверка полноты пакета USCIS по поручению клиента',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  availableLanguage: ['ru', 'uk', 'en', 'es'],
  description: 'Техническая проверка самостоятельно подготовленного пакета USCIS для клиентов в Калифорнии: пустые поля, внутренняя согласованность, актуальные редакции, подписи и выбранный клиентом официальный чек-лист. Без юридических консультаций и выбора форм, доказательств, категории или адреса.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ru/uscis-document-review"
  slug="/uscis-document-review" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema(faqs)]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Проверка перед подачей · RU | UA | EN | ES"
    heading="Техническая проверка полноты пакета USCIS"
    sub="Для самостоятельно действующих клиентов в Калифорнии, которые уже выбрали и заполнили формы. Мы отмечаем пустые поля, внутренние расхождения, устаревшие редакции и отсутствующие подписи и сверяем материалы с выбранным вами официальным чек-листом."
    ctaPrimary={{ href: '/#get-started?topic=REVIEW', text: 'Заказать техническую проверку' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/ru/u4u', label: 'U4U re-parole — подготовка документов' },
    { href: '/ru/tps', label: 'TPS — временный защищённый статус' },
    { href: '/pricing', label: 'Опубликованные тарифы' },
    { href: '/ru/lda', label: 'Кто такой Legal Document Assistant в Калифорнии' }
  ]}>
    <p class="lead">
      Это техническая проверка самостоятельно подготовленного пакета по
      поручению клиента. Вы выбираете форму, категорию, официальный чек-лист и
      документы. Imverica отмечает видимые технические вопросы; мы не решаем,
      что подавать и достаточно ли пакет обоснован юридически.
    </p>

    <h2>Кому это подходит</h2>
    <ul>
      <li>Вы самостоятельно действующий клиент в Калифорнии и уже выбрали и заполнили пакет USCIS.</li>
      <li>Вы заполняли формы по шаблону или через переводчик и не уверены, что каждый ответ попал туда, куда ожидает USCIS.</li>
      <li>Предыдущую подачу вернули из-за пропущенной подписи, не той редакции или неполного ответа — повторения не хочется.</li>
      <li>Нужна профессиональная проверка, но полная подготовка «с нуля» не требуется.</li>
    </ul>

    <h2>Что мы проверяем</h2>
    <ul>
      <li><strong>Пустые поля</strong> — видимые пустые поля перечисляются, чтобы вы сверились с выбранной официальной инструкцией.</li>
      <li><strong>Внутренняя согласованность</strong> — имена, даты, адреса и A-numbers сравниваются между предоставленными формами и подписями.</li>
      <li><strong>Редакция формы</strong> — дата редакции каждой формы та, которую USCIS принимает сейчас.</li>
      <li><strong>Подписи и даты</strong> — видимые неподписанные или недатированные поля отмечаются для вашей проверки.</li>
      <li><strong>Выбранный клиентом чек-лист</strong> — предоставленные документы сравниваются с указанным вами официальным чек-листом USCIS; Imverica не выбирает доказательства и не определяет их достаточность.</li>
      <li><strong>Официальные ссылки</strong> — мы можем дать ссылки на актуальные страницы сборов и адресов USCIS, но категорию, порядок оплаты и адрес выбираете вы.</li>
    </ul>

    <h2>Какие документы обычно проверяем</h2>
    <p>
      Запросы U4U re-parole, заявления I-765 на разрешение на работу,
      travel-документы I-131, регистрации и перерегистрации TPS (I-821),
      комплекты I-485 на грин-карту, семейные петиции I-130, заявления N-400
      на гражданство и продление грин-карты I-90 — когда клиент в Калифорнии
      уже выбрал формы, категорию, официальный чек-лист и документы.
    </p>

    <h2>Как проходит проверка</h2>
    <ul>
      <li><strong>1. Загрузка.</strong> Пришлите заполненные формы и приложения через защищённый личный кабинет — файлы шифруются при хранении.</li>
      <li><strong>2. Фиксированная смета.</strong> Мы подтверждаем объём пакета и называем фиксированную цену до начала работы.</li>
      <li><strong>3. Техническая проверка.</strong> Специалист сравнивает пакет с актуальной редакцией формы и выбранным вами официальным чек-листом.</li>
      <li><strong>4. Письменные замечания.</strong> Вы получаете список технических флагов и официальных ссылок — на русском. Решение об изменениях принимаете вы.</li>
    </ul>

    <cite>
      Imverica Legal Solutions — зарегистрированный в Калифорнии Legal Document
      Assistant и Immigration Consultant, не адвокатская фирма. Проверка
      документов — это технический контроль, а не юридическая консультация,
      выбор формы, категории или доказательств, оценка eligibility или прогноз
      результата. Если вы не уверены, что подавать, обратитесь к лицензированному
      иммиграционному адвокату или DOJ-accredited representative.
    </cite>
  </LandingBody>

  <FaqBlock heading="Частые вопросы" items={faqs} />

  <CTAStrip lang={lang} primaryHref="/#get-started?topic=REVIEW" primaryText="Заказать техническую проверку" />
</BaseLayout>
