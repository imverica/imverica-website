---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'ru' as const;
const title = 'Проверка документов USCIS перед подачей | Imverica';
const description =
  'Заполнили формы USCIS самостоятельно? Проверим пакет перед подачей: полнота ответов, согласованность форм, актуальные редакции, подписи, чек-лист приложений. Дистанционно по всей территории США, по-русски.';

const faqs: FaqItem[] = [
  {
    q: 'Что такое проверка документов USCIS?',
    a: 'Вы готовите заявление сами, а мы просматриваем готовый пакет до подачи: пропущенные ответы, расхождения между формами, устаревшие редакции, отсутствующие подписи и пробелы в приложениях. Вы получаете письменный список замечаний для исправления.'
  },
  {
    q: 'Это то же самое, что юридическая консультация?',
    a: 'Нет. Проверка техническая, а не юридическая: полнота, согласованность и оформление по требованиям USCIS. Мы не оцениваем ваше право на статус, не прогнозируем результат и не выбираем стратегию — по таким вопросам направляем к лицензированным иммиграционным адвокатам.'
  },
  {
    q: 'Какие заявления вы проверяете?',
    a: 'Любые пакеты USCIS, которые мы также готовим: запросы U4U re-parole, разрешения на работу I-765, travel-документы I-131, TPS (I-821), грин-карту I-485, семейные петиции I-130, гражданство N-400, продление грин-карты I-90 и комплекты доказательств.'
  },
  {
    q: 'Сколько занимает проверка?',
    a: 'Проверка одной формы обычно возвращается за 1–2 рабочих дня. Пакеты из нескольких форм (например, I-485 + I-765 + I-131) — за 2–3 рабочих дня.'
  },
  {
    q: 'Сколько стоит проверка документов?',
    a: 'Фиксированная смета называется после того, как мы видим объём пакета: одна форма с приложениями стоит меньше полного комплекта на грин-карту. Опубликованные тарифы на подготовку — на imverica.com/pricing; проверка стоит меньше соответствующей подготовки.'
  },
  {
    q: 'Можно ли общаться и присылать документы по-русски?',
    a: 'Да. Анкета и переписка доступны на русском, украинском, английском и испанском, а при необходимости мы делаем сертифицированные переводы свидетельств и справок для пакета.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'USCIS Document Review (Russian-speaking)',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'Country', name: 'United States' },
  availableLanguage: ['ru', 'uk', 'en', 'es'],
  description: 'Проверка самостоятельно подготовленных пакетов USCIS перед подачей: полнота, согласованность, актуальные редакции форм, подписи, чек-лист приложений. Только проверка документов — не юридическая консультация.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ru/uscis-document-review"
  slug="/uscis-document-review" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema(faqs)]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Проверка перед подачей · RU | UA | EN | ES"
    heading="Проверка документов USCIS перед подачей"
    sub="Вы заполнили формы сами — мы проверим пакет до отправки в USCIS. Полнота, согласованность, актуальные редакции, подписи и чек-лист приложений. Дистанционно, фиксированная смета, замечания письменно и по-русски."
    ctaPrimary={{ href: '/#get-started?topic=REVIEW', text: 'Заказать проверку документов' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/ru/u4u', label: 'U4U re-parole — подготовка документов' },
    { href: '/ru/tps', label: 'TPS — временный защищённый статус' },
    { href: '/pricing', label: 'Опубликованные тарифы' },
    { href: '/ru/lda', label: 'Кто такой Legal Document Assistant в Калифорнии' }
  ]}>
    <p class="lead">
      Отказы и задержки USCIS чаще всего случаются из-за механики: пропущенный
      вопрос, устаревшая редакция формы, подпись не в том месте или приложения,
      которые не совпадают с ответами в форме. Проверка документов — это вторая
      пара профессиональных глаз на вашем пакете, пока на кону ещё не стоят
      пошлина и месяцы ожидания.
    </p>

    <h2>Кому это подходит</h2>
    <ul>
      <li>Вы сами подготовили пакет U4U re-parole, TPS, разрешения на работу, грин-карты или на гражданство и хотите проверить его перед подачей.</li>
      <li>Вы заполняли формы по шаблону или через переводчик и не уверены, что каждый ответ попал туда, куда ожидает USCIS.</li>
      <li>Предыдущую подачу вернули из-за пропущенной подписи, не той редакции или неполного ответа — повторения не хочется.</li>
      <li>Нужна профессиональная проверка, но полная подготовка «с нуля» не требуется.</li>
    </ul>

    <h2>Что мы проверяем</h2>
    <ul>
      <li><strong>Полнота</strong> — отвечен каждый обязательный пункт; там, где USCIS требует «None»/«N/A», не оставлены пустые поля.</li>
      <li><strong>Согласованность</strong> — имена, даты, адреса и A-numbers совпадают во всех формах пакета и в приложениях.</li>
      <li><strong>Редакция формы</strong> — дата редакции каждой формы та, которую USCIS принимает сейчас.</li>
      <li><strong>Подписи и даты</strong> — подписано всё, что должно быть подписано, и не подписано то, что должно остаться пустым.</li>
      <li><strong>Приложения</strong> — чек-лист: что в пакете есть и что обычно требуется для вашего типа подачи, включая сертифицированные переводы.</li>
      <li><strong>Пошлины и адрес</strong> — правильная пошлина (или освобождение, как I-765 (c)(11) для U4U) и актуальный адрес подачи USCIS.</li>
    </ul>

    <h2>Какие документы обычно проверяем</h2>
    <p>
      Запросы U4U re-parole, заявления I-765 на разрешение на работу,
      travel-документы I-131, регистрации и перерегистрации TPS (I-821),
      комплекты I-485 на грин-карту, семейные петиции I-130, заявления N-400
      на гражданство, продление грин-карты I-90 — и доказательную базу к ним:
      свидетельства, переводы, статусные документы, фотографии.
    </p>

    <h2>Как проходит проверка</h2>
    <ul>
      <li><strong>1. Загрузка.</strong> Пришлите заполненные формы и приложения через защищённый личный кабинет — файлы шифруются при хранении.</li>
      <li><strong>2. Фиксированная смета.</strong> Мы подтверждаем объём пакета и называем фиксированную цену до начала работы.</li>
      <li><strong>3. Проверка.</strong> Специалист по подготовке документов проходит каждую страницу по актуальным требованиям USCIS.</li>
      <li><strong>4. Письменные замечания.</strong> Вы получаете список: что исправить, чего не хватает и что готово — на русском.</li>
    </ul>

    <cite>
      Imverica Legal Solutions — зарегистрированный в Калифорнии Legal Document
      Assistant и Immigration Consultant, не адвокатская фирма. Проверка
      документов — это контроль полноты и согласованности, а не юридическая
      консультация, оценка права на статус или прогноз результата. Если делу
      нужна юридическая стратегия — обратитесь к лицензированному
      иммиграционному адвокату.
    </cite>
  </LandingBody>

  <FaqBlock heading="Частые вопросы" items={faqs} />

  <CTAStrip lang={lang} primaryHref="/#get-started?topic=REVIEW" primaryText="Заказать проверку документов" />
</BaseLayout>
