---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SampleForm from '~/components/SampleForm.astro';
import WhyNotChatGPT from '~/components/WhyNotChatGPT.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CTAStrip from '~/components/CTAStrip.astro';

const lang = 'ru' as const;
const title = 'I-485 подготовка документов — изменение статуса (Adjustment of Status) | Imverica';
const description = 'Калифорнийский зарегистрированный LDA готовит документы Form I-485 по указанию клиента. Основание подачи и eligibility определяет клиент или лицензированный адвокат. Без юридических консультаций.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'I-485 Adjustment of Status Document Preparation',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  description: 'Imverica готовит форму I-485 и организует материалы клиента по его указанию. Сопутствующие формы включаются только по конкретному указанию и когда это допускают актуальные инструкции USCIS.'
};
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/ru/i-485-help"
  jsonLd={[serviceSchema]}
  lang={lang}
  slug="/i-485-help"
  availableLocales={['en', 'ru', 'uk', 'es']}
>
  <Hero
    lang={lang}
    eyebrow="USCIS · Изменение статуса · INA §245(a)"
    heading="I-485 — Заявление на регистрацию постоянного места жительства или изменение статуса"
    sub="Готовим форму I-485 и организуем предоставленные вами материалы по вашему указанию. В зависимости от актуальных инструкций USCIS и ваших конкретных указаний пакет может также включать запечатанную форму I-693 от врача, уполномоченного USCIS, а также формы I-765 или I-131. Фиксированная цена. Русский, украинский, английский, испанский."
    ctaPrimary={{ href: '/#get-started?form=I-485', text: 'Начать пакет I-485' }}
  />

  <LandingBody related={[
    { href: '/ru/i-765-work-permit-help', label: 'I-765 — разрешение на работу' },
    { href: '/ru/i-589-asylum-help', label: 'I-589 — убежище' },
    { href: '/ru/n-400-citizenship-help', label: 'N-400 — гражданство' }
  ]}>
    <p class="lead">
      Форма I-485 — это заявление, которое подаёт человек, физически находящийся в США,
      для получения статуса законного постоянного жителя (грин-карты). Imverica готовит
      форму I-485 и организует предоставленные вами подтверждающие материалы по
      вашему указанию. Сопутствующие формы включаются только тогда, когда вы или
      лицензированный адвокат прямо указываете их включить и действующие инструкции
      USCIS разрешают их подачу.
    </p>

    <h2>Общая информация о том, кто может подавать I-485</h2>
    <p>
      Form I-485 используется некоторыми лицами, физически находящимися в США,
      для запроса статуса lawful permanent resident. Возможность подать форму
      зависит от обстоятельств конкретного дела: основания подачи, способа
      въезда, доступности визы, admissibility, установленных законом запретов и
      исключений, а также действующего законодательства и инструкций USCIS.
    </p>
    <p>
      USCIS перечисляет возможные основания, включая family-based,
      employment-based, special immigrant, asylee или refugee и другие
      гуманитарные категории. Imverica не определяет ваше право на подачу, не
      выбирает основание и не рекомендует юридическую стратегию. Перед подачей
      изучите актуальную страницу и инструкции Form I-485 на сайте USCIS. Если
      вы не уверены, можете ли подавать форму, обратитесь к лицензированному
      иммиграционному адвокату.
    </p>

    <h2>Документы, которые могут входить в пакет I-485</h2>
    <div class="form-list">
      <strong>Что мы организуем или готовим по вашему указанию</strong>
      <ul>
        <li><strong>I-485</strong> — Application to Register Permanent Residence or Adjust Status (основная форма)</li>
        <li><strong>I-693</strong> — Report of Immigration Medical Examination and Vaccination Record, когда эта форма требуется. Её заполняет и запечатывает врач, уполномоченный USCIS (civil surgeon). Клиент предоставляет запечатанную форму; Imverica только организует её вместе с материалами клиента по его конкретному указанию и не вскрывает, не изменяет и не заполняет I-693.</li>
        <li><strong>I-765</strong> — Application for Employment Authorization, когда клиент или лицензированный адвокат указывает включить форму и действующие правила USCIS разрешают подачу</li>
        <li><strong>I-131</strong> — Application for Travel Documents, Parole Documents, and Arrival/Departure Records, когда клиент или лицензированный адвокат указывает включить форму и действующие правила USCIS разрешают подачу</li>
        <li><strong>I-864</strong> / <strong>I-864A</strong> / <strong>I-864EZ</strong> — Affidavit of Support, когда форма требуется для основания подачи, выбранного клиентом или лицензированным адвокатом</li>
        <li><strong>I-912</strong> — Request for Fee Waiver, только если запрашиваемая льгота и категория подачи допускают I-912 по актуальным инструкциям USCIS и клиент или лицензированный адвокат указывает включить её</li>
        <li><strong>Подтверждающие документы</strong> — свидетельство о рождении, свидетельство о браке, биографическая страница паспорта, прошлые визовые штампы, I-94, I-797 receipt и approval notices, прошлые иммиграционные документы, фотографии, и переводы любых документов на иностранных языках согласно 8 CFR §103.2(b)(3)</li>
      </ul>
    </div>

    <h2>Как работает наша анкета по I-485</h2>
    <p>
      Вы заполняете пошаговую анкету в своём темпе. Она собирает сведения,
      которые запрашивает действующая редакция Form I-485: биографические
      данные, историю адресов, работы, семьи и иммиграции, а также ответы на
      вопросы eligibility. Клиент сам указывает основание подачи и отвечает на
      юридические вопросы или вопросы eligibility; Imverica переносит сведения,
      предоставленные клиентом, и не принимает эти решения.
    </p>
    <p>
      Все ваши данные сохраняются по мере заполнения. Можно ставить на паузу,
      переключать языки или вернуться позже. Когда закончите, мы собираем пакет,
      генерируем готовые для подачи PDF, и проводим вас по тому, что собрать
      (USCIS fee или fee-waiver, цветные фотографии по текущей спецификации,
      гражданские документы и переводы, а также, когда требуется, запечатанную
      I-693 от врача, уполномоченного USCIS) перед тем как
      подписать и отправить пакет по актуальным инструкциям USCIS для основания
      подачи, выбранного вами или вашим лицензированным адвокатом.
    </p>

    <h2>Что мы НЕ делаем</h2>
    <p>
      Как калифорнийский зарегистрированный помощник по юридическим документам и
      иммиграционный консультант, мы не можем давать юридических советов,
      рекомендовать стратегию подачи, или представлять вас в USCIS или
      иммиграционном суде. Если выбор основания, категории, ответа или формы
      требует юридического анализа, мы приостанавливаем подготовку до получения
      ваших конкретных указаний или указаний лицензированного адвоката. Мы не
      готовим документы, которые не можем законно подготовить согласно
      California Business &amp; Professions Code §6411.
    </p>

    <p>
      Возможность использовать Form I-912 зависит от запрашиваемой льготы,
      категории подачи и актуальных инструкций USCIS. I-912 подходит не для
      каждой формы или категории. Imverica включает I-912 только по указанию
      клиента или лицензированного адвоката и не обещает одобрение USCIS.
    </p>

    <p><strong>Проверено:</strong> 18 октября 2026 года.</p>

    <h2>Официальные ресурсы USCIS</h2>
    <ul>
      <li><a href="https://www.uscis.gov/i-485" target="_blank" rel="noopener noreferrer">Страница Form I-485 и актуальные инструкции</a></li>
      <li><a href="https://www.uscis.gov/i-765" target="_blank" rel="noopener noreferrer">Страница Form I-765 и актуальные инструкции</a></li>
      <li><a href="https://www.uscis.gov/i-912" target="_blank" rel="noopener noreferrer">Страница Form I-912 о fee waiver и актуальные инструкции</a></li>
    </ul>

    <cite>
      <strong>Законодательная база:</strong> Immigration and Nationality Act
      §245(a), 8 U.S.C. §1255(a) (изменение статуса); 8 C.F.R. §§245.1, 245.2
      (процедура); 8 C.F.R. §103.2 (требования к подаче); 8 C.F.R. §103.2(b)(3)
      (сертификация переводов с иностранного языка); USCIS Policy Manual Volume
      7 (Adjustment of Status). Сфера действия в Калифорнии: Cal. Bus. &amp;
      Prof. Code §§6400-6415 (Legal Document Assistant Act); §§22440-22448
      (Immigration Consultant Act).
    </cite>
  </LandingBody>

  <SampleForm form="i-485" lang="ru" />
  <WhyNotChatGPT lang="ru" />

  <CTAStrip
    lang={lang}
    heading="Начните пакет I-485 сегодня"
    sub="Многоязычная анкета. Фиксированная цена. Подготовка документов по вашему поручению — не юридические консультации. Начните на своём языке и продолжайте с того места, где остановились."
    primaryHref="/#get-started?form=I-485"
    primaryText="Заполнить анкету I-485"
  />
</BaseLayout>
