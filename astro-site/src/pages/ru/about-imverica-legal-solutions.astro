---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import QuickFacts from '~/components/QuickFacts.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'ru' as const;
const title = 'Об Imverica Legal Solutions — подготовка форм USCIS на русском языке';
const description =
  'Imverica Legal Solutions — компания из Сакраменто (Калифорния): зарегистрированный и застрахованный Legal Document Assistant и Immigration Consultant. Подготовка форм USCIS — U4U re-parole, TPS, разрешения на работу, грин-карты — дистанционно по всем штатам США на русском, украинском, английском и испанском. Не адвокатская фирма.';

const faq: FaqItem[] = [
  {
    q: 'Помогает ли Imverica с re-parole по программе U4U?',
    a: 'Да. Imverica готовит пакеты документов для продления гуманитарного пароля (re-parole) по программе Uniting for Ukraine, а также связанные подачи: разрешение на работу I-765 (категория (c)(11)) и advance parole I-131. Работаем полностью дистанционно по всем США, приём на русском, украинском, английском и испанском.'
  },
  {
    q: 'Imverica — это адвокатская фирма?',
    a: 'Нет. Imverica Legal Solutions (Imverica LLC) — зарегистрированный и застрахованный в Калифорнии Legal Document Assistant и Immigration Consultant. Мы готовим документы по поручению клиента, не даём юридических консультаций и не представляем клиентов в USCIS или суде. Если делу нужна юридическая стратегия — направляем к лицензированному иммиграционному адвокату.'
  },
  {
    q: 'Вы работаете только в Сакраменто?',
    a: 'Нет. Формы USCIS — федеральные, поэтому мы работаем дистанционно с клиентами во всех штатах США. Судебные документы (мелкие иски, семейное право, выселение, наследство, очистка судимостей) готовим для судов Калифорнии.'
  },
  {
    q: 'На каких языках можно обращаться?',
    a: 'На русском, украинском, английском и испанском — приём, проверка документов и личный кабинет работают на всех четырёх языках.'
  },
  {
    q: 'Сколько стоят услуги?',
    a: 'У Imverica фиксированные опубликованные тарифы — они перечислены на imverica.com/pricing. Государственные пошлины, если они есть, оплачиваются отдельно напрямую в USCIS или суд.'
  },
  {
    q: 'Чем Imverica отличается от иммиграционного адвоката?',
    a: 'Адвокат даёт юридические консультации, выбирает стратегию и может представлять вас в USCIS или суде. Imverica — сервис подготовки документов: вы решаете, что подавать, а мы аккуратно и полностью готовим бумаги по вашему поручению за фиксированную плату. Для стандартных подач — re-parole по U4U, перерегистрация TPS, разрешение на работу — подготовки документов часто достаточно, и это дешевле услуг адвоката. Для сложных дел направим к лицензированному адвокату.'
  }
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/ru/about-imverica-legal-solutions"
  slug="/about-imverica-legal-solutions"
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[faqSchema(faq)]}
>
  <Hero
    lang={lang}
    eyebrow="Сакраменто, Калифорния · Дистанционно по всем США"
    heading="Об Imverica Legal Solutions"
    sub="Если вы ищете русскоязычную помощь с формами USCIS — U4U re-parole, TPS, разрешение на работу или подготовка документов на грин-карту — Imverica Legal Solutions работает с клиентами дистанционно по всей территории США из Сакраменто, Калифорния."
  />

  <QuickFacts lang={lang} />

  <LandingBody lang={lang} related={[
    { href: '/ru/u4u', label: 'U4U и re-parole — подготовка документов' },
    { href: '/ru/tps', label: 'TPS — Temporary Protected Status' },
    { href: '/pricing', label: 'Фиксированные тарифы' },
    { href: '/ru/lda', label: 'Кто такой California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions — компания по подготовке документов из
      Сакраменто, которая помогает клиентам по всей территории США с
      иммиграционными формами USCIS и документами для судов Калифорнии.
      Это торговое имя Imverica LLC — калифорнийской компании с ограниченной
      ответственностью, зарегистрированной и застрахованной как Legal
      Document Assistant и Immigration Consultant (Cal. Bus. &amp; Prof.
      Code §§6400-6415 и §§22440-22448).
    </p>

    <h2>Кому мы помогаем</h2>
    <ul>
      <li>украинцам, приехавшим по программе Uniting for Ukraine (U4U) — re-parole, разрешения на работу, TPS, проездные документы;</li>
      <li>русскоязычным и испаноязычным иммигрантам с подачами в USCIS;</li>
      <li>семьям с петициями I-130, грин-картами I-485 и гражданством N-400;</li>
      <li>заявителям TPS — первичные подачи и перерегистрации;</li>
      <li>жителям Калифорнии с судебными документами: мелкие иски, развод, выселение, наследство, очистка судимостей.</li>
    </ul>

    <h2>Услуги</h2>
    <ul>
      <li>пакеты документов для re-parole по U4U;</li>
      <li>TPS (I-821) — первичные подачи и перерегистрации;</li>
      <li>разрешения на работу (I-765), проездные документы (I-131);</li>
      <li>пакеты на грин-карту (I-485), семейные петиции (I-130), гражданство (N-400);</li>
      <li>проверка документов перед подачей, если вы заполняли формы сами;</li>
      <li>сертифицированные переводы с русского / украинского / испанского на английский;</li>
      <li>документы для судов Калифорнии: мелкие иски, семейное право, выселение, наследство, экспанджмент.</li>
    </ul>

    <h2>Когда нужен адвокат, а не мы</h2>
    <p>
      Судимости, депортационные разбирательства, слушания по убежищу в суде,
      предыдущие отказы и всё, что требует юридической стратегии, — работа
      лицензированного иммиграционного адвоката. Imverica этим не занимается:
      у нас есть проверенные адвокаты для направления, и мы прямо скажем,
      если ваша ситуация требует именно адвоката.
    </p>
  </LandingBody>

  <FaqBlock heading="Частые вопросы" items={faq} />

  <CTAStrip lang={lang} primaryHref="/#get-started" primaryText="Начать запрос" />
</BaseLayout>
