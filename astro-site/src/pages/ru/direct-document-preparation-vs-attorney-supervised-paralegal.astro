---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'ru' as const;
const title = 'Прямая подготовка документов и поддержка под руководством адвоката | Imverica';
const description =
  'Два отдельных формата работы Imverica: подготовка документов по поручению самостоятельно действующих клиентов в Калифорнии и паралигальная поддержка под руководством и проверкой лицензированного адвоката.';

const faq: FaqItem[] = [
  {
    q: 'Представляет ли Imverica прямых клиентов?',
    a: 'Нет. Прямой клиент остаётся самостоятельно действующей стороной. Imverica не выступает за него в USCIS или суде и не создаёт отношений «адвокат — клиент».'
  },
  {
    q: 'Может ли Imverica сказать прямому клиенту, какую форму или правовой вариант выбрать?',
    a: 'Нет. Прямой клиент сам решает, что подавать, и даёт конкретные инструкции. Вопросы о праве на льготу, правовых вариантах, правах и стратегии относятся к работе лицензированного адвоката.'
  },
  {
    q: 'Кто руководит работой при поддержке адвоката?',
    a: 'Лицензированный адвокат определяет задание, направляет и проверяет работу, сообщает клиенту юридические рекомендации и остаётся ответственным за дело и представительство.'
  },
  {
    q: 'Становится ли Imverica адвокатской фирмой при работе с адвокатом?',
    a: 'Нет. Imverica остаётся неадвокатским поставщиком услуг. Поддержка адвоката — это отдельный договор между компаниями, выполняемый под контролем ответственного адвоката.'
  }
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/ru/direct-document-preparation-vs-attorney-supervised-paralegal"
  slug="/direct-document-preparation-vs-attorney-supervised-paralegal"
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[faqSchema(faq)]}
>
  <Hero
    lang={lang}
    eyebrow="Два отдельных формата работы"
    heading="Прямая подготовка документов и поддержка адвоката — разные услуги"
    sub="В зависимости от договора меняется тот, кто принимает юридические решения, руководит работой и отвечает за дело. Imverica не смешивает эти отношения."
  />

  <LandingBody lang={lang} related={[
    { href: '/ru/about-imverica-legal-solutions', label: 'Проверяемые факты об Imverica' },
    { href: '/ru/lda', label: 'Кто такой California Legal Document Assistant?' },
    { href: '/pricing', label: 'Опубликованные тарифы прямых услуг' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions не является адвокатской фирмой. Компания может
      работать одним из двух чётко разделённых способов: напрямую для
      самостоятельно действующего клиента в Калифорнии, который даёт
      конкретные инструкции, либо выполнять неадвокатское задание под
      руководством и проверкой лицензированного адвоката.
    </p>

    <h2>1. Прямая подготовка документов для самостоятельно действующего клиента</h2>
    <ul>
      <li>Услуга оказывается дистанционно самостоятельно действующим клиентам в Калифорнии.</li>
      <li>Клиент сам решает, какую форму или документ готовить, и даёт конкретные инструкции.</li>
      <li>В рамках письменного задания Imverica может вводить данные, собирать выбранные клиентом материалы, систематизировать документы и предоставлять сертифицированные переводы.</li>
      <li>Imverica не определяет право на льготу, не выбирает средство защиты или форму, не советует стратегию, не прогнозирует результат и не представляет клиента.</li>
      <li>Письменный договор на прямую услугу определяет работу и цену.</li>
    </ul>

    <h2>2. Паралигальная поддержка под руководством лицензированного адвоката</h2>
    <ul>
      <li>Это отдельный договор между Imverica и лицензированным адвокатом или адвокатской фирмой.</li>
      <li>Адвокат определяет задание и даёт юридические указания.</li>
      <li>Адвокат проверяет работу, сообщает клиенту юридические рекомендации и отвечает за отношения с клиентом, правовую оценку, подачи и представительство.</li>
      <li>Imverica выполняет только порученные неадвокатские вспомогательные задачи в пределах письменного задания.</li>
      <li>Доступность зависит от договора и правил, применимых к ответственному адвокату.</li>
    </ul>

    <h2>Эти отношения не пересекаются</h2>
    <p>
      Отдельное сотрудничество адвоката с Imverica не означает, что адвокат
      представляет прямого клиента Imverica. Если прямому клиенту нужно решить,
      что подавать или как закон применяется к его ситуации, ему следует
      заключить отдельный договор с лицензированным адвокатом.
    </p>

    <h2>Почему это важно</h2>
    <p>
      При прямой подготовке документов работой управляет самостоятельно
      действующий клиент. При работе с адвокатом заданием управляет
      лицензированный адвокат. Чёткое описание этой разницы защищает клиента,
      адвоката и точность публичной информации об Imverica.
    </p>
  </LandingBody>

  <FaqBlock heading="Частые вопросы" items={faq} />
  <CTAStrip lang={lang} primaryHref="/ru/#get-started" primaryText="Запросить подготовку документов" />
</BaseLayout>
