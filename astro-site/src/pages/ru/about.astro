---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CategoryTiles from '~/components/CategoryTiles.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import QuickFacts from '~/components/QuickFacts.astro';
import FounderBlock from '~/components/FounderBlock.astro';

const lang = 'ru' as const;
const title = 'О компании Imverica — California LDA и Immigration Consultant | Imverica Legal Solutions';
const description = 'Imverica Legal Solutions — мультиязычный (английский, русский, украинский, испанский) Legal Document Assistant и Immigration Consultant из Сакраменто. Готовим документы USCIS и судов Калифорнии по всему США и штату — по доступным, прозрачным тарифам. Мы не юридическая фирма и не даём юридических консультаций.';

---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ru/about"
  slug="/about" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} >
  <Hero
    lang={lang}
    eyebrow="О Imverica Legal Solutions"
    heading="Доступная подготовка документов на четырёх языках — под вашу ситуацию"
    sub="База в Сакраменто. Калифорнийские суды по всему штату, USCIS — по всем США. Говорим на английском, русском, украинском и испанском. Готовим документы по вашему поручению — мы не юридическая фирма и не даём юридических консультаций."
    ctaPrimary={{ href: '/#get-started', text: 'Начать кейс' }}
    ctaSecondary={{ href: 'tel:+19163993992', text: '📞 +1 (916) 399-3992' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/ru/lda', label: 'Кто такой California Legal Document Assistant?' },
    { href: '/ru/for-attorneys', label: 'Для адвокатов — paralegal-партнёрство' },
    { href: '/ru/immigration', label: 'Формы USCIS, которые мы готовим' },
    { href: '/ru/fl', label: 'Семейное право Калифорнии' },
    { href: '/ru/sacramento', label: 'Документы в Сакраменто — на русском' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions появилась в <strong>Сакраменто, Калифорния</strong>,
      одном из самых многонациональных и многоязычных городов США. Здесь на
      каждой улице чей-то первый адрес в Америке, чей-то маленький бизнес,
      чьё-то семейное дело, чей-то пакет I-485, который лежит нераскрытым,
      потому что инструкция написана на чужом языке. Мы создали Imverica как
      офис, куда такие соседи действительно могут прийти: доступный,
      многоязычный и честный.
    </p>

    <FounderBlock lang="ru" />

    <h2 id="story">Кто мы</h2>
    <p>
      <strong>Imverica Legal Solutions</strong> — торговое наименование (dba)
      компании <strong>Imverica LLC</strong>, общества с ограниченной
      ответственностью штата Калифорния, зарегистрированного как помощник по
      юридическим документам (<strong>Legal Document Assistant</strong>,
      Cal. Bus. &amp; Prof. Code §§6400–6415) и иммиграционный консультант
      (<strong>Immigration Consultant</strong>, §§22440–22448). Мы работаем
      в двух форматах: напрямую с людьми, которые представляют себя сами, —
      здесь <strong>работой руководите вы</strong>, а мы готовим выбранные вами
      документы; и как <strong>независимая paralegal-поддержка юридических
      фирм</strong> — здесь работой руководит адвокат, и он остаётся адвокатом
      по делу.
    </p>
    <p>Три обещания, которые мы не нарушим, даже если потеряем клиента:</p>
    <ul>
      <li><strong>Честно о границах.</strong> Если вашему делу нужен адвокат, мы скажем это при первом звонке и подскажем, где его найти. Первый звонок бесплатный.</li>
      <li><strong>Честно о цене.</strong> Фиксированная цена, известная заранее. Без почасовой оплаты и неожиданных доплат.</li>
      <li><strong>Честно о результате.</strong> Мы готовим документы по вашему поручению. Мы не говорим, подходите ли вы, не предсказываем решение USCIS или судьи и никогда не гарантируем результат.</li>
    </ul>

    <h2 id="why-us">Почему с нами работают</h2>
    <ul>
      <li><strong>Четыре языка.</strong> Анкета, документы и переписка на <strong>английском, русском, украинском и испанском</strong> — с людьми, для которых это родной язык. Помощник на сайте подскажет нужную страницу, а каждый документ готовит и проверяет человек.</li>
      <li><strong>Сначала цена.</strong> Фиксированный тариф за документ или дело. Вы видите цену до того, как решите.</li>
      <li><strong>Скорость.</strong> Расчёт стоимости обычно в тот же рабочий день, большинство документов готово в течение 48 часов после заполнения анкеты.</li>
      <li><strong>Удалённо.</strong> Телефон, email, Telegram и защищённый личный кабинет: ехать в Сакраменто не нужно. Электронная подпись там, где она разрешена, оригиналы почтой там, где они нужны.</li>
      <li><strong>И для адвокатов.</strong> Юридические фирмы работают с нами как с независимым paralegal. <a href="/ru/for-attorneys">Варианты сотрудничества для адвокатов</a>.</li>
    </ul>

    <h2 id="scope">Что мы делаем и чего не делаем</h2>
    <p><strong>Что мы готовим:</strong></p>
    <ul>
      <li>Формы USCIS (I-485, I-130, I-765, I-589, N-400, I-90, I-131, I-864, ответы на RFE, пакеты доказательств).</li>
      <li><strong>Иммиграционный суд (EOIR): только для адвокатов.</strong> По делам EOIR мы работаем только как помощник юриста (paralegal) под руководством адвоката и не готовим документы в иммиграционный суд для частных лиц (<a href="/ru/eoir-immigration-court">почему</a>).</li>
      <li>Семейное право Калифорнии (FL-100/110/120, FL-150/160, FL-300, опека, алименты, пакеты судебного решения).</li>
      <li>Малые иски и гражданские дела в Калифорнии (SC-100 — SC-140, досудебные претензии, удержание из зарплаты, abstract of judgment).</li>
      <li>Документы по выселению в Калифорнии для арендодателей и арендаторов (UD-100/105/110, трёхдневные уведомления, пакеты default).</li>
      <li>Наследственные дела в Калифорнии (DE-111/121/160/221/295, small estate affidavits, опись, распределение, закрытие дела).</li>
      <li>Снятие судимости в Калифорнии: пакеты petition for dismissal (CR-180/181), в том числе по DUI, по вашему поручению.</li>
      <li>Документы для бизнеса в Калифорнии (LLC-1, LLC-12, ARTS-GS, FBN, EIN).</li>
      <li>Заверенный перевод документов (русский, украинский, испанский ↔ английский) и помощь с апостилем.</li>
    </ul>
    <p>
      <strong>Чего мы не делаем — так задумано и так требует закон:</strong>
      мы не даём юридических консультаций, не представляем вас в суде,
      в USCIS или EOIR, не подписываем процессуальные документы, не ведём
      переговоров с другой стороной и не выбираем за вас форму. Если вашей
      ситуации нужен адвокат (судебный спор, стратегия, выступления в суде),
      мы скажем это при первом звонке и подскажем, где найти лицензированного
      адвоката.
    </p>

    <h2 id="compliance">Регистрация и защита потребителей</h2>
    <p>
      Калифорния требует от помощников по юридическим документам
      регистрироваться у клерка округа, вносить гарантийный залог (bond)
      $25,000, проходить обучение и продлевать регистрацию — так потребитель
      знает, кто готовит его документы. Наша регистрация:
      LDA Reg. No. 2026-010, Sacramento County, expires 09/27/2028,
      Imverica LLC (округ Сакраменто, действует до 27.09.2028). Залог
      иммиграционного консультанта № 67347671, Western Surety Company,
      хранится у Государственного секретаря Калифорнии. Эти данные указаны
      и в каждом договоре.
    </p>
    <p>
      По формам USCIS мы работаем только как составитель документов по вашему поручению: никогда не выступаем вашим представителем перед USCIS и на каждом шаге сообщаем, что мы не адвокаты и не аккредитованные представители. Делам в иммиграционном суде (EOIR) нужен лицензированный адвокат или аккредитованный представитель (DOJ-accredited representative); по ним мы работаем только как paralegal под руководством адвоката.
    </p>

    <h2 id="contact">Как с нами связаться</h2>
    <p>Позвоните, напишите или начните онлайн. Отвечаем в тот же рабочий день, на вашем языке.</p>
    <ul class="contact-list">
      <li><strong>Телефон и SMS:</strong> <a href="tel:+19163993992">+1 (916) 399-3992</a></li>
      <li><strong>Email:</strong> <a href="mailto:info@imverica.com">info@imverica.com</a></li>
      <li><strong>Telegram:</strong> <a href="https://t.me/imverica" target="_blank" rel="noopener">t.me/imverica</a></li>
      <li><strong>Онлайн-анкета:</strong> <a href="/ru/#get-started">Начать здесь</a>: пять минут, можно приложить до пяти документов.</li>
      <li><strong>Личный кабинет:</strong> <a href="/account.html">imverica.com/account</a>: статус дел, обмен документами, сообщения.</li>
    </ul>
    <p>
      Офис в Сакраменто, Калифорния. Дела в судах Калифорнии — по всему
      штату; формы USCIS — для клиентов по всем США.
    </p>

    <cite>
      <strong>Важное уведомление.</strong> Imverica Legal Solutions — торговое
      наименование <strong>Imverica LLC</strong>, общества с ограниченной
      ответственностью штата Калифорния. Это зарегистрированный в Калифорнии
      Legal Document Assistant и Immigration Consultant, а не юридическая
      фирма. Мы не даём юридических консультаций, не устанавливаем отношений
      «адвокат — клиент» и не представляем клиентов в суде, в USCIS или EOIR.
      Вся работа выполняется по поручению стороны, представляющей себя
      самостоятельно, в соответствии с Cal. Bus. &amp; Prof. Code §§6400–6415
      и §§22440–22448.
    </cite>
  </LandingBody>

  <CategoryTiles
    kicker="Куда дальше"
    heading="Выберите направление"
    intro="Если уже знаете что вам нужно — переходите прямо туда:"
    tiles={[
      { icon: '🛂', title: 'Формы USCIS', desc: 'I-485, I-130, I-765, N-400, I-589: любой штат США.', href: '/ru/immigration', color: 'var(--navy)' },
      { icon: '👨‍👩‍👧', title: 'Семейное право CA',    desc: 'Развод, опека, алименты, post-judgment modifications.', href: '/ru/fl', color: 'var(--terracotta)' },
      { icon: '📃', title: 'Малые иски и civil',   desc: 'SC-100, demand letters, взыскание долга по решению.', href: '/ru/sc', color: 'var(--sage)' },
      { icon: '🏠', title: 'Выселение',            desc: 'UD-100, three-day notices, default-пакеты.', href: '/ru/california-unlawful-detainer', color: 'var(--gold)' },
      { icon: '🏛️', title: 'Наследственные дела',  desc: 'Серия DE-111, small estate affidavits, final distribution, DE-295 discharge.', href: '/ru/california-probate', color: 'var(--navy-light)' },
      { icon: '🧾', title: 'Record cleanup',       desc: 'CR-180/181 expungement / petition-for-dismissal packets, включая DUI.', href: '/ru/california-expungement', color: 'var(--gold)' },
      { icon: '🏢', title: 'Регистрация бизнеса',  desc: 'LLC-1, ARTS-GS, FBN/DBA, EIN, foreign-LLC.', href: '/ru/business', color: 'var(--terracotta-deep)' },
      { icon: '🤝', title: 'Для адвокатов',        desc: 'Независимый paralegal — USCIS по всему США, суды CA.', href: '/ru/for-attorneys', color: 'var(--terracotta)' },
      { icon: '📚', title: 'Что такое LDA?',       desc: 'Cal. Bus. & Prof. Code §§6400–6415 простыми словами.', href: '/ru/lda', color: 'var(--navy)' }
    ]}
  />

  <QuickFacts lang="ru" />

  <CTAStrip lang="ru"
    heading="Готовы — когда вы готовы."
    sub="Ответ в тот же день. Документы за 48 часов. Четыре языка. Доступные, прозрачные тарифы."
    primaryHref="/ru/#get-started"
    primaryText="Начать кейс"
  />

  <style>
    /* links inside running lists must not rely on colour alone */
    ul:not(.contact-list) li a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .contact-list {
      list-style: none;
      padding-left: 0;
      margin: 18px 0;
    }
    .contact-list li {
      padding: 10px 14px;
      margin-bottom: 8px;
      background: rgba(26,46,74,0.04);
      border-left: 3px solid var(--navy);
      border-radius: 0 6px 6px 0;
      font-size: 15px;
      line-height: 1.6;
    }
    .contact-list a {
      color: var(--navy);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .contact-list a:hover {
      color: var(--terracotta-deep);
    }
  </style>
</BaseLayout>
