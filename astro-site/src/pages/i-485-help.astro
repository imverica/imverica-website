---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SampleForm from '~/components/SampleForm.astro';
import WhyNotChatGPT from '~/components/WhyNotChatGPT.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CTAStrip from '~/components/CTAStrip.astro';

const title = 'I-485 Document Preparation — Adjustment of Status Help | Imverica';
const description = 'California Registered LDA prepares Form I-485 documents at the client\'s direction. The client or a licensed attorney must identify the filing basis and eligibility. No legal advice.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'I-485 Application to Register Permanent Residence Document Preparation',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  description: "Imverica prepares Form I-485 and organizes client-provided supporting materials at the client's direction. Related forms are included only when specifically directed and permitted by current USCIS instructions."
};
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/i-485-help"
  jsonLd={[serviceSchema]}
  slug="/i-485-help"
  availableLocales={['en', 'ru', 'uk', 'es']}
>
  <Hero
    eyebrow="USCIS · Adjustment of Status · INA §245(a)"
    heading="I-485 — Application to Register Permanent Residence or Adjust Status"
    sub="We prepare Form I-485 and organize the materials you provide at your direction. Depending on current USCIS instructions and your specific direction, a package may also include a sealed Form I-693 from a USCIS-designated civil surgeon and Forms I-765 or I-131. Flat-fee. English, Russian, Ukrainian, Spanish."
    ctaPrimary={{ href: '/#get-started?form=I-485', text: 'Start my I-485 package' }}
  />

  <LandingBody related={[
    { href: '/i-765-work-permit-help', label: 'I-765 — Application for Employment Authorization' },
    { href: '/i-589-asylum-help', label: 'I-589 — Asylum and Withholding of Removal' },
    { href: '/i-130-family-petition', label: 'I-130 — Family-based petition' },
    { href: '/lda', label: 'What is a California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      Form I-485 is the application a noncitizen physically present in the United
      States files with USCIS to adjust status to lawful permanent resident (the
      green card). Imverica prepares Form I-485 and organizes supporting materials
      you provide at your direction. Related forms are included only when you or
      a licensed attorney specifically direct their inclusion and current USCIS
      instructions permit them.
    </p>

    <h2>General information about who may file I-485</h2>
    <p>
      Form I-485 is used by some people who are physically present in the
      United States to request adjustment to lawful permanent resident status.
      Whether a person may file is case-specific and can depend on the filing
      basis, manner of entry, visa availability, admissibility, statutory bars
      and exceptions, and current law and USCIS instructions.
    </p>
    <p>
      USCIS lists possible filing bases that include family, employment,
      special-immigrant, asylee or refugee, and other humanitarian categories.
      Imverica does not determine whether you qualify, select a filing basis,
      or recommend a legal strategy. Review the current USCIS Form I-485 page
      and instructions before filing. If you are unsure whether you may file,
      consult a licensed immigration attorney.
    </p>

    <h2>Documents that may be included in an I-485 package</h2>
    <div class="form-list">
      <strong>Items we organize or prepare at your direction</strong>
      <ul>
        <li><strong>I-485</strong> — Application to Register Permanent Residence or Adjust Status (the main form)</li>
        <li><strong>I-693</strong> — Report of Immigration Medical Examination and Vaccination Record, when required. A USCIS-designated civil surgeon completes and seals this form. The client supplies the sealed form; Imverica only organizes it with the client-provided materials at the client's specific direction and does not open, alter, or complete it.</li>
        <li><strong>I-765</strong> — Application for Employment Authorization, when the client or a licensed attorney directs its inclusion and current USCIS rules permit filing</li>
        <li><strong>I-131</strong> — Application for Travel Documents, Parole Documents, and Arrival/Departure Records, when the client or a licensed attorney directs its inclusion and current USCIS rules permit filing</li>
        <li><strong>I-864</strong> / <strong>I-864A</strong> / <strong>I-864EZ</strong> — Affidavit of Support forms, when required for the filing basis identified by the client or a licensed attorney</li>
        <li><strong>I-912</strong> — Request for Fee Waiver, only when the requested benefit and filing category are eligible under current USCIS instructions and the client or a licensed attorney directs its inclusion</li>
        <li><strong>Supporting evidence</strong> — birth certificate, marriage certificate, passport biographic page, prior visa stamps, I-94, I-797 receipt and approval notices, prior immigration documents, photographs, and translations of any foreign-language documents under 8 CFR §103.2(b)(3)</li>
      </ul>
    </div>

    <h2>How our I-485 intake works</h2>
    <p>
      You answer a guided intake at your own pace. It collects the information
      requested by the current Form I-485 edition, including biographic,
      address, employment, family, immigration-history, and eligibility
      information. The client remains responsible for identifying the filing
      basis and answering legal or eligibility questions; Imverica enters the
      information the client provides and does not make those decisions.
    </p>
    <p>
      All your data is saved as you go. You can pause, switch languages, or
      come back later. When you finish, we assemble the package, generate
      the filing-ready PDFs, and walk you through what to assemble (USCIS
      fee or fee-waiver, color photographs to the current spec, civil
      documents and translations, and, when required, the sealed I-693 supplied
      by a USCIS-designated civil surgeon) before you sign and
      mail using the current USCIS filing instructions supplied for the filing
      basis identified by you or your licensed attorney.
    </p>

    <h2>What we do not do</h2>
    <p>
      As a California Legal Document Assistant and Immigration Consultant
      we cannot give legal advice, recommend a particular filing strategy,
      or represent you before USCIS or in immigration court. If selecting a
      filing basis, category, answer, or form requires legal analysis, we pause
      preparation until we receive your specific instructions or instructions
      from a licensed attorney. We will not prepare documents we cannot lawfully
      prepare under Business &amp; Professions Code §6411.
    </p>

    <h2>What an I-485 case usually costs through Imverica</h2>
    <p>
      We quote a flat fee per package, disclosed and agreed to in writing
      under Business &amp; Professions Code §6410 before any work begins.
      USCIS filing fees, the civil surgeon's medical-exam fee, biometric
      services fees when required, and any translator certification fees are
      separate and go to the respective issuer. Form I-912 is not available
      for every form, benefit, or filing category. Fee-waiver eligibility and
      required evidence depend on the requested benefit and current USCIS
      instructions. Imverica prepares I-912 only at the direction of the client
      or a licensed attorney and does not promise that USCIS will grant it.
    </p>

    <p><strong>Last reviewed:</strong> October 18, 2026.</p>

    <h2>Official USCIS resources</h2>
    <ul>
      <li><a href="https://www.uscis.gov/i-485" target="_blank" rel="noopener noreferrer">Form I-485 page and current instructions</a></li>
      <li><a href="https://www.uscis.gov/i-765" target="_blank" rel="noopener noreferrer">Form I-765 page and current instructions</a></li>
      <li><a href="https://www.uscis.gov/i-912" target="_blank" rel="noopener noreferrer">Form I-912 fee-waiver page and current instructions</a></li>
    </ul>

    <cite>
      <strong>Statutory authority:</strong> Immigration and Nationality Act
      §245(a), 8 U.S.C. §1255(a) (adjustment of status); 8 C.F.R. §§245.1,
      245.2 (procedure); 8 C.F.R. §103.2 (filing requirements); 8 C.F.R.
      §103.2(b)(3) (foreign-language translation certification); USCIS
      Policy Manual Volume 7 (Adjustment of Status). California scope:
      Cal. Bus. &amp; Prof. Code §§6400-6415 (Legal Document Assistant
      Act); §§22440-22448 (Immigration Consultant Act).
    </cite>
  </LandingBody>

  <SampleForm form="i-485" />
  <WhyNotChatGPT />

  <CTAStrip
    heading="Start your I-485 package today"
    sub="Multilingual intake. Flat-fee. Document preparation at your direction — not legal advice. Begin in your language and pick up where you left off any time."
    primaryHref="/#get-started?form=I-485"
    primaryText="Begin my I-485 intake"
  />
</BaseLayout>
