---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CategoryTiles from '~/components/CategoryTiles.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import QuickFacts from '~/components/QuickFacts.astro';
import FounderBlock from '~/components/FounderBlock.astro';

const lang = 'es' as const;
const title = 'Sobre Imverica — California LDA y Consultor de Inmigración | Imverica Legal Solutions';
const description = 'Imverica Legal Solutions es un Legal Document Assistant y Consultor de Inmigración multilingüe (inglés, ruso, ucraniano, español) con sede en Sacramento. Preparamos documentos de USCIS y de las cortes del estado de California en todo el país y en todo el estado — a tarifas accesibles y transparentes. No somos un bufete de abogados y no damos asesoría legal.';

---
<BaseLayout title={title} description={description} canonical="https://imverica.com/mx/about"
  slug="/about" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} >
  <Hero
    lang={lang}
    eyebrow="Sobre Imverica Legal Solutions"
    heading="Preparación de documentos accesible y multilingüe — adaptada a su situación"
    sub="Con sede en Sacramento. Todo el estado de California para cortes estatales; toda la nación para inmigración federal. Hablamos inglés, ruso, ucraniano y español. Preparamos documentos bajo su dirección — no somos un bufete de abogados y no damos asesoría legal."
    ctaPrimary={{ href: '/mx/#get-started', text: 'Iniciar su caso' }}
    ctaSecondary={{ href: 'tel:+19163993992', text: '📞 +1 (916) 399-3992' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/mx/lda', label: '¿Qué es un California Legal Document Assistant?' },
    { href: '/mx/for-attorneys', label: 'Para abogados — colaboración paralegal' },
    { href: '/mx/immigration', label: 'Formularios de USCIS que preparamos' },
    { href: '/mx/fl', label: 'Derecho familiar de California' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions nació en <strong>Sacramento, California</strong>,
      una de las ciudades con más diversidad étnica y lingüística de Estados
      Unidos. En cada cuadra hay una primera dirección en Estados Unidos, un
      pequeño negocio, un caso de familia, un paquete I-485 sin abrir porque
      las instrucciones están en un idioma que la persona no lee. Creamos
      Imverica para ser la oficina a la que esos vecinos de verdad pueden
      llegar: accesible, multilingüe y honesta.
    </p>

    <FounderBlock lang="es" />

    <h2 id="story">Quiénes somos</h2>
    <p>
      <strong>Imverica Legal Solutions</strong> es el nombre comercial (dba)
      de <strong>Imverica LLC</strong>, una sociedad de responsabilidad
      limitada de California, registrada como Asistente de Documentos Legales
      (<strong>Legal Document Assistant</strong>, Cal. Bus. &amp; Prof. Code
      §§6400–6415) y Consultor de Inmigración (<strong>Immigration
      Consultant</strong>, §§22440–22448). Trabajamos de dos formas:
      directamente con personas que se representan a sí mismas, donde
      <strong>usted dirige el trabajo</strong> y nosotros preparamos los
      documentos que usted elige; y como <strong>apoyo paralegal independiente
      para bufetes</strong>, donde el abogado dirige el trabajo y sigue siendo
      el abogado del caso.
    </p>
    <p>Tres promesas que no romperemos aunque perdamos el trabajo:</p>
    <ul>
      <li><strong>Honestidad sobre el alcance.</strong> Si su asunto necesita un abogado, se lo decimos en la primera llamada y le indicamos dónde encontrarlo. La primera llamada es gratuita.</li>
      <li><strong>Honestidad sobre el precio.</strong> Tarifa fija, conocida de antemano. Sin cobros por hora ni cargos sorpresa.</li>
      <li><strong>Honestidad sobre el resultado.</strong> Preparamos documentos bajo su dirección. No le decimos si califica, no predecimos lo que decidirá USCIS o un juez y nunca garantizamos un resultado.</li>
    </ul>

    <h2 id="why-us">Por qué trabajan con nosotros</h2>
    <ul>
      <li><strong>Cuatro idiomas.</strong> Formulario, documentos y seguimiento en <strong>inglés, ruso, ucraniano y español</strong>, con personas que los hablan en casa. El asistente del sitio le indica la página correcta; una persona prepara y revisa cada documento.</li>
      <li><strong>Primero el precio.</strong> Tarifa fija por documento o asunto. Usted ve el precio antes de decidir.</li>
      <li><strong>Rapidez.</strong> La mayoría de las cotizaciones el mismo día hábil; la mayoría de los documentos listos dentro de 48 horas después del formulario.</li>
      <li><strong>A distancia.</strong> Teléfono, email, Telegram y un portal seguro del cliente: no necesita ir a Sacramento. Firma electrónica donde se permite, originales por correo donde se requieren.</li>
      <li><strong>También para abogados.</strong> Los bufetes trabajan con nosotros como su paralegal independiente. <a href="/mx/for-attorneys">Opciones para abogados</a>.</li>
    </ul>

    <h2 id="scope">Lo que hacemos y lo que no hacemos</h2>
    <p><strong>Lo que preparamos:</strong></p>
    <ul>
      <li>Formularios de USCIS (I-485, I-130, I-765, I-589, N-400, I-90, I-131, I-864, respuestas a RFE, paquetes de pruebas).</li>
      <li><strong>Corte de inmigración (EOIR): solo para abogados.</strong> En casos de EOIR trabajamos solo como asistente legal (paralegal) bajo la dirección de un abogado y no preparamos escritos para la corte de inmigración para particulares (<a href="/mx/eoir-immigration-court">por qué</a>).</li>
      <li>Derecho familiar de California (FL-100/110/120, FL-150/160, FL-300, custodia, manutención, paquetes de sentencia).</li>
      <li>Reclamos menores y asuntos civiles en California (SC-100 a SC-140, cartas de demanda, embargo de salario, abstract of judgment).</li>
      <li>Documentos de desalojo en California para propietarios e inquilinos (UD-100/105/110, avisos de tres días, paquetes de rebeldía).</li>
      <li>Sucesiones en California (DE-111/121/160/221/295, small estate affidavits, inventario, distribución, cierre).</li>
      <li>Limpieza de antecedentes en California: paquetes de petition for dismissal (CR-180/181), incluido DUI, bajo su dirección.</li>
      <li>Trámites de negocio en California (LLC-1, LLC-12, ARTS-GS, FBN, EIN).</li>
      <li>Traducción certificada de documentos (ruso, ucraniano, español ↔ inglés) y coordinación de apostilla.</li>
    </ul>
    <p>
      <strong>Lo que no hacemos, por diseño y por ley:</strong> no damos
      asesoría legal, no lo representamos ante un tribunal, USCIS o EOIR, no
      firmamos escritos, no negociamos con la otra parte y no elegimos por
      usted qué formulario presentar. Si su situación necesita un abogado
      (litigio, estrategia, comparecencias), se lo diremos en la primera
      llamada y le indicaremos dónde encontrar abogados con licencia.
    </p>

    <h2 id="compliance">Registro y protección al consumidor</h2>
    <p>
      California exige que los Asistentes de Documentos Legales se registren
      ante el secretario del condado, depositen una fianza de $25,000,
      completen capacitación y renueven el registro, para que el consumidor
      sepa quién prepara sus documentos. Nuestro registro:
      LDA Reg. No. 2026-010, Sacramento County, expires 09/27/2028,
      Imverica LLC (condado de Sacramento, vigente hasta el 27/09/2028).
      Fianza de consultor de inmigración n.º 67347671 con Western Surety
      Company, registrada ante la Secretaría de Estado de California. Estos
      datos también aparecen en cada contrato.
    </p>
    <p>
      Con los formularios de USCIS actuamos solo como preparadores de documentos bajo su dirección: nunca lo representamos ante USCIS y en cada paso le informamos que no somos abogados ni representantes acreditados. Los asuntos de la corte de inmigración (EOIR) requieren un abogado con licencia o un representante acreditado por el DOJ; en ellos trabajamos solo como paralegal bajo la dirección de un abogado.
    </p>

    <h2 id="contact">Cómo contactarnos</h2>
    <p>Llame, escriba o empiece en línea. Respondemos el mismo día hábil, en su idioma.</p>
    <ul class="contact-list">
      <li><strong>Teléfono y SMS:</strong> <a href="tel:+19163993992">+1 (916) 399-3992</a></li>
      <li><strong>Email:</strong> <a href="mailto:info@imverica.com">info@imverica.com</a></li>
      <li><strong>Telegram:</strong> <a href="https://t.me/imverica" target="_blank" rel="noopener">t.me/imverica</a></li>
      <li><strong>Formulario en línea:</strong> <a href="/mx/#get-started">Empezar aquí</a>: cinco minutos, hasta cinco documentos adjuntos.</li>
      <li><strong>Portal del cliente:</strong> <a href="/account.html">imverica.com/account</a>: estado de sus asuntos, intercambio de documentos, mensajes.</li>
    </ul>
    <p>
      Oficina en Sacramento, California. Asuntos en tribunales de California
      en todo el estado; formularios de USCIS para clientes en todo Estados Unidos.
    </p>

    <cite>
      <strong>Aviso importante.</strong> Imverica Legal Solutions es el nombre
      comercial de <strong>Imverica LLC</strong>, una sociedad de
      responsabilidad limitada de California. Es un Legal Document Assistant y
      Immigration Consultant registrado en California, no un bufete de
      abogados. No damos asesoría legal, no establecemos una relación
      abogado-cliente y no representamos a clientes ante tribunales, USCIS ni
      EOIR. Todo el trabajo se realiza bajo la dirección de la parte que se
      representa a sí misma, conforme al Cal. Bus. &amp; Prof. Code
      §§6400–6415 y §§22440–22448.
    </cite>
  </LandingBody>

  <CategoryTiles
    kicker="Adónde ir"
    heading="Elija un área de servicio"
    intro="Si ya sabe lo que necesita, vaya directo:"
    tiles={[
      { icon: '🛂', title: 'Formularios de USCIS', desc: 'I-485, I-130, I-765, N-400, I-589: cualquier estado.', href: '/mx/immigration', color: 'var(--navy)' },
      { icon: '👨‍👩‍👧', title: 'Familia (CA)',         desc: 'Divorcio, custodia, manutención, modificaciones post-juicio.', href: '/mx/fl', color: 'var(--terracotta)' },
      { icon: '📃', title: 'Reclamos menores',       desc: 'SC-100, demand letters, cobro de juicio.', href: '/mx/sc', color: 'var(--sage)' },
      { icon: '🏠', title: 'Desalojo',               desc: 'UD-100, three-day notices, paquetes por incumplimiento.', href: '/mx/california-unlawful-detainer', color: 'var(--gold)' },
      { icon: '🏛️', title: 'Sucesiones',             desc: 'Serie DE-111, small estate affidavits, final distribution, DE-295 discharge.', href: '/mx/california-probate', color: 'var(--navy-light)' },
      { icon: '🧾', title: 'Record cleanup',          desc: 'CR-180/181 expungement / petition-for-dismissal packets, incluyendo DUI.', href: '/mx/california-expungement', color: 'var(--gold)' },
      { icon: '🏢', title: 'Trámites empresariales', desc: 'LLC-1, ARTS-GS, FBN/DBA, EIN, foreign-LLC.', href: '/mx/business', color: 'var(--terracotta-deep)' },
      { icon: '🤝', title: 'Para abogados',          desc: 'Paralegal independiente — USCIS nacional, cortes CA.', href: '/mx/for-attorneys', color: 'var(--terracotta)' },
      { icon: '📚', title: '¿Qué es un LDA?',        desc: 'Cal. Bus. & Prof. Code §§6400–6415 en lenguaje sencillo.', href: '/mx/lda', color: 'var(--navy)' }
    ]}
  />

  <QuickFacts lang="es" />

  <CTAStrip lang="es"
    heading="Listos cuando usted lo esté."
    sub="Respuesta el mismo día. Documentos preparados en 48 horas. Cuatro idiomas. Tarifas accesibles y transparentes."
    primaryHref="/mx/#get-started"
    primaryText="Iniciar su caso"
  />

  <style>
    /* links inside running lists must not rely on colour alone */
    ul:not(.contact-list) li a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .contact-list {
      list-style: none;
      padding-left: 0;
      margin: 18px 0;
    }
    .contact-list li {
      padding: 10px 14px;
      margin-bottom: 8px;
      background: rgba(26,46,74,0.04);
      border-left: 3px solid var(--navy);
      border-radius: 0 6px 6px 0;
      font-size: 15px;
      line-height: 1.6;
    }
    .contact-list a {
      color: var(--navy);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .contact-list a:hover {
      color: var(--terracotta-deep);
    }
  </style>
</BaseLayout>
