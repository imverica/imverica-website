---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CategoryTiles from '~/components/CategoryTiles.astro';
import CTAStrip from '~/components/CTAStrip.astro';

const lang = 'es' as const;
const title = 'Apoyo paralegal B2B para firmas jurídicas de California | Imverica';
const description = 'Apoyo B2B de preparación y organización de documentos para firmas jurídicas de California. La firma conserva todas las decisiones jurídicas, la relación con el cliente y la responsabilidad profesional.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'B2B document preparation support for California law firms',
  areaServed: { '@type': 'State', name: 'California' },
  provider: { '@id': 'https://imverica.com/#organization' },
  description: 'Apoyo administrativo de documentos para firmas jurídicas de California conforme a las instrucciones escritas de la firma.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/mx/for-attorneys"
  slug="/for-attorneys" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[schema]}>
  <div class="for-attorneys-hero">
    <Hero
      lang={lang}
      eyebrow="B2B · Firmas jurídicas de California"
      heading="Apoyo documental para su firma"
      sub="Preparamos y organizamos documentos conforme a las instrucciones escritas de su firma. La firma conserva las decisiones jurídicas, la relación con el cliente y la responsabilidad profesional."
      ctaPrimary={{ href: 'mailto:info@imverica.com?subject=Consulta%20B2B', text: 'Contactar a Imverica' }}
    />
  </div>

  <CategoryTiles
    kicker="Apoyo B2B"
    heading="Áreas documentales"
    intro="Servicios para firmas jurídicas de California, definidos por escrito para cada proyecto."
    tiles={[
      { icon: '🛂', title: 'USCIS', desc: 'Captura de datos, preparación de formularios, índices y organización de evidencia.', href: '#scope', color: 'var(--navy)' },
      { icon: '⚖️', title: 'EOIR', desc: 'Organización de expedientes, anexos y documentos indicados por la firma.', href: '#scope', color: 'var(--navy-dark)' },
      { icon: '👨‍👩‍👧', title: 'Familia · CA', desc: 'Preparación administrativa de formularios de California indicados por la firma.', href: '#scope', color: 'var(--terracotta)' },
      { icon: '📃', title: 'Civil · CA', desc: 'Reclamos menores, cobro de fallos y otros formularios indicados por la firma.', href: '#scope', color: 'var(--sage)' },
      { icon: '🏢', title: 'Empresas · CA', desc: 'Formularios empresariales y organización de documentos indicados por la firma.', href: '#scope', color: 'var(--terracotta-deep)' }
    ]}
  />

  <LandingBody lang={lang} related={[
    { href: '/mx/about', label: 'Sobre Imverica' },
    { href: '/mx/immigration', label: 'Preparación de documentos de inmigración' },
    { href: '/mx/fl', label: 'Formularios de familia de California' },
    { href: '/mx/business', label: 'Formularios empresariales de California' }
  ]}>
    <p class="lead">
      Imverica ofrece apoyo B2B de preparación de documentos a firmas jurídicas
      de California. Cada proyecto comienza con instrucciones escritas de la
      firma. Imverica no toma decisiones jurídicas, no recomienda estrategia y
      no se comunica con el cliente como representante de la firma.
    </p>

    <h2>Experiencia</h2>
    <p>
      Imverica tiene más de 10 años de experiencia preparando documentos de
      inmigración, incluido trabajo previo como paralegal bajo la dirección de
      profesionales autorizados en California para ejercer el derecho. La
      experiencia previa se describe como antecedente profesional y no como
      supervisión de los servicios actuales de Imverica.
    </p>

    <h2 id="scope">Alcance del apoyo</h2>
    <ul>
      <li>captura y transcripción de datos proporcionados por la firma;</li>
      <li>preparación de los formularios que la firma indique;</li>
      <li>organización, paginación e indexación de evidencia;</li>
      <li>control administrativo de versiones, firmas y documentos faltantes;</li>
      <li>traducciones certificadas y coordinación de documentos, cuando se acuerde por escrito.</li>
    </ul>

    <h2>Responsabilidades separadas</h2>
    <p>
      La firma conserva la selección de formularios, las decisiones jurídicas,
      la estrategia, la relación con el cliente, la revisión final y cualquier
      representación. Imverica prepara materiales conforme a las instrucciones
      escritas de la firma y al alcance acordado. Ninguna parte de este servicio
      promete un resultado ante una agencia o tribunal.
    </p>

    <h2>Contacto B2B</h2>
    <p>
      Envíe el tipo de documento, el volumen aproximado y el plazo solicitado a
      <a href="mailto:info@imverica.com">info@imverica.com</a> o llame al
      <a href="tel:+19163993992">+1 (916) 399-3992</a>. Confirmaremos por escrito
      el alcance y la tarifa antes de comenzar.
    </p>

    <cite>
      Imverica Legal Solutions es el nombre comercial de Imverica LLC. Este
      servicio B2B se limita a preparación y organización de documentos según
      instrucciones escritas. Imverica no brinda asesoría legal ni representación.
    </cite>
  </LandingBody>

  <CTAStrip lang="es"
    heading="Apoyo documental B2B para firmas de California"
    sub="Alcance y tarifa confirmados por escrito antes de comenzar."
    primaryHref="mailto:info@imverica.com?subject=Consulta%20B2B"
    primaryText="Contactar a Imverica"
  />

  <style is:global>
    /* Todo el hero es UN bloque alineado a la IZQUIERDA (eyebrow, título de dos
       líneas, párrafo, botones) con el mismo borde izquierdo y ancho común.
       Ver la versión EN. */
    .for-attorneys-hero .hero-wrap .hero {
      max-width: 880px;
      margin-inline: auto;
      text-align: center;
    }
    .for-attorneys-hero .hero-wrap .hero .hero-eyebrow { text-align: center; }
    .for-attorneys-hero .hero-wrap .hero h1 {
      max-width: 760px;
      margin-inline: auto;
      font-size: clamp(22px, 3.6vw, 44px);
      line-height: 1.08;
      text-align: center;
      text-wrap: balance;
    }
    .for-attorneys-hero .hero-wrap .hero .hero-sub {
      max-width: 760px; margin-inline: auto; text-align: center; text-wrap: pretty;
    }
    .for-attorneys-hero .hero-wrap .hero .hero-actions { justify-content: center; }
  </style>

  <style>
    .fee-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: 28px 0 8px; }
    @media (max-width: 760px) { .fee-grid { grid-template-columns: 1fr; } }
    .fee-card { background: #fff; border: 1px solid rgba(40,30,20,0.10); border-radius: 14px; padding: 22px 22px 18px; box-shadow: 0 6px 18px rgba(40,30,20,0.04); }
    .fee-card-highlight { border-color: var(--terracotta-deep); box-shadow: 0 10px 26px rgba(164,91,52,0.12); position: relative; }
    .fee-card-highlight::before {
      content: 'Más popular';
      position: absolute; top: -10px; right: 16px;
      background: var(--terracotta-deep); color: #fff;
      font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase;
      font-weight: 700; padding: 5px 10px; border-radius: 999px;
    }
    .fee-card-icon { font-size: 26px; margin-bottom: 8px; }
    .fee-card h3 { font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--navy-dark); margin: 0 0 6px; }
    .fee-card-lead { color: var(--terracotta-deep); font-weight: 600; font-size: 13px; margin: 0 0 10px; }
    .fee-card p { margin: 0 0 8px; font-size: 14px; line-height: 1.65; color: #3a4a5e; }
    .affordable-note { background: #fffaf2; border-left: 4px solid var(--terracotta-deep); padding: 14px 18px; border-radius: 4px; font-size: 14px; line-height: 1.65; margin: 24px 0 8px; }
  </style>
</BaseLayout>
