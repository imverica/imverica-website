---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import SampleForm from '~/components/SampleForm.astro';
import CTAStrip from '~/components/CTAStrip.astro';

const lang = 'es' as const;
const title = 'Preparación de documentos I-765 — permiso de trabajo (EAD) | Imverica';
const description = 'Un LDA registrado de California prepara el Formulario I-765 bajo la dirección del cliente. El cliente indica la categoría que ha decidido usar; Imverica no determina elegibilidad ni brinda asesoría legal.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'I-765 Employment Authorization Document Preparation',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  description: 'Preparación de documentos para Form I-765 (Application for Employment Authorization) bajo la dirección del solicitante.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/mx/i-765-work-permit-help"
  slug="/i-765-work-permit-help" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[schema]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Employment Authorization · 8 CFR §274a.12"
    heading="I-765 — Application for Employment Authorization"
    sub="Preparamos el Formulario I-765 con la categoría y los datos que usted proporcione. Usted indica la categoría que ha decidido usar; Imverica no determina elegibilidad. Preparación bajo su dirección — sin asesoría legal."
    ctaPrimary={{ href: '/#get-started?form=I-765', text: 'Comenzar paquete I-765' }}
  />

  <LandingBody related={[
    { href: '/mx/i-485-help', label: 'I-485 — Ajuste de Estatus (concurrent I-765 c)(9))' },
    { href: '/mx/i-589-asylum-help', label: 'I-589 — asilo pendiente y plazos de I-765 bajo (c)(8)' },
    { href: '/mx/lda', label: '¿Qué es un California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      El Formulario I-765 es la solicitud de Employment Authorization
      Document (EAD), la tarjeta física que un no-ciudadano necesita
      para acreditar su autorización de empleo en EE. UU. Preparamos el
      I-765 bajo la dirección del solicitante y usamos la categoría que este
      indique. Imverica no determina qué categoría corresponde ni brinda
      asesoría legal.
    </p>

    <h2>Ejemplos de códigos de categoría de elegibilidad</h2>
    <p>
      USCIS usa códigos de categoría como los siguientes. Esta es información
      general, no una determinación de elegibilidad. Las categorías, pruebas,
      tarifas y reglas de presentación pueden cambiar. Antes de presentar,
      consulte la página y las instrucciones actuales del Formulario I-765 de
      USCIS. Si necesita ayuda para elegir una categoría, consulte a una
      persona con licencia para ejercer el derecho.
    </p>
    <ul>
      <li><strong>(c)(8)</strong> — Ciertos solicitantes con una solicitud de asilo pendiente.</li>
      <li><strong>(c)(9)</strong> — Ciertos solicitantes con un Formulario I-485 pendiente.</li>
      <li><strong>(a)(12)</strong> / <strong>(c)(19)</strong> — Ciertos solicitantes o beneficiarios de Temporary Protected Status.</li>
      <li><strong>(c)(33)</strong> — Ciertos solicitantes de DACA.</li>
      <li><strong>(c)(11)</strong> — Ciertas personas con parole.</li>
      <li><strong>(a)(18)</strong> — Ciertos cónyuges de personas con estatus L-1.</li>
      <li><strong>(c)(26)</strong> — Ciertos cónyuges con estatus H-4.</li>
      <li><strong>(c)(14)</strong> — Ciertas personas con deferred action.</li>
    </ul>

    <h2>Lo que necesitamos de usted para I-765</h2>
    <ul>
      <li>Información biográfica (nombre legal, nombres anteriores, DOB, país de nacimiento, país de ciudadanía)</li>
      <li>SSN si fue emitido antes, o solicitud de tarjeta SSA mediante la propia I-765</li>
      <li>Direcciones actuales y anteriores en EE. UU.</li>
      <li>El I-94 más reciente o admission record; página biográfica del pasaporte; cualquier EAD previa</li>
      <li>Evidencia de la categoría de eligibility (recibo de I-589 pendiente para (c)(8), I-485 pendiente para (c)(9), TPS registration para (a)(12), etc.)</li>
      <li>Dos fotos passport-style (proporcionamos la especificación)</li>
    </ul>

    <h2>Filing fee y fee waiver</h2>
    <p>
      La tarifa del I-765 y la posibilidad de solicitar una exención dependen
      de la categoría de presentación, la solicitud de beneficio subyacente y
      las reglas actuales de USCIS. El Formulario I-912 no puede usarse con
      todos los formularios o categorías. Antes de presentar, consulte las
      páginas e instrucciones actuales de USCIS para I-765 e I-912. Imverica
      prepara I-912 solo bajo la dirección del cliente o conforme a instrucciones
      proporcionadas por una persona con licencia para ejercer el derecho; no
      determina la elegibilidad para una exención ni promete que
      USCIS la aprobará.
    </p>

    <p><strong>Última revisión:</strong> 18 de octubre de 2026.</p>

    <h2>Recursos oficiales de USCIS</h2>
    <ul>
      <li><a href="https://www.uscis.gov/i-765" target="_blank" rel="noopener noreferrer">Página del Formulario I-765 e instrucciones actuales</a></li>
      <li><a href="https://www.uscis.gov/i-912" target="_blank" rel="noopener noreferrer">Página del Formulario I-912 sobre exenciones e instrucciones actuales</a></li>
    </ul>

    <cite>
      <strong>Fuente:</strong> Immigration and Nationality Act §274A
      (employment authorization); 8 C.F.R. §274a.12 (categorías de
      extranjeros autorizados a trabajar); 8 C.F.R. §274a.13
      (solicitud); USCIS Policy Manual Volume 10 (Employment
      Authorization).
    </cite>
  </LandingBody>

  <SampleForm form="i-765" lang="es" />

  <CTAStrip lang="es"
    heading="Inicie su solicitud de permiso de trabajo I-765"
    sub="Entrevista multilingüe. Pause y continúe. Precio fijo. Preparación de documentos bajo su dirección — sin asesoría legal."
    primaryHref="/#get-started?form=I-765"
    primaryText="Comenzar entrevista I-765"
  />
</BaseLayout>
