---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import QuickFacts from '~/components/QuickFacts.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'es' as const;
const title = 'Sobre Imverica Legal Solutions — preparación de formularios de USCIS en español';
const description =
  'Imverica Legal Solutions es una empresa de preparación de documentos en Sacramento, California: Legal Document Assistant e Immigration Consultant registrado y afianzado. Servicio remoto en todo California, en español, inglés, ruso y ucraniano. Los documentos se preparan bajo la dirección del cliente; sin asesoría legal.';

const faq: FaqItem[] = [
  {
    q: '¿Imverica ayuda con permisos de trabajo y green card?',
    a: 'Sí. Imverica prepara, bajo la dirección específica del cliente, paquetes de documentos de USCIS: permisos de trabajo (I-765), ajuste de estatus (I-485), peticiones familiares (I-130), ciudadanía (N-400) y TPS. El servicio es remoto en todo California, con atención en español.'
  },
  {
    q: '¿Imverica es una firma jurídica?',
    a: 'No. Imverica Legal Solutions (Imverica LLC) es una empresa de preparación de documentos; su fundador es Legal Document Assistant e Immigration Consultant registrado y afianzado en California. Preparamos documentos bajo la dirección específica del cliente; no brindamos asesoría legal ni representación. Cuando necesita estrategia legal, consulte a una persona con licencia para ejercer el derecho.'
  },
  {
    q: '¿Trabajan solo en Sacramento?',
    a: 'No. Imverica atiende de forma remota en todo California, incluido Sacramento. Los documentos judiciales se preparan para las cortes de California.'
  },
  {
    q: '¿En qué idiomas atienden?',
    a: 'Español, inglés, ruso y ucraniano — la admisión, la revisión de documentos y el portal del cliente funcionan en los cuatro idiomas.'
  },
  {
    q: '¿Cuánto cuestan los servicios?',
    a: 'Imverica cobra tarifas fijas publicadas en imverica.com/pricing. Las tarifas del gobierno, cuando aplican, se pagan por separado directamente a USCIS o a la corte.'
  },
  {
    q: '¿En qué se diferencia Imverica de una persona autorizada para ejercer el derecho?',
    a: 'Una persona con la licencia correspondiente puede dar asesoría legal, elegir una estrategia y representar al cliente. Imverica prepara documentos únicamente bajo la dirección específica del cliente. Las preguntas sobre elegibilidad, consecuencias jurídicas, estrategia o representación requieren una persona autorizada para ejercer el derecho.'
  }
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/mx/about-imverica-legal-solutions"
  slug="/about-imverica-legal-solutions"
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[faqSchema(faq)]}
>
  <Hero
    lang={lang}
    eyebrow="Sacramento · Remoto en todo California"
    heading="Sobre Imverica Legal Solutions"
    sub="Imverica Legal Solutions prepara documentos de inmigración y para cortes de California bajo la dirección específica del cliente, de forma remota en todo California, en español, inglés, ruso y ucraniano."
  />

  <QuickFacts lang={lang} />

  <LandingBody lang={lang} related={[
    { href: '/mx/tps', label: 'TPS — Estatus de Protección Temporal' },
    { href: '/mx/i-765-work-permit-help', label: 'Permiso de trabajo I-765' },
    { href: '/pricing', label: 'Tarifas fijas' },
    { href: '/mx/lda', label: '¿Qué es un Legal Document Assistant de California?' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions es una empresa de preparación de documentos con
      sede en Sacramento que atiende de forma remota en todo California con
      formularios de inmigración de USCIS y documentos para las cortes de
      California. Es el nombre comercial de Imverica LLC, una sociedad de
      responsabilidad limitada de California, registrada y afianzada como
      Legal Document Assistant e Immigration Consultant (Cal. Bus. &amp;
      Prof. Code §§6400-6415 y §§22440-22448).
    </p>

    <p>
      Más de 10 años de experiencia en la preparación de documentos de
      inmigración, incluido trabajo previo como paralegal bajo la dirección de
      profesionales autorizados en California para ejercer el derecho. Los
      documentos para clientes autorrepresentados se preparan únicamente bajo
      su dirección específica; Imverica no brinda asesoría legal ni representación.
    </p>

    <h2>A quién ayudamos</h2>
    <ul>
      <li>inmigrantes hispanohablantes con trámites de USCIS;</li>
      <li>familias con peticiones I-130, green card I-485 y ciudadanía N-400;</li>
      <li>solicitantes de TPS — primeras solicitudes y reinscripciones;</li>
      <li>solicitantes de permisos de trabajo (I-765) y documentos de viaje (I-131);</li>
      <li>residentes de California con documentos judiciales: reclamos menores, divorcio, desalojo, sucesiones, limpieza de antecedentes.</li>
    </ul>

    <h2>Servicios</h2>
    <ul>
      <li>permisos de trabajo (I-765) y documentos de viaje (I-131);</li>
      <li>TPS (I-821) — primeras solicitudes y reinscripciones;</li>
      <li>paquetes de green card (I-485), peticiones familiares (I-130), ciudadanía (N-400);</li>
      <li>revisión de documentos antes de presentar, si usted llenó los formularios;</li>
      <li>traducciones certificadas de español / ruso / ucraniano al inglés;</li>
      <li>documentos para cortes de California: reclamos menores, derecho familiar, desalojo, sucesiones, expungement.</li>
    </ul>

    <h2>Cuándo necesita asesoría legal</h2>
    <p>
      Imverica no brinda asesoría legal, no determina elegibilidad, no elige
      estrategias y no representa a clientes ante USCIS o en corte. Para
      preguntas sobre elegibilidad, consecuencias jurídicas, estrategia,
      asuntos disputados o representación, consulte a una persona con licencia
      para ejercer el derecho.
    </p>
  </LandingBody>

  <FaqBlock heading="Preguntas frecuentes" items={faq} />

  <CTAStrip lang={lang} primaryHref="/#get-started" primaryText="Comenzar mi solicitud" />
</BaseLayout>
