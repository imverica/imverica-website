---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'es' as const;
const title = 'Control técnico de integridad USCIS en California | Imverica';
const description =
  'Control técnico de un paquete USCIS preparado por un cliente autorrepresentado de California: campos vacíos, consistencia interna, ediciones, firmas y lista oficial elegida por el cliente.';

const faqs: FaqItem[] = [
  {
    q: '¿Qué es una revisión de documentos USCIS?',
    a: 'Usted elige y prepara los formularios y la lista oficial. Señalamos campos vacíos, inconsistencias internas, ediciones desactualizadas y firmas ausentes, y comparamos sus materiales con la lista que usted eligió. Recibe observaciones técnicas por escrito.'
  },
  {
    q: '¿Es lo mismo que asesoría legal?',
    a: 'No. El control es técnico, no legal. No evaluamos elegibilidad, no elegimos formulario, evidencia, categoría de tarifa ni dirección, no interpretamos respuestas, no predecimos resultados ni elegimos estrategia.'
  },
  {
    q: '¿Qué paquetes terminados pueden verificarse?',
    a: 'Un cliente autorrepresentado de California puede solicitar un control técnico de un paquete USCIS ya llenado y elegido por el propio cliente. El cliente identifica los formularios, categoría, lista oficial y documentos antes de comenzar.'
  },
  {
    q: '¿Cuánto tarda el control técnico?',
    a: 'Imverica confirma por escrito un plazo estimado después de recibir el paquete completo y acordar el alcance. Imverica no controla ni promete el tiempo de procesamiento de USCIS.'
  },
  {
    q: '¿Cuánto cuesta la revisión de documentos?',
    a: 'La cotización fija se confirma por escrito después de recibir el paquete terminado y acordar el alcance técnico. El trabajo comienza solo después de su aprobación.'
  },
  {
    q: '¿Puedo comunicarme y enviar documentos en español?',
    a: 'Sí. La admisión y comunicación están disponibles en español, inglés, ruso y ucraniano. La traducción certificada de documentos elegidos por el cliente es un servicio separado cuando el cliente la solicita.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Control técnico de integridad USCIS dirigido por el cliente',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  availableLanguage: ['es', 'en', 'ru', 'uk'],
  description: 'Control técnico de paquetes USCIS preparados por clientes autorrepresentados de California: campos vacíos, consistencia interna, ediciones vigentes, firmas y lista oficial elegida por el cliente. Sin asesoría legal ni selección de formulario, evidencia, categoría o dirección.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/mx/uscis-document-review"
  slug="/uscis-document-review" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema(faqs)]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Revisión antes de presentar · ES | EN"
    heading="Control técnico de integridad del paquete USCIS"
    sub="Para clientes autorrepresentados de California que ya eligieron y llenaron sus formularios. Señalamos campos vacíos, inconsistencias internas, ediciones desactualizadas y firmas ausentes, y comparamos sus materiales con la lista oficial que usted eligió."
    ctaPrimary={{ href: '/#get-started?topic=REVIEW', text: 'Solicitar un control técnico' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/mx/i-765-work-permit-help', label: 'I-765 — permiso de trabajo' },
    { href: '/mx/tps', label: 'TPS — Estatus de Protección Temporal' },
    { href: '/pricing', label: 'Tarifas publicadas' },
    { href: '/mx/lda', label: '¿Qué es un Legal Document Assistant de California?' }
  ]}>
    <p class="lead">
      Este servicio es un control técnico dirigido por el cliente de un paquete
      preparado por el propio cliente. Usted elige el formulario, la categoría,
      la lista oficial y los documentos. Imverica señala cuestiones técnicas
      visibles; no decide qué presentar ni si el paquete es legalmente suficiente.
    </p>

    <h2>Para quién es</h2>
    <ul>
      <li>Es un cliente autorrepresentado de California y ya eligió y llenó un paquete USCIS.</li>
      <li>Llenó los formularios con una plantilla o un traductor y no está seguro de que cada respuesta quedó donde USCIS la espera.</li>
      <li>Su presentación anterior fue rechazada por una firma faltante, una edición incorrecta o una respuesta incompleta — y no quiere repetirlo.</li>
      <li>Quiere una revisión profesional pero no necesita la preparación completa desde cero.</li>
    </ul>

    <h2>Qué revisamos</h2>
    <ul>
      <li><strong>Campos vacíos</strong> — enumeramos campos visibles sin llenar para que usted los resuelva con las instrucciones oficiales elegidas.</li>
      <li><strong>Consistencia interna</strong> — comparamos nombres, fechas, direcciones y A-numbers entre los formularios y etiquetas proporcionados.</li>
      <li><strong>Edición del formulario</strong> — la fecha de edición de cada formulario es la que USCIS acepta actualmente.</li>
      <li><strong>Firmas y fechas</strong> — señalamos campos visibles de firma o fecha que están vacíos para que usted los revise.</li>
      <li><strong>Lista elegida por el cliente</strong> — comparamos los documentos proporcionados con la lista oficial de USCIS que usted identificó; Imverica no elige evidencia ni determina suficiencia.</li>
      <li><strong>Enlaces oficiales</strong> — podemos enlazar páginas vigentes de tarifas y direcciones de USCIS, pero usted elige categoría, tratamiento de tarifa y dirección.</li>
    </ul>

    <h2>Documentos que solemos revisar</h2>
    <p>
      Solicitudes I-765 de permiso de trabajo, documentos de viaje I-131,
      registros y reinscripciones de TPS (I-821), juegos I-485 de ajuste de
      estatus, peticiones familiares I-130, solicitudes N-400 de
      naturalización y renovaciones I-90 — cuando el cliente de California ya
      eligió los formularios, categoría, lista oficial y documentos.
    </p>

    <h2>Cómo funciona</h2>
    <ul>
      <li><strong>1. Suba sus archivos.</strong> Envíe los formularios llenos y las evidencias por el portal seguro del cliente — los archivos se cifran en reposo.</li>
      <li><strong>2. Cotización fija.</strong> Confirmamos el tamaño del paquete y damos un precio fijo antes de empezar.</li>
      <li><strong>3. Control técnico.</strong> Un preparador compara el paquete con la edición vigente y la lista oficial que usted seleccionó.</li>
      <li><strong>4. Observaciones por escrito.</strong> Recibe una lista de señales técnicas y enlaces oficiales — en español. Usted decide qué cambiar.</li>
    </ul>

    <cite>
      Imverica Legal Solutions es un Legal Document Assistant e Immigration
      Consultant registrado en California; no es un bufete de abogados. La
      revisión es un control técnico, no asesoría legal, selección de forma,
      categoría o evidencia, evaluación de elegibilidad ni predicción del
      resultado. Si no sabe qué presentar, consulte a un abogado de inmigración
      con licencia o a un representante acreditado por DOJ.
    </cite>
  </LandingBody>

  <FaqBlock heading="Preguntas frecuentes" items={faqs} />

  <CTAStrip lang={lang} primaryHref="/#get-started?topic=REVIEW" primaryText="Solicitar un control técnico" />
</BaseLayout>
