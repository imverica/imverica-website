---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ImmigrationCategories from '~/components/ImmigrationCategories.astro';
import ServiceSections from '~/components/ServiceSections.astro';

const lang = 'es' as const;
const title = 'Preparación de documentos de inmigración USCIS | Imverica Legal Solutions';
const description =
  'California Registered LDA e Immigration Consultant. Preparación de documentos USCIS (I-485, I-130, I-765, I-589, N-400, I-131, I-90) bajo la dirección del cliente. Corte de inmigración (EOIR): solo apoyo paralegal para abogados.';

const servicesES = [
  {
    id: 'immigration-consultant-california',
    title: 'Preparación de documentos de inmigración USCIS',
    text: 'Preparación completa de paquetes de formularios USCIS — ajuste de estatus, permiso de trabajo, peticiones familiares, naturalización, asilo, documentos de viaje, reposición de green card y affidavits de respaldo.',
    items: [
      'I-485 — Adjustment of Status',
      'I-130 | I-130A — Petition for Alien Relative',
      'I-765 — Employment Authorization',
      'I-589 — Asylum & Withholding of Removal',
      'N-400 — Naturalization',
      'I-131 | I-131A — Travel Document | Re-entry Permit',
      'I-90 — Green Card Renewal | Replacement',
      'I-864 | I-864A — Affidavit of Support',
      'I-693 — Medical Examination submittal',
      'I-751 — Removal of Conditions on Residence',
      'I-539 — Change | Extend Non-immigrant Status',
      'I-824 — Action on Approved Application'
    ],
    cite: 'Los documentos se preparan bajo la dirección del cliente. No seleccionamos formularios ni brindamos asesoría legal.'
  },
  {
    id: 'eoir-documents',
    title: 'Corte de inmigración EOIR: solo para abogados',
    text: 'En casos de la corte de inmigración trabajamos solo como asistente legal (paralegal) bajo la dirección de un abogado: borradores para revisión del abogado, índices de anexos, traducciones. No preparamos escritos de EOIR para particulares: en un procedimiento de deportación se necesita un abogado con licencia o un representante acreditado por el DOJ.',
    items: [
      'EOIR-28 — Notice of Entry of Appearance',
      'EOIR-29 — Notice of Appeal (BIA)',
      'EOIR-42A — Cancellation of Removal (LPR)',
      'EOIR-42B — Cancellation of Removal (Non-LPR)',
      'EOIR-40 — Suspension of Deportation',
      'Motion to reopen | reconsider — paquetes',
      'Evidence packets, indexes, tabs',
      'Armado de country-conditions evidence',
      'Declaraciones de testigos y preparación de traducciones'
    ],
    cite: 'Solo un abogado o un representante acreditado por el DOJ puede asesorar o representar ante EOIR (8 C.F.R. § 1292.1).'
  },
  {
    id: 'document-translation-california',
    title: 'Traducciones, notary public y apoyo de documentos',
    text: 'Apoyo multilingüe de documentos para paquetes de inmigración y corte — traducciones, coordinación de apostille, apoyo de notary public y armado de paquetes para presentar.',
    items: [
      'Inglés, ruso, ucraniano, español',
      'Coordinación de traducciones certificadas',
      'Organización de documentos',
      'Revisión del paquete antes de presentar'
    ],
    cite: 'El apoyo de traducción no incluye asesoría legal.'
  }
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/mx/immigration"
  slug="/immigration"
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
>
  <ImmigrationCategories lang={lang} />
  <ServiceSections
    lang={lang}
    include={['immigration-consultant-california', 'eoir-documents', 'document-translation-california']}
    servicesOverride={servicesES}
    kicker="USCIS · Preparación de documentos de inmigración"
    heading="Peticiones USCIS bajo su dirección"
    intro="Imverica Legal Solutions es un Immigration Consultant y Legal Document Assistant registrado en California. Preparamos peticiones USCIS bajo la dirección del cliente, con precisión, organizadas y a tiempo. Los casos de la corte de inmigración (EOIR) requieren un abogado con licencia o un representante acreditado por el DOJ; en ellos trabajamos solo como paralegal bajo la dirección de un abogado. No somos un bufete y no brindamos asesoría legal."
  />
</BaseLayout>
