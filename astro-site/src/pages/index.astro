---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import LatestUpdates from '~/components/LatestUpdates.astro';
import StatsStrip from '~/components/StatsStrip.astro';
import OurServices from '~/components/OurServices.astro';
import VisaBulletin from '~/components/VisaBulletin.astro';
import Testimonials from '~/components/Testimonials.astro';
import AboutStrip from '~/components/AboutStrip.astro';
import HeroV2 from '~/components/HeroV2.astro';
import V2Swap from '~/components/V2Swap.astro';

const title = 'Imverica Legal Solutions | USCIS · California Forms';
const description =
  'California Registered LDA & Immigration Consultant. Client-directed document preparation for USCIS and California court forms, plus attorney-directed paralegal document support for EOIR matters. Remote service throughout California. No legal advice.';

---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/"
  slug="/"
  availableLocales={['en', 'ru', 'uk', 'es']}
>
  <div data-v2-old="hero">
  <Hero
    eyebrow={"California · Registered LDA · Immigration Consultant"}
    heading="What document do you need prepared?"
    headingHtml={'What document do you need <em class="hero-em">prepared?</em>'}
    sub="Describe the document you want prepared or enter a form number. We prepare USCIS and California court documents at your specific direction for clients throughout California. EOIR support is for attorneys only. No legal advice."
    showActions={false}
  >
    <HomeSearch />
  </Hero>
  </div>
  {/* v2 preview: hero (current copy + alternate line, the finder, real form
      pages) and statement. Inert in <template>; V2Swap swaps it in before
      first paint only under <html class="v2">. Sections below are shared. */}
  <template data-v2-new="hero">
    <HeroV2
      lang="en"
      eyebrow="California · Registered LDA · Immigration Consultant"
      heading="What document do you need prepared?"
      sub="Describe the document you want prepared or enter a form number. We prepare USCIS and California court documents at your specific direction for clients throughout California. EOIR support is for attorneys only. No legal advice."
    />
  </template>
  <V2Swap />

  <StatsStrip />

  <OurServices />

  <LatestUpdates />

  <VisaBulletin />


  <Testimonials />

  <AboutStrip />
</BaseLayout>
