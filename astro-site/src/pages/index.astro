---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import LatestUpdates from '~/components/LatestUpdates.astro';
import StatsStrip from '~/components/StatsStrip.astro';
import OurServices from '~/components/OurServices.astro';
import VisaBulletin from '~/components/VisaBulletin.astro';
import Testimonials from '~/components/Testimonials.astro';
import AboutStrip from '~/components/AboutStrip.astro';
import HeroV2 from '~/components/HeroV2.astro';

const title = 'Imverica Legal Solutions | USCIS · EOIR · California Forms';
const description =
  'California Registered LDA & Immigration Consultant. Document preparation for USCIS, EOIR, family law, small claims, probate closing, and California expungement / record-cleanup packets. Remote service worldwide.';

---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/"
  slug="/"
  availableLocales={['en', 'ru', 'uk', 'es']}
>
  <div id="home-v1">
  <Hero
    eyebrow={"California · Registered LDA · Immigration Consultant"}
    heading="What document do you need prepared?"
    headingHtml={'What document do you need <em class="hero-em">prepared?</em>'}
    sub="Describe your situation or enter a form number. We prepare USCIS, EOIR, and California court documents at your direction — for clients across California and worldwide."
    showActions={false}
  >
    <HomeSearch />
  </Hero>
  </div>

  {/* v2 preview opening (hero with the same finder, real form pages,
      statement). Inert inside <template> (not rendered or indexed); swapped
      in before first paint only when <html class="v2">. The sections below
      are shared by both designs. */}
  <template id="home-v2"><HeroV2 /></template>
  <script is:inline>
    (function () {
      var html = document.documentElement;
      if (!html.classList.contains('v2')) return;
      try {
        var tpl = document.getElementById('home-v2');
        var v1 = document.getElementById('home-v1');
        var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && 'IntersectionObserver' in window) html.classList.add('hv2-motion');
        v1.replaceWith(tpl.content.cloneNode(true));
        tpl.remove();
      } catch (e) {
        // Never leave a blank hero: fall back to the current one.
        html.classList.add('hv2-off');
      }
    })();
  </script>

  <StatsStrip />

  <OurServices />

  <LatestUpdates />

  <VisaBulletin />

  <Testimonials />

  <AboutStrip />
</BaseLayout>
