---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import LatestUpdates from '~/components/LatestUpdates.astro';
import StatsStrip from '~/components/StatsStrip.astro';
import OurServices from '~/components/OurServices.astro';
import VisaBulletin from '~/components/VisaBulletin.astro';
import Testimonials from '~/components/Testimonials.astro';
import AboutStrip from '~/components/AboutStrip.astro';
import HeroV2 from '~/components/HeroV2.astro';
import V2Swap from '~/components/V2Swap.astro';
import HomeSliderV2 from '~/components/HomeSliderV2.astro';

const title = 'Imverica Legal Solutions | USCIS · EOIR · California Forms';
const description =
  'California Registered LDA & Immigration Consultant. Document preparation for USCIS, EOIR, family law, small claims, probate closing, and California expungement / record-cleanup packets. Remote service worldwide.';

---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/"
  slug="/"
  availableLocales={['en', 'ru', 'uk', 'es']}
>
  <div data-v2-old="hero">
  <Hero
    eyebrow={"California · Registered LDA · Immigration Consultant"}
    heading="What document do you need prepared?"
    headingHtml={'What document do you need <em class="hero-em">prepared?</em>'}
    sub="Describe your situation or enter a form number. We prepare USCIS, EOIR, and California court documents at your direction — for clients across California and worldwide."
    showActions={false}
  >
    <HomeSearch />
  </Hero>
  </div>
  {/* v2 preview: hero (current copy + alternate line, the finder, real form
      pages) and statement. Inert in <template>; V2Swap swaps it in before
      first paint only under <html class="v2">. Sections below are shared. */}
  <template data-v2-new="hero">
    <HeroV2
      lang="en"
      eyebrow="California · Registered LDA · Immigration Consultant"
      heading="What document do you need prepared?"
      sub="Describe your situation or enter a form number. We prepare USCIS, EOIR, and California court documents at your direction — for clients across California and worldwide."
    />
  </template>
  <V2Swap />

  <StatsStrip />

  <OurServices />

  {/* v2: form slider under the services (empty placeholder without the flag) */}
  <div data-v2-old="slider"></div>
  <template data-v2-new="slider"><HomeSliderV2 lang="en" /></template>
  <V2Swap />

  <LatestUpdates />

  <VisaBulletin />

  <Testimonials />

  <AboutStrip />
</BaseLayout>
