---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import QuickFacts from '~/components/QuickFacts.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'uk' as const;
const title = 'Про Imverica Legal Solutions — підготовка форм USCIS українською';
const description =
  'Imverica Legal Solutions — компанія із Сакраменто (Каліфорнія): зареєстрований і застрахований Legal Document Assistant та Immigration Consultant. Підготовка форм USCIS — U4U re-parole, TPS, дозволи на роботу, грін-карти — дистанційно по всіх штатах США українською, російською, англійською та іспанською. Не адвокатська фірма.';

const faq: FaqItem[] = [
  {
    q: 'Чи допомагає Imverica з re-parole за програмою U4U?',
    a: 'Так. Imverica готує пакети документів для продовження гуманітарного пароля (re-parole) за програмою Uniting for Ukraine, а також повʼязані подачі: дозвіл на роботу I-765 (категорія (c)(11)) та advance parole I-131. Працюємо повністю дистанційно по всій території США, приймаємо українською, російською, англійською та іспанською.'
  },
  {
    q: 'Imverica — це адвокатська фірма?',
    a: 'Ні. Imverica Legal Solutions (Imverica LLC) — зареєстрований і застрахований у Каліфорнії Legal Document Assistant та Immigration Consultant. Ми готуємо документи за дорученням клієнта, не надаємо юридичних консультацій і не представляємо клієнтів в USCIS чи суді. Якщо справі потрібна юридична стратегія — направляємо до ліцензованого імміграційного адвоката.'
  },
  {
    q: 'Ви працюєте лише в Сакраменто?',
    a: 'Ні. Форми USCIS — федеральні, тому ми працюємо дистанційно з клієнтами в усіх штатах США. Судові документи (дрібні позови, сімейне право, виселення, спадщина, очищення судимостей) готуємо для судів Каліфорнії.'
  },
  {
    q: 'Якими мовами можна звертатися?',
    a: 'Українською, російською, англійською та іспанською — приймання, перевірка документів і особистий кабінет працюють усіма чотирма мовами.'
  },
  {
    q: 'Скільки коштують послуги?',
    a: 'В Imverica фіксовані опубліковані тарифи — вони перелічені на imverica.com/pricing. Державні збори, якщо вони є, сплачуються окремо безпосередньо в USCIS або суд.'
  },
  {
    q: 'Чим Imverica відрізняється від імміграційного адвоката?',
    a: 'Адвокат надає юридичні консультації, обирає стратегію і може представляти вас в USCIS чи суді. Imverica — сервіс підготовки документів: ви вирішуєте, що подавати, а ми акуратно та повністю готуємо папери за вашим дорученням за фіксовану плату. Для стандартних подач — re-parole за U4U, перереєстрація TPS, дозвіл на роботу — підготовки документів часто достатньо, і це дешевше за послуги адвоката. Для складних справ направимо до ліцензованого адвоката.'
  }
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/ua/about-imverica-legal-solutions"
  slug="/about-imverica-legal-solutions"
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[faqSchema(faq)]}
>
  <Hero
    lang={lang}
    eyebrow="Сакраменто, Каліфорнія · Дистанційно по всіх США"
    heading="Про Imverica Legal Solutions"
    sub="Якщо ви шукаєте україномовну допомогу з формами USCIS — U4U re-parole, TPS, дозвіл на роботу чи підготовка документів на грін-карту — Imverica Legal Solutions працює з клієнтами дистанційно по всій території США із Сакраменто, Каліфорнія."
  />

  <QuickFacts lang={lang} />

  <LandingBody lang={lang} related={[
    { href: '/ua/u4u', label: 'U4U та re-parole — підготовка документів' },
    { href: '/ua/tps', label: 'TPS — Temporary Protected Status' },
    { href: '/pricing', label: 'Фіксовані тарифи' },
    { href: '/ua/lda', label: 'Хто такий California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions — компанія з підготовки документів із
      Сакраменто, яка допомагає клієнтам по всій території США з
      імміграційними формами USCIS та документами для судів Каліфорнії.
      Це торгова назва Imverica LLC — каліфорнійської компанії з обмеженою
      відповідальністю, зареєстрованої та застрахованої як Legal Document
      Assistant та Immigration Consultant (Cal. Bus. &amp; Prof. Code
      §§6400-6415 та §§22440-22448).
    </p>

    <h2>Кому ми допомагаємо</h2>
    <ul>
      <li>українцям, які приїхали за програмою Uniting for Ukraine (U4U) — re-parole, дозволи на роботу, TPS, проїзні документи;</li>
      <li>російськомовним та іспаномовним іммігрантам із подачами в USCIS;</li>
      <li>сім’ям із петиціями I-130, грін-картами I-485 та громадянством N-400;</li>
      <li>заявникам TPS — первинні подачі та перереєстрації;</li>
      <li>мешканцям Каліфорнії із судовими документами: дрібні позови, розлучення, виселення, спадщина, очищення судимостей.</li>
    </ul>

    <h2>Послуги</h2>
    <ul>
      <li>пакети документів для re-parole за U4U;</li>
      <li>TPS (I-821) — первинні подачі та перереєстрації;</li>
      <li>дозволи на роботу (I-765), проїзні документи (I-131);</li>
      <li>пакети на грін-карту (I-485), сімейні петиції (I-130), громадянство (N-400);</li>
      <li>перевірка документів перед подачею, якщо ви заповнювали форми самостійно;</li>
      <li>сертифіковані переклади з української / російської / іспанської на англійську;</li>
      <li>документи для судів Каліфорнії: дрібні позови, сімейне право, виселення, спадщина, експанджмент.</li>
    </ul>

    <h2>Коли потрібен адвокат, а не ми</h2>
    <p>
      Судимості, депортаційні провадження, слухання щодо притулку в суді,
      попередні відмови та все, що потребує юридичної стратегії, — робота
      ліцензованого імміграційного адвоката. Imverica цим не займається:
      у нас є перевірені адвокати для направлення, і ми прямо скажемо,
      якщо ваша ситуація потребує саме адвоката.
    </p>
  </LandingBody>

  <FaqBlock heading="Часті запитання" items={faq} />

  <CTAStrip lang={lang} primaryHref="/#get-started" primaryText="Почати запит" />
</BaseLayout>
