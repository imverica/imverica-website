---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'uk' as const;
const title = 'Пряма підготовка документів і підтримка під керівництвом адвоката | Imverica';
const description =
  'Два окремі формати роботи Imverica: підготовка документів за дорученням клієнтів у Каліфорнії, які представляють себе самостійно, та паралегальна підтримка під керівництвом і перевіркою ліцензованого адвоката.';

const faq: FaqItem[] = [
  {
    q: 'Чи представляє Imverica прямих клієнтів?',
    a: 'Ні. Прямий клієнт залишається стороною, що представляє себе самостійно. Imverica не виступає за нього в USCIS чи суді й не створює відносин «адвокат — клієнт».'
  },
  {
    q: 'Чи може Imverica сказати прямому клієнту, яку форму або правовий варіант обрати?',
    a: 'Ні. Прямий клієнт сам вирішує, що подавати, і надає конкретні інструкції. Питання про право на імміграційну пільгу, правові варіанти, права та стратегію належать до роботи ліцензованого адвоката.'
  },
  {
    q: 'Хто керує роботою під час підтримки адвоката?',
    a: 'Ліцензований адвокат визначає завдання, спрямовує та перевіряє роботу, повідомляє клієнту юридичні рекомендації й залишається відповідальним за справу та представництво.'
  },
  {
    q: 'Чи стає Imverica адвокатською фірмою під час роботи з адвокатом?',
    a: 'Ні. Imverica залишається неадвокатським постачальником послуг. Підтримка адвоката — це окремий договір між компаніями, що виконується під наглядом відповідального адвоката.'
  }
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="https://imverica.com/ua/direct-document-preparation-vs-attorney-supervised-paralegal"
  slug="/direct-document-preparation-vs-attorney-supervised-paralegal"
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[faqSchema(faq)]}
>
  <Hero
    lang={lang}
    eyebrow="Два окремі формати роботи"
    heading="Пряма підготовка документів і підтримка адвоката — різні послуги"
    sub="Залежно від договору змінюється той, хто приймає юридичні рішення, керує роботою та відповідає за справу. Imverica не змішує ці відносини."
  />

  <LandingBody lang={lang} related={[
    { href: '/ua/about-imverica-legal-solutions', label: 'Перевірні факти про Imverica' },
    { href: '/ua/lda', label: 'Хто такий California Legal Document Assistant?' },
    { href: '/pricing', label: 'Опубліковані тарифи прямих послуг' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions не є адвокатською фірмою. Компанія може
      працювати одним із двох чітко розділених способів: безпосередньо для
      клієнта в Каліфорнії, який представляє себе самостійно й надає конкретні
      інструкції, або виконувати неадвокатське завдання під керівництвом і
      перевіркою ліцензованого адвоката.
    </p>

    <h2>1. Пряма підготовка документів для клієнта, який представляє себе самостійно</h2>
    <ul>
      <li>Послуга надається дистанційно клієнтам у Каліфорнії, які представляють себе самостійно.</li>
      <li>Клієнт сам вирішує, яку форму чи документ готувати, і надає конкретні інструкції.</li>
      <li>У межах письмового завдання Imverica може вносити дані, складати обрані клієнтом матеріали, упорядковувати документи та надавати сертифіковані переклади.</li>
      <li>Imverica не визначає право на пільгу, не обирає засіб захисту чи форму, не радить стратегію, не прогнозує результат і не представляє клієнта.</li>
      <li>Письмовий договір на пряму послугу визначає роботу та ціну.</li>
    </ul>

    <h2>2. Паралегальна підтримка під керівництвом ліцензованого адвоката</h2>
    <ul>
      <li>Це окремий договір між Imverica та ліцензованим адвокатом або адвокатською фірмою.</li>
      <li>Адвокат визначає завдання та надає юридичні вказівки.</li>
      <li>Адвокат перевіряє роботу, повідомляє клієнту юридичні рекомендації та відповідає за відносини з клієнтом, правову оцінку, подання й представництво.</li>
      <li>Imverica виконує лише доручені неадвокатські допоміжні завдання в межах письмового обсягу.</li>
      <li>Доступність залежить від договору та правил, застосовних до відповідального адвоката.</li>
    </ul>

    <h2>Ці відносини не перетинаються</h2>
    <p>
      Окрема співпраця адвоката з Imverica не означає, що адвокат представляє
      прямого клієнта Imverica. Якщо прямому клієнту потрібно вирішити, що
      подавати або як закон застосовується до його ситуації, йому слід укласти
      окремий договір із ліцензованим адвокатом.
    </p>

    <h2>Чому це важливо</h2>
    <p>
      Під час прямої підготовки документів роботою керує клієнт, який
      представляє себе самостійно. Під час роботи з адвокатом завданням керує
      ліцензований адвокат. Чіткий опис цієї різниці захищає клієнта, адвоката
      й точність публічної інформації про Imverica.
    </p>
  </LandingBody>

  <FaqBlock heading="Часті запитання" items={faq} />
  <CTAStrip lang={lang} primaryHref="/ua/#get-started" primaryText="Запросити підготовку документів" />
</BaseLayout>
