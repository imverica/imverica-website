---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CategoryTiles from '~/components/CategoryTiles.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import QuickFacts from '~/components/QuickFacts.astro';
import FounderBlock from '~/components/FounderBlock.astro';

const lang = 'uk' as const;
const title = 'Про компанію Imverica — California LDA та Immigration Consultant | Imverica Legal Solutions';
const description = "Imverica Legal Solutions — мультимовний (англійська, російська, українська, іспанська) Legal Document Assistant та Immigration Consultant із Сакраменто. Готуємо документи USCIS та судів Каліфорнії по всій території США та штату — за доступними, прозорими тарифами. Ми не юридична фірма й не надаємо юридичних консультацій.";

---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ua/about"
  slug="/about" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} >
  <Hero
    lang={lang}
    eyebrow="Про Imverica Legal Solutions"
    heading="Доступна підготовка документів чотирма мовами — під вашу ситуацію"
    sub="База в Сакраменто. Каліфорнійські суди по всьому штату, USCIS — по всіх США. Говоримо англійською, російською, українською та іспанською. Готуємо документи за вашим дорученням — ми не юридична фірма і не надаємо юридичних консультацій."
    ctaPrimary={{ href: '/ua/#get-started', text: 'Почати кейс' }}
    ctaSecondary={{ href: 'tel:+19163993992', text: '📞 +1 (916) 399-3992' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/ua/lda', label: 'Хто такий California Legal Document Assistant?' },
    { href: '/ua/for-attorneys', label: 'Для адвокатів — paralegal-партнерство' },
    { href: '/ua/immigration', label: 'Форми USCIS, які ми готуємо' },
    { href: '/ua/fl', label: 'Сімейне право Каліфорнії' },
    { href: '/ua/sacramento', label: 'Документи у Сакраменто — українською' }
  ]}>
    <p class="lead">
      Imverica Legal Solutions з'явилася в <strong>Сакраменто, Каліфорнія</strong>,
      одному з найбагатонаціональніших і найбагатомовніших міст США. Тут на
      кожній вулиці чиясь перша адреса в Америці, чийсь малий бізнес, чиясь
      сімейна справа, чийсь пакет I-485, що лежить нерозкритим, бо інструкція
      написана чужою мовою. Ми створили Imverica як офіс, до якого такі
      сусіди справді можуть прийти: доступний, багатомовний і чесний.
    </p>

    <FounderBlock lang="uk" />

    <h2 id="story">Хто ми</h2>
    <p>
      <strong>Imverica Legal Solutions</strong> — торговельне найменування
      (dba) компанії <strong>Imverica LLC</strong>, товариства з обмеженою
      відповідальністю штату Каліфорнія, зареєстрованого як помічник з
      юридичних документів (<strong>Legal Document Assistant</strong>,
      Cal. Bus. &amp; Prof. Code §§6400–6415) та імміграційний консультант
      (<strong>Immigration Consultant</strong>, §§22440–22448). Ми працюємо
      у двох форматах: напряму з людьми, які представляють себе самі, — тут
      <strong>роботою керуєте ви</strong>, а ми готуємо обрані вами документи;
      і як <strong>незалежна paralegal-підтримка юридичних фірм</strong> —
      тут роботою керує адвокат, і він залишається адвокатом у справі.
    </p>
    <p>Три обіцянки, яких ми не порушимо, навіть якщо втратимо клієнта:</p>
    <ul>
      <li><strong>Чесно про межі.</strong> Якщо вашій справі потрібен адвокат, ми скажемо це під час першого дзвінка й підкажемо, де його знайти. Перший дзвінок безкоштовний.</li>
      <li><strong>Чесно про ціну.</strong> Фіксована ціна, відома заздалегідь. Без погодинної оплати та несподіваних доплат.</li>
      <li><strong>Чесно про результат.</strong> Ми готуємо документи за вашим дорученням. Ми не кажемо, чи ви підходите, не передбачаємо рішення USCIS чи судді й ніколи не гарантуємо результат.</li>
    </ul>

    <h2 id="why-us">Чому з нами працюють</h2>
    <ul>
      <li><strong>Чотири мови.</strong> Анкета, документи й листування <strong>англійською, російською, українською та іспанською</strong> — з людьми, для яких це рідна мова. Помічник на сайті підкаже потрібну сторінку, а кожен документ готує й перевіряє людина.</li>
      <li><strong>Спочатку ціна.</strong> Фіксований тариф за документ або справу. Ви бачите ціну, перш ніж вирішити.</li>
      <li><strong>Швидкість.</strong> Розрахунок вартості зазвичай того ж робочого дня, більшість документів готові протягом 48 годин після заповнення анкети.</li>
      <li><strong>Дистанційно.</strong> Телефон, email, Telegram і захищений особистий кабінет: їхати до Сакраменто не потрібно. Електронний підпис там, де він дозволений, оригінали поштою там, де вони потрібні.</li>
      <li><strong>І для адвокатів.</strong> Юридичні фірми працюють з нами як з незалежним paralegal. <a href="/ua/for-attorneys">Варіанти співпраці для адвокатів</a>.</li>
    </ul>

    <h2 id="scope">Що ми робимо і чого не робимо</h2>
    <p><strong>Що ми готуємо:</strong></p>
    <ul>
      <li>Форми USCIS (I-485, I-130, I-765, I-589, N-400, I-90, I-131, I-864, відповіді на RFE, пакети доказів).</li>
      <li><strong>Імміграційний суд (EOIR): лише для адвокатів.</strong> У справах EOIR ми працюємо лише як помічник юриста (paralegal) під керівництвом адвоката й не готуємо документи до імміграційного суду для приватних осіб (<a href="/ua/eoir-immigration-court">чому</a>).</li>
      <li>Сімейне право Каліфорнії (FL-100/110/120, FL-150/160, FL-300, опіка, аліменти, пакети судового рішення).</li>
      <li>Малі позови та цивільні справи в Каліфорнії (SC-100 — SC-140, досудові претензії, утримання із зарплати, abstract of judgment).</li>
      <li>Документи щодо виселення в Каліфорнії для орендодавців і орендарів (UD-100/105/110, триденні повідомлення, пакети default).</li>
      <li>Спадкові справи в Каліфорнії (DE-111/121/160/221/295, small estate affidavits, опис, розподіл, закриття справи).</li>
      <li>Зняття судимості в Каліфорнії: пакети petition for dismissal (CR-180/181), зокрема щодо DUI, за вашим дорученням.</li>
      <li>Документи для бізнесу в Каліфорнії (LLC-1, LLC-12, ARTS-GS, FBN, EIN).</li>
      <li>Засвідчений переклад документів (російська, українська, іспанська ↔ англійська) і допомога з апостилем.</li>
    </ul>
    <p>
      <strong>Чого ми не робимо — так задумано й так вимагає закон:</strong>
      ми не надаємо юридичних консультацій, не представляємо вас у суді,
      в USCIS чи EOIR, не підписуємо процесуальних документів, не ведемо
      переговорів з іншою стороною й не обираємо за вас форму. Якщо вашій
      ситуації потрібен адвокат (судовий спір, стратегія, виступи в суді),
      ми скажемо це під час першого дзвінка й підкажемо, де знайти
      ліцензованого адвоката.
    </p>

    <h2 id="compliance">Реєстрація та захист споживачів</h2>
    <p>
      Каліфорнія вимагає від помічників з юридичних документів
      реєструватися в клерка округу, вносити гарантійну заставу (bond)
      $25,000, проходити навчання й подовжувати реєстрацію — так споживач
      знає, хто готує його документи. Наша реєстрація:
      LDA Reg. No. 2026-010, Sacramento County, expires 09/27/2028,
      Imverica LLC (округ Сакраменто, діє до 27.09.2028). Застава
      імміграційного консультанта № 67347671, Western Surety Company,
      зберігається в Державного секретаря Каліфорнії. Ці дані вказані
      і в кожному договорі.
    </p>
    <p>
      З формами USCIS ми працюємо лише як укладач документів за вашим дорученням: ніколи не виступаємо вашим представником перед USCIS і на кожному кроці повідомляємо, що ми не адвокати й не акредитовані представники. Справам в імміграційному суді (EOIR) потрібен ліцензований адвокат або акредитований представник (DOJ-accredited representative); у них ми працюємо лише як paralegal під керівництвом адвоката.
    </p>

    <h2 id="contact">Як з нами зв'язатися</h2>
    <p>Зателефонуйте, напишіть або почніть онлайн. Відповідаємо того ж робочого дня, вашою мовою.</p>
    <ul class="contact-list">
      <li><strong>Телефон і SMS:</strong> <a href="tel:+19163993992">+1 (916) 399-3992</a></li>
      <li><strong>Email:</strong> <a href="mailto:info@imverica.com">info@imverica.com</a></li>
      <li><strong>Telegram:</strong> <a href="https://t.me/imverica" target="_blank" rel="noopener">t.me/imverica</a></li>
      <li><strong>Онлайн-анкета:</strong> <a href="/ua/#get-started">Почати тут</a>: п'ять хвилин, можна додати до п'яти документів.</li>
      <li><strong>Особистий кабінет:</strong> <a href="/account.html">imverica.com/account</a>: статус справ, обмін документами, повідомлення.</li>
    </ul>
    <p>
      Офіс у Сакраменто, Каліфорнія. Справи в судах Каліфорнії — по всьому
      штату; форми USCIS — для клієнтів по всіх США.
    </p>

    <cite>
      <strong>Важливе повідомлення.</strong> Imverica Legal Solutions —
      торговельне найменування <strong>Imverica LLC</strong>, товариства з
      обмеженою відповідальністю штату Каліфорнія. Це зареєстрований у
      Каліфорнії Legal Document Assistant та Immigration Consultant, а не
      юридична фірма. Ми не надаємо юридичних консультацій, не встановлюємо
      відносин «адвокат — клієнт» і не представляємо клієнтів у суді, в USCIS
      чи EOIR. Уся робота виконується за дорученням сторони, яка представляє
      себе самостійно, відповідно до Cal. Bus. &amp; Prof. Code §§6400–6415
      та §§22440–22448.
    </cite>
  </LandingBody>

  <CategoryTiles
    kicker="Куди далі"
    heading="Оберіть напрямок"
    intro="Якщо вже знаєте, що вам потрібно — переходьте прямо туди:"
    tiles={[
      { icon: '🛂', title: 'Форми USCIS', desc: 'I-485, I-130, I-765, N-400, I-589: будь-який штат США.', href: '/ua/immigration', color: 'var(--navy)' },
      { icon: '👨‍👩‍👧', title: 'Сімейне право CA',    desc: 'Розлучення, опіка, аліменти, post-judgment modifications.', href: '/ua/fl', color: 'var(--terracotta)' },
      { icon: '📃', title: 'Малі позови та civil',  desc: 'SC-100, demand letters, стягнення за рішенням.', href: '/ua/sc', color: 'var(--sage)' },
      { icon: '🏠', title: 'Виселення',             desc: 'UD-100, three-day notices, default-пакети.', href: '/ua/california-unlawful-detainer', color: 'var(--gold)' },
      { icon: '🏛️', title: 'Спадкові справи',       desc: 'Серія DE-111, small estate affidavits, final distribution, DE-295 discharge.', href: '/ua/california-probate', color: 'var(--navy-light)' },
      { icon: '🧾', title: 'Record cleanup',        desc: 'CR-180/181 expungement / petition-for-dismissal packets, включно з DUI.', href: '/ua/california-expungement', color: 'var(--gold)' },
      { icon: '🏢', title: 'Реєстрація бізнесу',    desc: 'LLC-1, ARTS-GS, FBN/DBA, EIN, foreign-LLC.', href: '/ua/business', color: 'var(--terracotta-deep)' },
      { icon: '🤝', title: 'Для адвокатів',         desc: 'Незалежний paralegal — USCIS по всіх США, суди CA.', href: '/ua/for-attorneys', color: 'var(--terracotta)' },
      { icon: '📚', title: 'Що таке LDA?',          desc: 'Cal. Bus. & Prof. Code §§6400–6415 простими словами.', href: '/ua/lda', color: 'var(--navy)' }
    ]}
  />

  <QuickFacts lang="uk" />

  <CTAStrip lang="uk"
    heading="Готові — коли ви готові."
    sub="Відповідь у той самий день. Документи за 48 годин. Чотири мови. Доступні, прозорі тарифи."
    primaryHref="/ua/#get-started"
    primaryText="Почати кейс"
  />

  <style>
    /* links inside running lists must not rely on colour alone */
    ul:not(.contact-list) li a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .contact-list {
      list-style: none;
      padding-left: 0;
      margin: 18px 0;
    }
    .contact-list li {
      padding: 10px 14px;
      margin-bottom: 8px;
      background: rgba(26,46,74,0.04);
      border-left: 3px solid var(--navy);
      border-radius: 0 6px 6px 0;
      font-size: 15px;
      line-height: 1.6;
    }
    .contact-list a {
      color: var(--navy);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .contact-list a:hover {
      color: var(--terracotta-deep);
    }
  </style>
</BaseLayout>
