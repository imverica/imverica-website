---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CategoryTiles from '~/components/CategoryTiles.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import EoirNotice from '~/components/EoirNotice.astro';

const lang = 'uk' as const;
const title = 'EOIR — імміграційний суд: допомога paralegal для адвокатів | Imverica';
const description = 'Імміграційні суди та Board of Immigration Appeals розглядають справи про депортацію (removal). Консультувати й представляти вас там може лише ліцензований адвокат або DOJ-accredited representative. У справах EOIR ми працюємо лише як paralegal під керівництвом адвоката.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'EOIR Immigration Court — paralegal support for attorneys',
  provider: { '@type': 'LegalService', name: 'Imverica Legal Solutions', url: 'https://imverica.com', telephone: '+1-916-399-3992' },
  description: 'Paralegal support for attorneys on immigration court (EOIR) filings, at the attorney’s direction. Not legal advice or representation; Imverica does not prepare immigration court filings for individuals.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ua/eoir-immigration-court"
  slug="/eoir-immigration-court" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[schema]}>
  <Hero
    lang={lang}
    eyebrow="EOIR · Immigration Court · 8 C.F.R. §1003"
    heading="EOIR — імміграційний суд: допомога paralegal для адвокатів"
    sub="Імміграційні суди та Board of Immigration Appeals розглядають справи про депортацію (removal). Консультувати й представляти вас там може лише ліцензований адвокат або DOJ-accredited representative. У справах EOIR ми працюємо лише як paralegal під керівництвом адвоката."
    ctaPrimary={{ href: '/ua/for-attorneys', text: 'Для адвокатів: допомога paralegal' }}
    ctaSecondary={{ href: 'https://www.justice.gov/eoir/list-pro-bono-legal-service-providers', text: 'Безкоштовна юридична допомога' }}
  />

  <CategoryTiles
    kicker="Для адвокатів"
    heading="Де ми допомагаємо адвокатам у справах EOIR"
    intro="Лише за вказівкою адвоката. Натисніть плитку, щоб прочитати про кожну подачу."
    tiles={[
      { icon: '⚖️', title: 'EOIR-42A — Cancellation (LPR)',     desc: 'Заява на cancellation of removal для певних постійних резидентів.',                  href: '/ua/eoir-42a-cancellation-lpr', color: 'var(--terracotta-deep)' },
      { icon: '⚖️', title: 'EOIR-42B — Cancellation (non-LPR)', desc: 'Заява на cancellation of removal та adjustment для певних не-резидентів.',            href: '/ua/eoir-42b-cancellation-non-lpr', color: 'var(--navy)' },
      { icon: '🏛️', title: 'I-589 — Притулок у суді',           desc: 'Defensive asylum і withholding, подані в межах провадження.',                        href: '/ua/i-589-asylum-help',         color: 'var(--sage)' },
      { icon: '🔄', title: 'Motions to reopen | reconsider',     desc: 'Пакети motion із підтверджуючими доказами та чіткою процедурною історією.',          href: '/ua/for-attorneys', color: 'var(--gold)' },
      { icon: '📑', title: 'Evidence packets та indexes',        desc: 'Організовані exhibits, tabs, indexes, декларації та country-conditions evidence.',    href: '/ua/for-attorneys', color: 'var(--navy-light)' },
      { icon: '📨', title: 'EOIR-29 — Апеляція до BIA',          desc: 'Пакет notice of appeal до Board of Immigration Appeals.',                            href: '/ua/eoir-29-notice-of-appeal',  color: 'var(--terracotta)' }
    ]}
  />

  <LandingBody related={[
    { href: '/ua/i-589-asylum-help', label: 'I-589 — Притулок і Withholding' },
    { href: '/ua/immigration', label: 'Усі документи USCIS та EOIR, які ми готуємо' },
    { href: '/ua/lda', label: 'Хто такий California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      Executive Office for Immigration Review (EOIR) керує імміграційними
      судами та Board of Immigration Appeals (BIA), де вирішуються справи про
      removal (депортацію). Справи йдуть за суворими строками й вимагають добре
      організованих письмових подач — заяв на relief, підтверджуючих доказів і
      motions — що подаються до суду.
    </p>

    <h2>Для адвокатів: що ми готуємо за вашою вказівкою</h2>
    <p>Лише за вказівкою адвоката у справі (attorney of record) — адвокат перевіряє, підписує й подає. Для приватних осіб документи до імміграційного суду ми не готуємо.</p>
    <ul>
      <li><strong>Заяви на relief</strong> на кшталт EOIR-42A та EOIR-42B (cancellation of removal) і форму I-589 (asylum/withholding), зібрані з необхідними доказами.</li>
      <li><strong>Motions</strong> to reopen або reconsider перед immigration judge чи BIA, з організованою процедурною історією та exhibits.</li>
      <li><strong>Evidence packets</strong> — індексовані exhibits, tabs, декларації свідків та country-conditions документація.</li>
      <li><strong>Пакети апеляції</strong> до BIA (EOIR-29) та підтверджуючий record.</li>
      <li><strong>Завірені переклади</strong> доказів іноземною мовою.</li>
    </ul>

    <EoirNotice lang="uk" />

    <cite>
      <strong>Джерело:</strong> 8 C.F.R. Part 1003 (організація та процедура
      EOIR); INA §240 (removal proceedings); 8 C.F.R. §1003.23 (motions перед
      immigration judge) і §1003.2 (motions перед BIA); 8 C.F.R. Part 1292
      (представництво та accredited representatives). Лише допомога адвокатам як paralegal — не юридичні консультації і не представництво.
    </cite>
  </LandingBody>

  <CTAStrip lang="uk" heading="Ви адвокат і ведете справу в EOIR?" sub="Готуємо чернетки, індекси додатків і засвідчені переклади за вашою вказівкою — на вашу перевірку й підпис." primaryHref="/ua/for-attorneys" primaryText="Для адвокатів: допомога paralegal" />
</BaseLayout>
