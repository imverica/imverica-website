---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'uk' as const;
const title = 'Перевірка документів USCIS перед поданням | Imverica';
const description =
  'Заповнили форми USCIS самостійно? Перевіримо пакет перед поданням: повнота відповідей, узгодженість форм, актуальні редакції, підписи, чек-лист додатків. Дистанційно по всій території США, українською.';

const faqs: FaqItem[] = [
  {
    q: 'Що таке перевірка документів USCIS?',
    a: 'Ви готуєте заяву самостійно, а ми переглядаємо готовий пакет до подання: пропущені відповіді, розбіжності між формами, застарілі редакції, відсутні підписи та прогалини в додатках. Ви отримуєте письмовий список зауважень для виправлення.'
  },
  {
    q: 'Це те саме, що юридична консультація?',
    a: 'Ні. Перевірка технічна, а не юридична: повнота, узгодженість та оформлення за вимогами USCIS. Ми не оцінюємо ваше право на статус, не прогнозуємо результат і не обираємо стратегію — з таких питань направляємо до ліцензованих імміграційних адвокатів.'
  },
  {
    q: 'Які заяви ви перевіряєте?',
    a: 'Будь-які пакети USCIS, які ми також готуємо: запити U4U re-parole, дозволи на роботу I-765, travel-документи I-131, TPS (I-821), грін-карту I-485, сімейні петиції I-130, громадянство N-400, продовження грін-карти I-90 та комплекти доказів.'
  },
  {
    q: 'Скільки триває перевірка?',
    a: 'Перевірка однієї форми зазвичай повертається за 1–2 робочі дні. Пакети з кількох форм (наприклад, I-485 + I-765 + I-131) — за 2–3 робочі дні.'
  },
  {
    q: 'Скільки коштує перевірка документів?',
    a: 'Фіксований кошторис називається після того, як ми бачимо обсяг пакета: одна форма з додатками коштує менше за повний комплект на грін-карту. Опубліковані тарифи на підготовку — на imverica.com/pricing; перевірка коштує менше за відповідну підготовку.'
  },
  {
    q: 'Чи можна спілкуватися і надсилати документи українською?',
    a: 'Так. Анкета та листування доступні українською, російською, англійською та іспанською, а за потреби ми робимо сертифіковані переклади свідоцтв і довідок для пакета.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'USCIS Document Review (Ukrainian-speaking)',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'Country', name: 'United States' },
  availableLanguage: ['uk', 'ru', 'en', 'es'],
  description: 'Перевірка самостійно підготовлених пакетів USCIS перед поданням: повнота, узгодженість, актуальні редакції форм, підписи, чек-лист додатків. Лише перевірка документів — не юридична консультація.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ua/uscis-document-review"
  slug="/uscis-document-review" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema(faqs)]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Перевірка перед поданням · UA | RU | EN | ES"
    heading="Перевірка документів USCIS перед поданням"
    sub="Ви заповнили форми самі — ми перевіримо пакет до відправлення в USCIS. Повнота, узгодженість, актуальні редакції, підписи та чек-лист додатків. Дистанційно, фіксований кошторис, зауваження письмово та українською."
    ctaPrimary={{ href: '/#get-started?topic=REVIEW', text: 'Замовити перевірку документів' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/ua/u4u', label: 'U4U re-parole — підготовка документів' },
    { href: '/ua/tps', label: 'TPS — тимчасовий захищений статус' },
    { href: '/pricing', label: 'Опубліковані тарифи' },
    { href: '/ua/lda', label: 'Хто такий Legal Document Assistant у Каліфорнії' }
  ]}>
    <p class="lead">
      Відмови та затримки USCIS найчастіше трапляються через механіку:
      пропущене питання, застаріла редакція форми, підпис не в тому місці або
      додатки, що не збігаються з відповідями у формі. Перевірка документів —
      це друга пара професійних очей на вашому пакеті, поки на кону ще не
      стоять збір і місяці очікування.
    </p>

    <h2>Кому це підходить</h2>
    <ul>
      <li>Ви самостійно підготували пакет U4U re-parole, TPS, дозволу на роботу, грін-карти чи на громадянство і хочете перевірити його перед поданням.</li>
      <li>Ви заповнювали форми за шаблоном або через перекладач і не впевнені, що кожна відповідь потрапила туди, куди очікує USCIS.</li>
      <li>Попереднє подання повернули через пропущений підпис, не ту редакцію чи неповну відповідь — повторення не хочеться.</li>
      <li>Потрібна професійна перевірка, але повна підготовка «з нуля» не потрібна.</li>
    </ul>

    <h2>Що ми перевіряємо</h2>
    <ul>
      <li><strong>Повнота</strong> — відповідено на кожен обов'язковий пункт; там, де USCIS вимагає «None»/«N/A», не залишено порожніх полів.</li>
      <li><strong>Узгодженість</strong> — імена, дати, адреси та A-numbers збігаються в усіх формах пакета і в додатках.</li>
      <li><strong>Редакція форми</strong> — дата редакції кожної форми та, яку USCIS приймає зараз.</li>
      <li><strong>Підписи та дати</strong> — підписано все, що має бути підписано, і не підписано те, що має залишитися порожнім.</li>
      <li><strong>Додатки</strong> — чек-лист: що в пакеті є і що зазвичай вимагається для вашого типу подання, включно з сертифікованими перекладами.</li>
      <li><strong>Збори та адреса</strong> — правильний збір (або звільнення, як I-765 (c)(11) для U4U) та актуальна адреса подання USCIS.</li>
    </ul>

    <h2>Які документи зазвичай перевіряємо</h2>
    <p>
      Запити U4U re-parole, заяви I-765 на дозвіл на роботу, travel-документи
      I-131, реєстрації та перереєстрації TPS (I-821), комплекти I-485 на
      грін-карту, сімейні петиції I-130, заяви N-400 на громадянство,
      продовження грін-карти I-90 — та доказову базу до них: свідоцтва,
      переклади, статусні документи, фотографії.
    </p>

    <h2>Як проходить перевірка</h2>
    <ul>
      <li><strong>1. Завантаження.</strong> Надішліть заповнені форми та додатки через захищений особистий кабінет — файли шифруються під час зберігання.</li>
      <li><strong>2. Фіксований кошторис.</strong> Ми підтверджуємо обсяг пакета і називаємо фіксовану ціну до початку роботи.</li>
      <li><strong>3. Перевірка.</strong> Фахівець із підготовки документів проходить кожну сторінку за актуальними вимогами USCIS.</li>
      <li><strong>4. Письмові зауваження.</strong> Ви отримуєте список: що виправити, чого бракує і що готово — українською.</li>
    </ul>

    <cite>
      Imverica Legal Solutions — зареєстрований у Каліфорнії Legal Document
      Assistant та Immigration Consultant, не адвокатська фірма. Перевірка
      документів — це контроль повноти та узгодженості, а не юридична
      консультація, оцінка права на статус чи прогноз результату. Якщо справі
      потрібна юридична стратегія — зверніться до ліцензованого імміграційного
      адвоката.
    </cite>
  </LandingBody>

  <FaqBlock heading="Часті запитання" items={faqs} />

  <CTAStrip lang={lang} primaryHref="/#get-started?topic=REVIEW" primaryText="Замовити перевірку документів" />
</BaseLayout>
