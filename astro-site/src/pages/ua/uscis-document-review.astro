---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const lang = 'uk' as const;
const title = 'Технічна перевірка повноти пакета USCIS у Каліфорнії | Imverica';
const description =
  'Технічна перевірка самостійно підготовленого пакета USCIS для клієнтів у Каліфорнії: порожні поля, внутрішня узгодженість, редакції, підписи та обраний клієнтом офіційний чек-лист.';

const faqs: FaqItem[] = [
  {
    q: 'Що таке перевірка документів USCIS?',
    a: 'Ви самі обираєте й готуєте форми та офіційний чек-лист. Ми позначаємо порожні поля, внутрішні розбіжності, застарілі редакції й відсутні підписи та порівнюємо матеріали з обраним вами чек-листом. Ви отримуєте письмові технічні зауваження.'
  },
  {
    q: 'Це те саме, що юридична консультація?',
    a: 'Ні. Перевірка технічна, а не юридична. Ми не оцінюємо eligibility, не обираємо форму, докази, категорію збору чи адресу подання, не тлумачимо відповіді, не прогнозуємо результат і не обираємо стратегію.'
  },
  {
    q: 'Які готові пакети можна перевірити?',
    a: 'Клієнт у Каліфорнії, який представляє себе самостійно, може замовити технічну перевірку вже заповненого й обраного ним пакета USCIS. Клієнт заздалегідь визначає форми, категорію, офіційний чек-лист і документи.'
  },
  {
    q: 'Скільки триває технічна перевірка?',
    a: 'Imverica письмово підтверджує орієнтовний строк після отримання повного пакета й погодження обсягу. Строк розгляду USCIS не контролюється й не обіцяється Imverica.'
  },
  {
    q: 'Скільки коштує перевірка документів?',
    a: 'Фіксований кошторис письмово підтверджується після отримання готового пакета й погодження технічного обсягу. Робота починається лише після вашого схвалення.'
  },
  {
    q: 'Чи можна спілкуватися і надсилати документи українською?',
    a: 'Так. Анкета та листування доступні українською, російською, англійською та іспанською. Сертифікований переклад обраних клієнтом документів — окрема послуга за запитом клієнта.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Технічна перевірка повноти пакета USCIS за дорученням клієнта',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  availableLanguage: ['uk', 'ru', 'en', 'es'],
  description: 'Технічна перевірка самостійно підготовленого пакета USCIS для клієнтів у Каліфорнії: порожні поля, внутрішня узгодженість, актуальні редакції, підписи та обраний клієнтом офіційний чек-лист. Без юридичних консультацій і вибору форм, доказів, категорії чи адреси.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ua/uscis-document-review"
  slug="/uscis-document-review" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema(faqs)]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Перевірка перед поданням · UA | RU | EN | ES"
    heading="Технічна перевірка повноти пакета USCIS"
    sub="Для клієнтів у Каліфорнії, які представляють себе самостійно й уже обрали та заповнили форми. Ми позначаємо порожні поля, внутрішні розбіжності, застарілі редакції й відсутні підписи та звіряємо матеріали з обраним вами офіційним чек-листом."
    ctaPrimary={{ href: '/#get-started?topic=REVIEW', text: 'Замовити технічну перевірку' }}
  />

  <LandingBody lang={lang} related={[
    { href: '/ua/u4u', label: 'U4U re-parole — підготовка документів' },
    { href: '/ua/tps', label: 'TPS — тимчасовий захищений статус' },
    { href: '/pricing', label: 'Опубліковані тарифи' },
    { href: '/ua/lda', label: 'Хто такий Legal Document Assistant у Каліфорнії' }
  ]}>
    <p class="lead">
      Це технічна перевірка самостійно підготовленого пакета за дорученням
      клієнта. Ви обираєте форму, категорію, офіційний чек-лист і документи.
      Imverica позначає видимі технічні питання; ми не вирішуємо, що подавати
      та чи є пакет юридично достатнім.
    </p>

    <h2>Кому це підходить</h2>
    <ul>
      <li>Ви клієнт у Каліфорнії, який представляє себе самостійно й уже обрав і заповнив пакет USCIS.</li>
      <li>Ви заповнювали форми за шаблоном або через перекладач і не впевнені, що кожна відповідь потрапила туди, куди очікує USCIS.</li>
      <li>Попереднє подання повернули через пропущений підпис, не ту редакцію чи неповну відповідь — повторення не хочеться.</li>
      <li>Потрібна професійна перевірка, але повна підготовка «з нуля» не потрібна.</li>
    </ul>

    <h2>Що ми перевіряємо</h2>
    <ul>
      <li><strong>Порожні поля</strong> — видимі порожні поля перелічуються, щоб ви звірилися з обраною офіційною інструкцією.</li>
      <li><strong>Внутрішня узгодженість</strong> — імена, дати, адреси та A-numbers порівнюються між наданими формами й підписами.</li>
      <li><strong>Редакція форми</strong> — дата редакції кожної форми та, яку USCIS приймає зараз.</li>
      <li><strong>Підписи та дати</strong> — видимі непідписані або недатовані поля позначаються для вашої перевірки.</li>
      <li><strong>Обраний клієнтом чек-лист</strong> — надані документи порівнюються з указаним вами офіційним чек-листом USCIS; Imverica не обирає докази й не визначає їх достатність.</li>
      <li><strong>Офіційні посилання</strong> — ми можемо надати посилання на актуальні сторінки зборів та адрес USCIS, але категорію, порядок оплати й адресу обираєте ви.</li>
    </ul>

    <h2>Які документи зазвичай перевіряємо</h2>
    <p>
      Запити U4U re-parole, заяви I-765 на дозвіл на роботу, travel-документи
      I-131, реєстрації та перереєстрації TPS (I-821), комплекти I-485 на
      грін-карту, сімейні петиції I-130, заяви N-400 на громадянство,
      продовження грін-карти I-90 — коли клієнт у Каліфорнії вже обрав форми,
      категорію, офіційний чек-лист і документи.
    </p>

    <h2>Як проходить перевірка</h2>
    <ul>
      <li><strong>1. Завантаження.</strong> Надішліть заповнені форми та додатки через захищений особистий кабінет — файли шифруються під час зберігання.</li>
      <li><strong>2. Фіксований кошторис.</strong> Ми підтверджуємо обсяг пакета і називаємо фіксовану ціну до початку роботи.</li>
      <li><strong>3. Технічна перевірка.</strong> Фахівець порівнює пакет з актуальною редакцією форми та обраним вами офіційним чек-листом.</li>
      <li><strong>4. Письмові зауваження.</strong> Ви отримуєте список технічних позначок і офіційних посилань — українською. Рішення про зміни приймаєте ви.</li>
    </ul>

    <cite>
      Imverica Legal Solutions — зареєстрований у Каліфорнії Legal Document
      Assistant та Immigration Consultant, не адвокатська фірма. Перевірка
      документів — це технічний контроль, а не юридична консультація, вибір
      форми, категорії чи доказів, оцінка eligibility або прогноз результату.
      Якщо ви не впевнені, що подавати, зверніться до ліцензованого
      імміграційного адвоката чи DOJ-accredited representative.
    </cite>
  </LandingBody>

  <FaqBlock heading="Часті запитання" items={faqs} />

  <CTAStrip lang={lang} primaryHref="/#get-started?topic=REVIEW" primaryText="Замовити технічну перевірку" />
</BaseLayout>
