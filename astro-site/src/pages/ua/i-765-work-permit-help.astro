---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import SampleForm from '~/components/SampleForm.astro';
import CTAStrip from '~/components/CTAStrip.astro';

const lang = 'uk' as const;
const title = 'Підготовка документів I-765 — дозвіл на роботу (EAD) | Imverica';
const description = 'California Registered LDA готує форму I-765 за вказівкою клієнта. Категорію eligibility обирає клієнт або ліцензований адвокат. Підготовка документів без юридичних консультацій.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'I-765 Employment Authorization Document Preparation',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  description: 'Підготовка документів за формою I-765 (Application for Employment Authorization) за дорученням заявника.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/ua/i-765-work-permit-help"
  slug="/i-765-work-permit-help" lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[schema]}>
  <Hero
    lang={lang}
    eyebrow="USCIS · Employment Authorization · 8 CFR §274a.12"
    heading="I-765 — Application for Employment Authorization"
    sub="Готуємо форму I-765 з категорією eligibility та відомостями, які ви надали. Категорію обираєте ви або ліцензований адвокат. Підготовка документів за вашою вказівкою — не юридична консультація."
    ctaPrimary={{ href: '/#get-started?form=I-765', text: 'Почати пакет I-765' }}
  />

  <LandingBody related={[
    { href: '/ua/i-485-help', label: 'I-485 — Adjustment of status (concurrent I-765 c)(9))' },
    { href: '/ua/i-589-asylum-help', label: 'I-589 — Pending asylum і строки подання I-765 за категорією (c)(8)' },
    { href: '/ua/lda', label: 'Хто такий California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      Форма I-765 — це заява на Employment Authorization Document (EAD),
      фізичну картку, яка потрібна не-громадянину, аби підтвердити право
      на роботу в США. Ми готуємо I-765 за вказівкою заявника, використовуючи
      категорію eligibility, яку обрав заявник або ліцензований адвокат.
      Imverica не визначає відповідну категорію та не надає юридичних
      консультацій.
    </p>

    <h2>Приклади кодів категорій eligibility</h2>
    <p>
      USCIS використовує коди категорій, включно з наведеними нижче. Це
      загальна інформація, а не визначення права на подання. Категорії,
      докази, збори та правила подання можуть змінюватися. Перед поданням
      перевірте актуальну сторінку та інструкції Form I-765 на сайті USCIS.
      Якщо ви не впевнені, яка категорія підходить, зверніться до
      ліцензованого імміграційного адвоката.
    </p>
    <ul>
      <li><strong>(c)(8)</strong> — Деякі заявники з pending asylum application.</li>
      <li><strong>(c)(9)</strong> — Деякі заявники з pending Form I-485.</li>
      <li><strong>(a)(12)</strong> / <strong>(c)(19)</strong> — Деякі заявники або отримувачі Temporary Protected Status.</li>
      <li><strong>(c)(33)</strong> — Деякі заявники DACA.</li>
      <li><strong>(c)(11)</strong> — Деякі особи з parole.</li>
      <li><strong>(a)(18)</strong> — Деякі особи в шлюбі з власниками статусу L-1.</li>
      <li><strong>(c)(26)</strong> — Деякі особи в шлюбі з власниками статусу H-1B, які мають статус H-4.</li>
      <li><strong>(c)(14)</strong> — Деякі особи, яким надано deferred action.</li>
    </ul>

    <h2>Що нам потрібно від вас для I-765</h2>
    <ul>
      <li>Біографічні дані (юридичне ім'я, попередні імена, DOB, країна народження, країна громадянства)</li>
      <li>SSN, якщо раніше видавався, або запит картки SSA через саму I-765</li>
      <li>Поточні та попередні адреси в США</li>
      <li>Останній I-94 або admission record; біографічна сторінка паспорта; будь-яка попередня EAD</li>
      <li>Докази категорії eligibility (квитанція pending I-589 для (c)(8), pending I-485 для (c)(9), TPS registration для (a)(12) тощо)</li>
      <li>Дві passport-style фотографії (ми надаємо специфікацію)</li>
    </ul>

    <h2>Filing fee та fee waiver</h2>
    <p>
      Розмір filing fee для I-765 та можливість просити fee waiver залежать
      від категорії подання, основного benefit request і чинних правил USCIS.
      Форму I-912 не можна використовувати з кожною формою або категорією.
      Перед поданням перевірте актуальні сторінки та інструкції USCIS для
      I-765 та I-912. Imverica готує I-912 лише за вказівкою клієнта або
      ліцензованого адвоката; ми не визначаємо право на fee waiver і не
      обіцяємо його схвалення USCIS.
    </p>

    <p><strong>Перевірено:</strong> 18 жовтня 2026 року.</p>

    <h2>Офіційні ресурси USCIS</h2>
    <ul>
      <li><a href="https://www.uscis.gov/i-765" target="_blank" rel="noopener noreferrer">Сторінка Form I-765 та актуальні інструкції</a></li>
      <li><a href="https://www.uscis.gov/i-912" target="_blank" rel="noopener noreferrer">Сторінка Form I-912 про fee waiver та актуальні інструкції</a></li>
    </ul>

    <cite>
      <strong>Джерело:</strong> Immigration and Nationality Act §274A
      (employment authorization); 8 C.F.R. §274a.12 (категорії
      іноземців, які мають право працювати); 8 C.F.R. §274a.13 (заява);
      USCIS Policy Manual Volume 10 (Employment Authorization).
    </cite>
  </LandingBody>

  <SampleForm form="i-765" lang="uk" />

  <CTAStrip lang="uk"
    heading="Розпочніть заявку I-765 на дозвіл на роботу"
    sub="Багатомовна анкета. Можна зберегти і продовжити. Фіксована ціна. Підготовка документів за вашим дорученням — без юридичних консультацій."
    primaryHref="/#get-started?form=I-765"
    primaryText="Почати анкету I-765"
  />
</BaseLayout>
