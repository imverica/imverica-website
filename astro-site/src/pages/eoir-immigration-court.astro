---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import CategoryTiles from '~/components/CategoryTiles.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import EoirNotice from '~/components/EoirNotice.astro';

const title = 'EOIR — immigration court: paralegal support for attorneys | Imverica';
const description = 'The immigration courts and the Board of Immigration Appeals decide removal (deportation) cases. Only a licensed attorney or a DOJ-accredited representative can advise or represent you there. We work on EOIR cases only as a paralegal under an attorney’s direction.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'EOIR Immigration Court — paralegal support for attorneys',
  provider: { '@type': 'LegalService', name: 'Imverica Legal Solutions', url: 'https://imverica.com', telephone: '+1-916-399-3992' },
  description: 'Paralegal support for attorneys on immigration court (EOIR) filings, at the attorney’s direction. Not legal advice or representation; Imverica does not prepare immigration court filings for individuals.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/eoir-immigration-court"
  slug="/eoir-immigration-court" availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[schema]}>
  <Hero
    eyebrow="EOIR · Immigration Court · 8 C.F.R. §1003"
    heading="EOIR — immigration court: paralegal support for attorneys"
    sub="The immigration courts and the Board of Immigration Appeals decide removal (deportation) cases. Only a licensed attorney or a DOJ-accredited representative can advise or represent you there. We work on EOIR cases only as a paralegal under an attorney’s direction."
    ctaPrimary={{ href: '/for-attorneys', text: 'Paralegal support for attorneys' }}
    ctaSecondary={{ href: 'https://www.justice.gov/eoir/list-pro-bono-legal-service-providers', text: 'Find free legal help' }}
  />

  <CategoryTiles
    kicker="For attorneys"
    heading="Where we support attorneys in EOIR cases"
    intro="Only at the attorney’s direction. Tap a tile to read about each filing."
    tiles={[
      { icon: '⚖️', title: 'EOIR-42A — Cancellation (LPR)',     desc: 'Application for cancellation of removal for certain permanent residents.',          href: '/eoir-42a-cancellation-lpr', color: 'var(--terracotta-deep)' },
      { icon: '⚖️', title: 'EOIR-42B — Cancellation (non-LPR)', desc: 'Application for cancellation of removal and adjustment for certain non-residents.',   href: '/eoir-42b-cancellation-non-lpr', color: 'var(--navy)' },
      { icon: '🏛️', title: 'I-589 — Asylum in court',            desc: 'Defensive asylum and withholding application filed in proceedings.',                href: '/i-589-asylum-help',           color: 'var(--sage)' },
      { icon: '🔄', title: 'Motions to reopen | reconsider',     desc: 'Motion packets with supporting evidence and a clear procedural history.',            href: '/for-attorneys', color: 'var(--gold)' },
      { icon: '📑', title: 'Evidence packets & indexes',         desc: 'Organized exhibits, tabs, indexes, declarations, and country-conditions evidence.',  href: '/for-attorneys', color: 'var(--navy-light)' },
      { icon: '📨', title: 'EOIR-29 — Appeal to the BIA',        desc: 'Notice of appeal packet to the Board of Immigration Appeals.',                       href: '/eoir-29-notice-of-appeal',  color: 'var(--terracotta)' }
    ]}
  />

  <LandingBody related={[
    { href: '/i-589-asylum-help', label: 'I-589 — Asylum & Withholding' },
    { href: '/immigration', label: 'USCIS forms we prepare' },
    { href: '/lda', label: 'What is a California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      The Executive Office for Immigration Review (EOIR) runs the immigration
      courts and the Board of Immigration Appeals (BIA), where removal
      (deportation) cases are decided. Cases move on strict deadlines and
      require well-organized written filings — applications for relief,
      supporting evidence, and motions — submitted to the court.
    </p>

    <h2>For attorneys: what we prepare at your direction</h2>
    <p>Only at the direction of the attorney of record, for the attorney’s review, signature and filing. We do not prepare immigration court filings for individuals.</p>
    <ul>
      <li><strong>Applications for relief</strong> such as EOIR-42A and EOIR-42B (cancellation of removal) and Form I-589 (asylum/withholding), assembled with the required supporting evidence.</li>
      <li><strong>Motions</strong> to reopen or reconsider before the immigration judge or the BIA, with the procedural history and exhibits organized.</li>
      <li><strong>Evidence packets</strong> — indexed exhibits, tabs, witness declarations, and country-conditions documentation.</li>
      <li><strong>Appeal packets</strong> to the BIA (EOIR-29) and the supporting record.</li>
      <li><strong>Certified translations</strong> of foreign-language evidence.</li>
    </ul>

    <EoirNotice lang="en" />

    <cite>
      <strong>Authority:</strong> 8 C.F.R. Part 1003 (EOIR organization and
      procedure); INA §240 (removal proceedings); 8 C.F.R. §1003.23 (motions
      before the immigration judge) and §1003.2 (motions before the BIA);
      8 C.F.R. Part 1292 (representation and accredited representatives).
      Paralegal support for attorneys only — not legal advice or representation.
    </cite>
  </LandingBody>

  <CTAStrip heading="Working on an EOIR case as an attorney?" sub="We prepare drafts, exhibit indexes and certified translations at your direction, for your review and signature." primaryHref="/for-attorneys" primaryText="Paralegal support for attorneys" />
</BaseLayout>
