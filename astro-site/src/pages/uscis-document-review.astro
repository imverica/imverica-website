---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';

const title = 'USCIS Clerical Completeness Check for California Clients | Imverica';
const description =
  'Client-directed clerical completeness check for California self-represented clients who prepared their own USCIS forms: blanks, internal consistency, current editions, signatures, and a client-selected official checklist.';

const faqs: FaqItem[] = [
  {
    q: 'What is a USCIS document review?',
    a: 'You prepare and select the USCIS forms and checklist yourself. We flag blank fields, internal inconsistencies, outdated form editions, and missing signatures, and compare the items you supplied with the official checklist you selected. You receive written clerical observations for your review.'
  },
  {
    q: 'Is a document review the same as legal advice?',
    a: 'No. The check is clerical, not legal. We do not assess eligibility, select a form, evidence, fee category, or filing address, interpret an answer, predict outcomes, or recommend legal strategy. Those decisions remain with you or a licensed immigration attorney.'
  },
  {
    q: 'Which completed packages can Imverica check?',
    a: 'California self-represented clients may request a clerical check of a completed, client-selected USCIS package. The client identifies the forms, filing category, official checklist, and documents to include before the work begins.'
  },
  {
    q: 'How long does the clerical check take?',
    a: 'Imverica confirms an estimated schedule in writing after receiving the complete package and requested scope. USCIS processing time is separate and is not controlled or promised by Imverica.'
  },
  {
    q: 'How much does a document review cost?',
    a: 'A flat quote is confirmed in writing after we see the completed package and requested clerical scope. No work begins until you approve the quote.'
  },
  {
    q: 'Can you review documents in Russian or Ukrainian?',
    a: 'Yes. Intake and communication are available in English, Russian, Ukrainian, and Spanish. Certified translations of client-selected documents are a separate service when the client requests them.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Client-directed USCIS clerical completeness check',
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  availableLanguage: ['en', 'ru', 'uk', 'es'],
  description: 'Client-directed clerical completeness check of self-prepared USCIS packages for California self-represented clients: blank fields, internal consistency, current editions, signatures, and a client-selected official checklist. No legal advice or form, evidence, fee-category, or filing-address selection.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/uscis-document-review"
  slug="/uscis-document-review" availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema(faqs)]}>
  <Hero
    eyebrow="USCIS · Pre-filing check · EN | RU | UA | ES"
    heading="USCIS clerical completeness check"
    sub="For California self-represented clients who already selected and completed their forms. We flag blanks, internal inconsistencies, outdated editions, and missing signatures, and compare your items with the official checklist you selected."
    ctaPrimary={{ href: '/#get-started?topic=REVIEW', text: 'Request a clerical check' }}
  />

  <LandingBody related={[
    { href: '/u4u', label: 'U4U re-parole document preparation' },
    { href: '/tps', label: 'TPS — Temporary Protected Status' },
    { href: '/pricing', label: 'Published flat fees' },
    { href: '/lda', label: 'What is a California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      This service is a client-directed clerical check of a self-prepared
      package. You choose the form, filing category, official checklist, and
      documents. Imverica flags visible clerical issues for you to review; it
      does not decide what should be filed or whether the package is legally
      sufficient.
    </p>

    <h2>Who this is for</h2>
    <ul>
      <li>You are a California self-represented client who already selected and completed a USCIS package.</li>
      <li>You used a translation tool or a template and are not sure every answer landed where USCIS expects it.</li>
      <li>Your previous filing was rejected for a missing signature, wrong edition, or incomplete answer and you don't want a repeat.</li>
      <li>You want a professional check but do not need (or want to pay for) full preparation from scratch.</li>
    </ul>

    <h2>What we check</h2>
    <ul>
      <li><strong>Blank fields</strong> — visible blanks are listed for you to resolve using the official instructions you selected.</li>
      <li><strong>Internal consistency</strong> — names, dates, addresses, and A-numbers are compared across the forms and labels you supplied.</li>
      <li><strong>Form edition</strong> — the edition date on each form is the one USCIS currently accepts.</li>
      <li><strong>Signatures and dates</strong> — unsigned or undated visible signature fields are flagged for your review.</li>
      <li><strong>Client-selected checklist</strong> — the documents you supplied are compared with the current official USCIS checklist you identified; Imverica does not choose evidence or decide sufficiency.</li>
      <li><strong>Official links</strong> — we can link you to current USCIS fee and filing-address pages, but you select the filing category, fee treatment, and address.</li>
    </ul>

    <h2>Documents usually reviewed</h2>
    <p>
      U4U re-parole request packages, I-765 work permit applications, I-131
      travel documents, I-821 TPS registrations and re-registrations, I-485
      adjustment-of-status sets, I-130 family petitions, N-400 naturalization
      applications, and I-90 green-card renewals — when the California client
      has already selected the forms, category, checklist, and documents.
    </p>

    <h2>How the process works</h2>
    <ul>
      <li><strong>1. Upload.</strong> Send your completed forms and evidence through the secure client portal — files are encrypted at rest.</li>
      <li><strong>2. Flat quote.</strong> We confirm the package size and quote a flat review fee before any work starts.</li>
      <li><strong>3. Clerical check.</strong> A document preparer compares the package with the current form edition and the official checklist you selected.</li>
      <li><strong>4. Written observations.</strong> You receive an itemized list of clerical flags and official links — in your language. You decide what to change.</li>
    </ul>

    <cite>
      Imverica Legal Solutions is a California-registered Legal Document
      Assistant and Immigration Consultant, not a law firm. This is a clerical
      completeness check, not legal advice, evidence review, form or category
      selection, an eligibility assessment, or a prediction of the outcome.
      If you are unsure what to file, consult a licensed immigration attorney
      or DOJ-accredited representative.
    </cite>
  </LandingBody>

  <FaqBlock heading="Frequently asked questions" items={faqs} />

  <CTAStrip primaryHref="/#get-started?topic=REVIEW" primaryText="Request a clerical check" />
</BaseLayout>
