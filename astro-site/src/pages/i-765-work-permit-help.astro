---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import SampleForm from '~/components/SampleForm.astro';
import CTAStrip from '~/components/CTAStrip.astro';

const title = 'I-765 Work Permit (EAD) Document Preparation | Imverica';
const description = 'California Registered LDA prepares Form I-765 at the client\'s direction. The client or a licensed attorney must identify the eligibility category. Multilingual document preparation; no legal advice.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'I-765 Employment Authorization Document Preparation',
  provider: { '@type': 'LegalService', '@id': 'https://imverica.com/#organization', name: 'Imverica Legal Solutions', url: 'https://imverica.com', telephone: '+1-916-399-3992' },
  areaServed: { '@type': 'State', name: 'California' },
  description: 'Document preparation for Form I-765 Application for Employment Authorization at the applicant direction.'
};
---
<BaseLayout title={title} description={description} canonical="https://imverica.com/i-765-work-permit-help"
  slug="/i-765-work-permit-help" jsonLd={[schema]}>
  <Hero
    eyebrow="USCIS · Employment Authorization · 8 CFR §274a.12"
    heading="I-765 — Application for Employment Authorization"
    sub="We prepare Form I-765 using the eligibility category and information you provide. You or a licensed attorney must choose the category. Document preparation at your direction — not legal advice."
    ctaPrimary={{ href: '/#get-started?form=I-765', text: 'Start my I-765 package' }}
  />

  <LandingBody related={[
    { href: '/i-485-help', label: 'I-485 — Adjustment of status (concurrent I-765 c)(9))' },
    { href: '/i-589-asylum-help', label: 'I-589 — Pending asylum and category (c)(8) EAD timing' },
    { href: '/lda', label: 'What is a California Legal Document Assistant?' }
  ]}>
    <p class="lead">
      Form I-765 is the application for an Employment Authorization
      Document (EAD) — the physical card a noncitizen can use to show
      employment authorization in the United States. We
      prepare the I-765 at the applicant's direction using the eligibility
      category selected by the applicant or a licensed attorney. Imverica
      does not decide which category applies or provide legal advice.
    </p>

    <h2>Examples of eligibility category codes</h2>
    <p>
      USCIS uses category codes such as the examples below. This list is
      general information, not an eligibility determination. Categories,
      evidence requirements, fees, and filing rules can change. Check the
      current Form I-765 page and instructions before filing; if you are
      unsure which category applies, consult a licensed immigration attorney.
    </p>
    <ul>
      <li><strong>(c)(8)</strong> — Certain applicants with a pending asylum application.</li>
      <li><strong>(c)(9)</strong> — Certain applicants with a pending Form I-485.</li>
      <li><strong>(a)(12)</strong> / <strong>(c)(19)</strong> — Certain Temporary Protected Status applicants or beneficiaries.</li>
      <li><strong>(c)(33)</strong> — Certain DACA requestors.</li>
      <li><strong>(c)(11)</strong> — Certain parolees.</li>
      <li><strong>(a)(18)</strong> — Certain spouses of L-1 nonimmigrants.</li>
      <li><strong>(c)(26)</strong> — Certain H-4 spouses.</li>
      <li><strong>(c)(14)</strong> — Certain people granted deferred action.</li>
    </ul>

    <h2>What we need from you for I-765</h2>
    <ul>
      <li>Biographic information (legal name, prior names, DOB, country of birth, country of citizenship)</li>
      <li>SSN if previously issued, or SSA card request via the I-765 itself</li>
      <li>Current and prior U.S. addresses</li>
      <li>Most recent I-94 or admission record; passport biographic page; any prior EAD</li>
      <li>Evidence of the eligibility category (pending I-589 receipt for (c)(8), pending I-485 for (c)(9), TPS registration for (a)(12), etc.)</li>
      <li>Two passport-style photos (we provide the spec)</li>
    </ul>

    <h2>Filing fee and fee waiver</h2>
    <p>
      The I-765 filing fee and fee-waiver availability depend on the filing
      category, the underlying benefit request, and current USCIS rules.
      Form I-912 cannot be used with every form or category. Review the
      current USCIS Form I-765 and Form I-912 pages and instructions before
      filing. Imverica prepares an I-912 only when the client or a licensed
      attorney directs us to include it; we do not determine eligibility for
      a fee waiver or promise that USCIS will grant one.
    </p>

    <p><strong>Last reviewed:</strong> October 18, 2026.</p>

    <h2>Official USCIS resources</h2>
    <ul>
      <li><a href="https://www.uscis.gov/i-765" target="_blank" rel="noopener noreferrer">Form I-765 page and current instructions</a></li>
      <li><a href="https://www.uscis.gov/i-912" target="_blank" rel="noopener noreferrer">Form I-912 fee-waiver page and current instructions</a></li>
    </ul>

    <cite>
      <strong>Statutory authority:</strong> Immigration and Nationality
      Act §274A (employment authorization); 8 C.F.R. §274a.12 (categories
      of aliens authorized to work); 8 C.F.R. §274a.13 (application);
      USCIS Policy Manual Volume 10 (Employment Authorization).
    </cite>
  </LandingBody>

  <SampleForm form="i-765" />

  <CTAStrip
    heading="Start your I-765 work permit application"
    sub="Multilingual intake. Pause and resume. Flat-fee. Document preparation at your direction — not legal advice."
    primaryHref="/#get-started?form=I-765"
    primaryText="Begin my I-765 intake"
  />
</BaseLayout>
