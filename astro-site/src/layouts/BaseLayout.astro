---
import '~/styles/site.css';
import '~/styles/site-v2.css';
import '~/styles/v2-icons.css';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteHeaderV2 from '~/components/SiteHeaderV2.astro';
import V2Flag from '~/components/V2Flag.astro';
import V2Text from '~/components/V2Text.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteFooterV2 from '~/components/SiteFooterV2.astro';
import V2Swap from '~/components/V2Swap.astro';
import IntakeWizard from '~/components/IntakeWizard.astro';
import QuickIntakeModal from '~/components/QuickIntakeModal.astro';
import ChatWidget from '~/components/ChatWidget.astro';
import { LOCALES, localizedPath, type Locale } from '~/data/i18n';
import { organizationSchema, websiteSchema } from '~/data/orgSchema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  lang?: Locale;
  /** Slug shared across all language variants — used for hreflang alternates. */
  slug?: string;
  /** Locales that actually have a translated page for this slug. Defaults to ['en'] — English-only pages skip hreflang entirely. */
  availableLocales?: Locale[];
}

const {
  title,
  description,
  canonical = Astro.url.toString(),
  ogImage,
  noindex = false,
  jsonLd = [],
  lang = 'en',
  slug,
  availableLocales = ['en']
} = Astro.props;

function canonicalize(value: string): string {
  const url = new URL(value, 'https://imverica.com');
  const lastSegment = url.pathname.split('/').filter(Boolean).at(-1) || '';
  if (!url.pathname.endsWith('/') && !lastSegment.includes('.')) url.pathname += '/';
  return url.toString();
}

const fullTitle = title.includes('Imverica') ? title : `${title} | Imverica Legal Solutions`;
const canonicalUrl = canonicalize(canonical);
const localeMeta = LOCALES[lang];
// Social preview card per language (public/og/og-<lang>.jpg, 1200×630).
const ogImageUrl = new URL(ogImage || `/og/og-${lang}.jpg`, 'https://imverica.com').href;
const alternates = slug && availableLocales.length > 1
  ? availableLocales.map((alt) => ({
      locale: alt,
      htmlLang: LOCALES[alt].htmlLang,
      href: canonicalize('https://imverica.com' + localizedPath(alt, slug))
    }))
  : [];
const BRAND_FONTS = 'https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap';
---
<!doctype html>
<html lang={localeMeta.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* v2 design preview: ?v2=1 on any URL stores a per-browser flag and
      ?v2=0 clears it (works even if a redirect swallows /preview). Applying
      the class here, before first paint, avoids a flash of the old design. */}
  <V2Flag />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  {!noindex && <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large" />}

  <!-- Brand mark (scales from the site logo) for tabs and iOS home screen. -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Imverica" />
  <meta name="theme-color" content="#143254" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Imverica Legal Solutions" />
  <meta property="og:locale" content={localeMeta.ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  {alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.htmlLang} href={alt.href} />
  ))}
  {alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
  )}

  {/* Google/Bing webmaster verification + GA4 — env-driven so enabling them is a
      Netlify env change + redeploy, no code edit:
        PUBLIC_GSC_VERIFICATION — content of the google-site-verification meta
        PUBLIC_BING_SITE_AUTH   — content of the msvalidate.01 meta
        PUBLIC_GA4_ID           — G-XXXXXXX measurement id
      Absent env → nothing is rendered (zero third-party JS by default). */}
  {import.meta.env.PUBLIC_GSC_VERIFICATION && (
    <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
  )}
  {import.meta.env.PUBLIC_BING_SITE_AUTH && (
    <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_AUTH} />
  )}
  {import.meta.env.PUBLIC_GA4_ID && (
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}></script>
  )}
  {import.meta.env.PUBLIC_GA4_ID && (
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${import.meta.env.PUBLIC_GA4_ID}',{anonymize_ip:true});`}></script>
  )}

  <!-- Typography: editorial brand system — Newsreader (serif) for display
       headings, Archivo (sans) for body/UI, IBM Plex Mono for kickers and
       labels. display=swap keeps text visible while the webfonts load. -->
  {/* Brand web fonts for the current design. The v2 design uses the system
      font, so it skips them entirely: no render-blocking third-party
      stylesheet and no font downloads. The current design keeps loading
      them render-blocking (blocking="render"), as before. */}
  <script is:inline set:html={`(function(){if(document.documentElement.classList.contains('v2'))return;var h=document.head;function add(rel,href,attrs){var l=document.createElement('link');l.rel=rel;l.href=href;for(var k in attrs)l.setAttribute(k,attrs[k]);h.appendChild(l)}add('preconnect','https://fonts.googleapis.com',{});add('preconnect','https://fonts.gstatic.com',{crossorigin:''});add('stylesheet',${JSON.stringify(BRAND_FONTS)},{blocking:'render'})})()`} />
  <noscript><link rel="stylesheet" href={BRAND_FONTS} /></noscript>

  {/* Canonical organization facts on EVERY page (single source:
      src/data/orgSchema.ts) + whatever page-specific schemas were passed. */}
  {[organizationSchema, websiteSchema, ...jsonLd].map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>
  <SiteHeader lang={lang} currentSlug={slug} availableLocales={availableLocales} />
  <SiteHeaderV2 lang={lang} currentSlug={slug} availableLocales={availableLocales} />
  <a class="v2-badge" href="?v2=0">New design preview <b>· Exit</b></a>
  <main>
    <slot />
  </main>
  <SiteFooter lang={lang} />
  {/* v2: apple.com-style footer; inert template, swapped in before paint */}
  <template data-v2-new="footer"><SiteFooterV2 lang={lang} slug={slug} availableLocales={availableLocales} /></template>
  <V2Swap />
  <!-- IntakeWizard runs first and registers window.openIntakeModal for
       the long Q&A. QuickIntakeModal loads AFTER it and re-assigns the
       same global to the new one-screen form — this wins for every
       homepage / landing-page CTA. The long wizard is still reachable
       from the cabinet via window.openIntakeWizard (or a direct call to
       the legacy modal when the user is mid-flow on an existing order). -->
  <IntakeWizard />
  <QuickIntakeModal />
  <ChatWidget />
  <V2Text />

  <style is:global>
    /* Reveal-on-scroll. The hidden state is only applied once JS confirms
       IntersectionObserver + no reduce-motion (html.reveal-init), so content
       is always visible if JS is disabled or motion is reduced. */
    html.reveal-init .reveal {
      opacity: 0;
      transform: translateY(26px);
      transition: opacity 0.55s ease, transform 0.55s ease;
      will-change: opacity, transform;
    }
    html.reveal-init .reveal.in {
      opacity: 1;
      transform: none;
    }
  </style>
  <script>
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;

      /* .stat-item intentionally excluded — stats sit just under the hero
         and must be visible immediately, without a scroll-reveal flash. */
      var SELECTORS = '.ourserv-card, .svc-card, .faq-item, .why-list li, .news-card, .vt, .testi-card, .form-list, .lb-related, .lb-cta-card, .about-card, .imm-cat, .cat-tile';

      function setupReveal() {
        var els = Array.prototype.slice.call(document.querySelectorAll(SELECTORS));
        if (!els.length) return;
        document.documentElement.classList.add('reveal-init');

        // Stagger each element by its index within its own parent container.
        var counts = new Map();
        els.forEach(function (el) {
          if (el.classList.contains('reveal')) return;
          el.classList.add('reveal');
          var parent = el.parentElement;
          var i = counts.get(parent) || 0;
          counts.set(parent, i + 1);
          el.style.transitionDelay = Math.min(i, 8) * 60 + 'ms';
        });

        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

        els.forEach(function (el) { obs.observe(el); });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReveal);
      } else {
        setupReveal();
      }
      document.addEventListener('astro:after-swap', setupReveal);
    })();
  </script>
  <script>
    /* Conversion beacons (SEO push 2026-07): window.imvTrack(type, extra)
       posts to our own /api/analytics AND mirrors to GA4 when gtag is
       present. tel:/mailto: clicks are tracked automatically here;
       form-submit 'lead' events are fired by the forms themselves
       (QuickIntakeModal, AppointmentScheduler) on confirmed success. */
    (function () {
      function track(type: string, extra?: Record<string, unknown>) {
        try {
          const payload = JSON.stringify(Object.assign({
            type,
            page: location.pathname,
            lang: document.documentElement.lang || 'en'
          }, extra || {}));
          if (navigator.sendBeacon) navigator.sendBeacon('/api/analytics', new Blob([payload], { type: 'application/json' }));
          else fetch('/api/analytics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
          const g = (window as any).gtag;
          if (typeof g === 'function') g('event', type === 'lead' ? 'generate_lead' : type + '_click', { page_path: location.pathname });
        } catch { /* tracking must never break the page */ }
      }
      (window as any).imvTrack = track;

      // Lead source for the forms' hidden fields: UTM tags and ad click ids
      // from the landing URL, the first page of the visit and an external
      // referrer, kept for this tab's session; plus the current page and
      // language when a form is sent.
      const LEAD_KEY = 'imv-lead-src';
      try {
        const q = new URLSearchParams(location.search);
        const fresh: Record<string, string> = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'].forEach((k) => {
          const v = q.get(k);
          if (v) fresh[k] = v.slice(0, 200);
        });
        const saved = JSON.parse(sessionStorage.getItem(LEAD_KEY) || 'null');
        if (!saved || Object.keys(fresh).length) {
          const ref = document.referrer && !document.referrer.startsWith(location.origin) ? document.referrer.slice(0, 300) : '';
          sessionStorage.setItem(LEAD_KEY, JSON.stringify(Object.assign({}, saved || {}, fresh, {
            landing: location.pathname + location.search,
            referrer: ref || (saved && saved.referrer) || ''
          })));
        }
      } catch { /* storage may be blocked; the forms still send page + language */ }
      (window as any).imvLeadContext = () => {
        let saved: Record<string, string> = {};
        try { saved = JSON.parse(sessionStorage.getItem(LEAD_KEY) || '{}') || {}; } catch { /* ignore */ }
        return Object.assign({}, saved, { page: location.pathname, lang: document.documentElement.lang || 'en' });
      };
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement | null;
        const a = t && t.closest ? (t.closest('a[href^="tel:"], a[href^="mailto:"]') as HTMLAnchorElement | null) : null;
        if (!a) return;
        track((a.getAttribute('href') || '').startsWith('tel:') ? 'call' : 'email');
      }, true);
    })();
  </script>
</body>
</html>
