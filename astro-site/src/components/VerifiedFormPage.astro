---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LandingBody from '~/components/LandingBody.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { faqSchema, type FaqItem } from '~/data/orgSchema';
import type { Locale } from '~/data/i18n';

type Kind =
  | 'i693'
  | 'i824'
  | 'i131'
  | 'i131a'
  | 'i90'
  | 'eoir'
  | 'eoir29'
  | 'eoir40'
  | 'eoir42a'
  | 'eoir42b'
  | 'sc'
  | 'probate';

interface Props { lang?: Locale; kind: Kind }
const { lang = 'en', kind } = Astro.props as Props;

const PREFIX: Record<Locale, string> = { en: '', ru: '/ru', uk: '/ua', es: '/mx' };
const prefix = PREFIX[lang];

const VARIANTS: Record<Kind, {
  code: string;
  slug: string;
  agency: 'USCIS' | 'EOIR' | 'California Courts';
  official: string;
  name: Record<Locale, string>;
  purpose: Record<Locale, string>;
}> = {
  i693: {
    code: 'I-693', slug: '/i-693-medical-examination', agency: 'USCIS', official: 'https://www.uscis.gov/i-693',
    name: { en: 'Report of Immigration Medical Examination and Vaccination Record', ru: 'медицинское заключение и запись о вакцинации', uk: 'медичний висновок і запис про вакцинацію', es: 'informe de examen médico y registro de vacunación' },
    purpose: {
      en: 'USCIS labels Form I-693 as the Report of Immigration Medical Examination and Vaccination Record. A designated civil surgeon completes the medical portions; Imverica does not perform or interpret the examination.',
      ru: 'USCIS называет I-693 отчётом об иммиграционном медицинском обследовании и вакцинации. Медицинскую часть заполняет назначенный civil surgeon; Imverica не проводит и не толкует обследование.',
      uk: 'USCIS називає I-693 звітом про імміграційне медичне обстеження та вакцинацію. Медичну частину заповнює призначений civil surgeon; Imverica не проводить і не тлумачить обстеження.',
      es: 'USCIS denomina al I-693 Informe de Examen Médico de Inmigración y Registro de Vacunación. Un civil surgeon designado completa la parte médica; Imverica no realiza ni interpreta el examen.'
    }
  },
  i824: {
    code: 'I-824', slug: '/i-824-action-on-approved-application', agency: 'USCIS', official: 'https://www.uscis.gov/i-824',
    name: { en: 'Application for Action on an Approved Application or Petition', ru: 'заявление о действии по одобренной заявке или петиции', uk: 'заява про дію щодо схваленої заяви або петиції', es: 'solicitud de acción sobre una solicitud o petición aprobada' },
    purpose: {
      en: 'USCIS labels Form I-824 as the Application for Action on an Approved Application or Petition. The official instructions control which requests may use it.',
      ru: 'USCIS называет I-824 заявлением о действии по одобренной заявке или петиции. Только официальные инструкции определяют, для каких запросов она используется.',
      uk: 'USCIS називає I-824 заявою про дію щодо схваленої заяви або петиції. Лише офіційні інструкції визначають, для яких запитів її використовують.',
      es: 'USCIS denomina al I-824 Solicitud de Acción sobre una Solicitud o Petición Aprobada. Las instrucciones oficiales controlan qué solicitudes pueden usarlo.'
    }
  },
  i131: {
    code: 'I-131', slug: '/i-131-travel-document', agency: 'USCIS', official: 'https://www.uscis.gov/i-131',
    name: { en: 'Application for Travel Documents, Parole Documents, and Arrival/Departure Records', ru: 'заявление на travel/parole documents и записи о въезде/выезде', uk: 'заява на travel/parole documents і записи про в’їзд/виїзд', es: 'solicitud de documentos de viaje, parole y registros de entrada/salida' },
    purpose: {
      en: 'USCIS uses Form I-131 for several different travel, parole, and arrival/departure requests. The client must determine the requested document and filing basis before asking Imverica to type the form.',
      ru: 'USCIS использует I-131 для разных запросов о travel, parole и въезде/выезде. До заказа подготовки клиент сам определяет нужный документ и основание подачи.',
      uk: 'USCIS використовує I-131 для різних запитів щодо travel, parole та в’їзду/виїзду. До замовлення підготовки клієнт сам визначає потрібний документ і підставу подання.',
      es: 'USCIS usa el I-131 para distintas solicitudes de viaje, parole y entrada/salida. Antes de pedir preparación, el cliente determina el documento y la base de presentación.'
    }
  },
  i131a: {
    code: 'I-131A', slug: '/i-131a-returning-resident', agency: 'USCIS', official: 'https://www.uscis.gov/i-131a',
    name: { en: 'Application for Carrier Documentation', ru: 'заявление на carrier documentation', uk: 'заява на carrier documentation', es: 'solicitud de documentación para transportista' },
    purpose: {
      en: 'USCIS labels Form I-131A as the Application for Carrier Documentation. The client must confirm from current official instructions that this is the requested filing.',
      ru: 'USCIS называет I-131A заявлением на carrier documentation. Клиент должен по актуальным официальным инструкциям подтвердить, что ему нужна именно эта подача.',
      uk: 'USCIS називає I-131A заявою на carrier documentation. Клієнт має за актуальними офіційними інструкціями підтвердити, що йому потрібне саме це подання.',
      es: 'USCIS denomina al I-131A Solicitud de Documentación para Transportista. El cliente confirma en las instrucciones oficiales que esta es la presentación solicitada.'
    }
  },
  i90: {
    code: 'I-90', slug: '/i-90-green-card-renewal', agency: 'USCIS', official: 'https://www.uscis.gov/i-90',
    name: { en: 'Application to Replace Permanent Resident Card', ru: 'заявление на замену карты постоянного жителя', uk: 'заява на заміну картки постійного мешканця', es: 'solicitud para reemplazar la tarjeta de residente permanente' },
    purpose: {
      en: 'USCIS labels Form I-90 as the Application to Replace Permanent Resident Card. The client selects the filing reason from current official instructions.',
      ru: 'USCIS называет I-90 заявлением на замену карты постоянного жителя. Причину подачи клиент выбирает по актуальным официальным инструкциям.',
      uk: 'USCIS називає I-90 заявою на заміну картки постійного мешканця. Причину подання клієнт обирає за актуальними офіційними інструкціями.',
      es: 'USCIS denomina al I-90 Solicitud para Reemplazar la Tarjeta de Residente Permanente. El cliente elige el motivo según las instrucciones oficiales vigentes.'
    }
  },
  eoir: {
    code: 'EOIR', slug: '/eoir-immigration-court', agency: 'EOIR', official: 'https://www.justice.gov/eoir/forms',
    name: { en: 'immigration-court forms', ru: 'формы иммиграционного суда', uk: 'форми імміграційного суду', es: 'formularios de la corte de inmigración' },
    purpose: {
      en: 'EOIR publishes the current immigration-court forms and instructions. Imverica can type a form already selected by a California self-represented client, but cannot choose relief, defenses, motions, evidence, or appellate strategy.',
      ru: 'EOIR публикует актуальные формы и инструкции иммиграционного суда. Imverica может внести данные в форму, уже выбранную клиентом из Калифорнии, но не выбирает relief, защиту, motions, доказательства или стратегию апелляции.',
      uk: 'EOIR публікує актуальні форми та інструкції імміграційного суду. Imverica може внести дані до форми, уже обраної клієнтом із Каліфорнії, але не обирає relief, захист, motions, докази чи стратегію апеляції.',
      es: 'EOIR publica los formularios e instrucciones vigentes. Imverica puede escribir en un formulario ya elegido por un cliente de California, pero no elige alivio, defensas, mociones, pruebas ni estrategia de apelación.'
    }
  },
  eoir29: {
    code: 'EOIR-29', slug: '/eoir-29-notice-of-appeal', agency: 'EOIR', official: 'https://www.justice.gov/eoir/forms',
    name: { en: 'Notice of Appeal to the Board of Immigration Appeals from a Decision of a DHS Officer', ru: 'уведомление об апелляции в BIA на решение сотрудника DHS', uk: 'повідомлення про апеляцію до BIA на рішення працівника DHS', es: 'aviso de apelación ante la BIA de una decisión de un oficial de DHS' },
    purpose: { en: 'EOIR lists EOIR-29 among its official forms. Appeal deadlines, jurisdiction, issues, and strategy are legal questions for an attorney.', ru: 'EOIR публикует EOIR-29 среди официальных форм. Срок, юрисдикция, вопросы и стратегия апелляции — юридические вопросы для адвоката.', uk: 'EOIR публікує EOIR-29 серед офіційних форм. Строк, юрисдикція, питання та стратегія апеляції — юридичні питання для адвоката.', es: 'EOIR incluye EOIR-29 entre sus formularios oficiales. El plazo, la jurisdicción, los asuntos y la estrategia son preguntas legales para un abogado.' }
  },
  eoir40: {
    code: 'EOIR-40', slug: '/eoir-40-suspension-of-deportation', agency: 'EOIR', official: 'https://www.justice.gov/eoir/forms',
    name: { en: 'Application for Suspension of Deportation', ru: 'заявление о suspension of deportation', uk: 'заява про suspension of deportation', es: 'solicitud de suspensión de deportación' },
    purpose: { en: 'EOIR lists EOIR-40 among its official forms. Whether this legacy form or any related framework applies is a legal eligibility question for an attorney.', ru: 'EOIR публикует EOIR-40 среди официальных форм. Применимость этой legacy-формы или связанного режима — юридический вопрос eligibility для адвоката.', uk: 'EOIR публікує EOIR-40 серед офіційних форм. Застосовність цієї legacy-форми чи пов’язаного режиму — юридичне питання eligibility для адвоката.', es: 'EOIR incluye EOIR-40 entre sus formularios oficiales. La aplicabilidad de este formulario heredado o su marco es una cuestión legal de elegibilidad para un abogado.' }
  },
  eoir42a: {
    code: 'EOIR-42A', slug: '/eoir-42a-cancellation-lpr', agency: 'EOIR', official: 'https://www.justice.gov/eoir/forms',
    name: { en: 'Application for Cancellation of Removal for Certain Permanent Residents', ru: 'заявление о cancellation of removal для некоторых permanent residents', uk: 'заява про cancellation of removal для деяких permanent residents', es: 'solicitud de cancelación de remoción para ciertos residentes permanentes' },
    purpose: { en: 'EOIR lists EOIR-42A among its official forms. Eligibility, burden of proof, evidence, deadlines, and litigation strategy require legal advice.', ru: 'EOIR публикует EOIR-42A среди официальных форм. Eligibility, burden of proof, доказательства, сроки и судебная стратегия требуют юридической консультации.', uk: 'EOIR публікує EOIR-42A серед офіційних форм. Eligibility, burden of proof, докази, строки й судова стратегія потребують юридичної консультації.', es: 'EOIR incluye EOIR-42A entre sus formularios oficiales. Elegibilidad, carga de prueba, evidencia, plazos y estrategia requieren asesoría legal.' }
  },
  eoir42b: {
    code: 'EOIR-42B', slug: '/eoir-42b-cancellation-non-lpr', agency: 'EOIR', official: 'https://www.justice.gov/eoir/forms',
    name: { en: 'Application for Cancellation of Removal and Adjustment of Status for Certain Nonpermanent Residents', ru: 'заявление о cancellation of removal для некоторых nonpermanent residents', uk: 'заява про cancellation of removal для деяких nonpermanent residents', es: 'solicitud de cancelación de remoción para ciertos no residentes permanentes' },
    purpose: { en: 'EOIR lists EOIR-42B among its official forms. Eligibility, hardship analysis, evidence, deadlines, and litigation strategy require legal advice.', ru: 'EOIR публикует EOIR-42B среди официальных форм. Eligibility, hardship analysis, доказательства, сроки и судебная стратегия требуют юридической консультации.', uk: 'EOIR публікує EOIR-42B серед офіційних форм. Eligibility, hardship analysis, докази, строки й судова стратегія потребують юридичної консультації.', es: 'EOIR incluye EOIR-42B entre sus formularios oficiales. Elegibilidad, análisis de dificultad, evidencia, plazos y estrategia requieren asesoría legal.' }
  },
  sc: {
    code: 'California Small Claims', slug: '/sc', agency: 'California Courts', official: 'https://selfhelp.courts.ca.gov/small-claims-california',
    name: { en: 'small-claims document preparation', ru: 'подготовка документов small claims', uk: 'підготовка документів small claims', es: 'preparación de documentos de reclamos menores' },
    purpose: { en: 'California Courts publishes current small-claims limits, deadlines, fees, venue rules, service rules, and forms. The client must select the claim and forms before asking Imverica for clerical preparation.', ru: 'California Courts публикует актуальные лимиты, сроки, сборы, правила venue, service и формы small claims. До заказа технической подготовки клиент сам выбирает требование и формы.', uk: 'California Courts публікує актуальні ліміти, строки, збори, правила venue, service та форми small claims. До замовлення технічної підготовки клієнт сам обирає вимогу й форми.', es: 'California Courts publica límites, plazos, tarifas, reglas de venue y service y formularios vigentes. Antes de pedir preparación técnica, el cliente elige el reclamo y los formularios.' }
  },
  probate: {
    code: 'California Probate', slug: '/california-probate', agency: 'California Courts', official: 'https://selfhelp.courts.ca.gov/probate',
    name: { en: 'probate document preparation', ru: 'подготовка документов probate', uk: 'підготовка документів probate', es: 'preparación de documentos de sucesiones' },
    purpose: { en: 'California Courts publishes current probate and small-estate information, forms, thresholds, and procedures. Choosing between probate, a small-estate procedure, a spousal petition, or another path is a legal decision Imverica does not make.', ru: 'California Courts публикует актуальную информацию, формы, пороги и процедуры probate и small estate. Выбор между probate, small-estate procedure, spousal petition или другим путём — юридическое решение, которое Imverica не принимает.', uk: 'California Courts публікує актуальну інформацію, форми, пороги й процедури probate та small estate. Вибір між probate, small-estate procedure, spousal petition чи іншим шляхом — юридичне рішення, якого Imverica не ухвалює.', es: 'California Courts publica información, formularios, umbrales y procedimientos vigentes de probate y small estate. Elegir entre probate, un procedimiento de pequeña herencia, petición conyugal u otra vía es una decisión legal que Imverica no toma.' }
  }
};

