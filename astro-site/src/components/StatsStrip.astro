---
import { STATS, type Locale } from '~/data/i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const labels = STATS[lang];

/*
  Auto-growing targets:
  - "Forms supported"   — base 734, +2 every 7 days (1 week)
  - "Priority forms"    — base 18,  +1 every 60 days (~2 months)
  Baseline = 2026-05-25 (when the user set this rule). At build time we
  bump the value forward by the elapsed weeks/2-month windows so the
  numbers grow on their own without manual edits.
*/
const BASE_DATE = Date.UTC(2026, 4, 25); // May = month 4 (0-indexed)
const now = Date.now();
const days = Math.max(0, Math.floor((now - BASE_DATE) / (24 * 60 * 60 * 1000)));
// Auto-growth: forms supported now ticks up by +1 every ~2.5 days
// (5 forms every 12 days keeps the integer arithmetic clean), and the
// priority-flows counter still gains +1 every two months.
const formsTarget = 734 + Math.floor(days * 2 / 5);
const priorityTarget = 18 + Math.floor(days / 60);

const items = [
  { target: formsTarget, suffix: '+', label: labels[0] },
  { target: priorityTarget, suffix: '+', label: labels[1] },
  { target: 4, suffix: '', label: labels[2] },
  { target: 10, suffix: '+', label: labels[3] }
];
---
<section class="stats-strip">
  <div class="stats-inner">
    {items.map((s) => (
      <div class="stat-item">
        <div class="stat-number">
          <span data-stat-target={s.target}>{s.target}</span>
          {s.suffix && <span style="font-size:0.62em;color:var(--gold-light);">{s.suffix}</span>}
        </div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<script>
  function runStatCounters() {
    const nums = document.querySelectorAll<HTMLElement>('[data-stat-target]');
    if (!nums.length) return;
    if (document.documentElement.classList.contains('v2')) { rollStats(nums); return; }

    const animate = (el: HTMLElement) => {
      const target = Number(el.getAttribute('data-stat-target') || '0');
      // Start the count-up from 0 only when the number is animated.
      el.textContent = '0';
      const duration = 1200;
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        // easeOutQuad
        const eased = 1 - (1 - progress) * (1 - progress);
        el.textContent = String(Math.round(eased * target));
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = String(target);
      };
      requestAnimationFrame(step);
    };

    if (!('IntersectionObserver' in window)) {
      nums.forEach(animate);
      return;
    }

    // Animate on first paint for any stat already in view (no scroll needed).
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -5% 0px' });

    nums.forEach((el) => observer.observe(el));
  }

  // v2 design: each digit rolls like an odometer drum (two full turns, then
  // lands on its value), left to right, once the band is properly in view.
  // Without motion support the server-rendered numbers simply stay.
  function rollStats(nums: NodeListOf<HTMLElement>) {
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (calm || !('IntersectionObserver' in window)) return;
    nums.forEach((el, item) => {
      if (el.dataset.rolled) return;
      el.dataset.rolled = '1';
      const value = String(el.getAttribute('data-stat-target') || el.textContent || '').trim();
      el.textContent = '';
      const sr = document.createElement('span');
      sr.className = 'stat-sr';
      sr.textContent = value;
      el.append(sr);
      [...value].forEach((ch, i) => {
        const col = document.createElement('span');
        col.className = 'stat-odo';
        col.setAttribute('aria-hidden', 'true');
        const strip = document.createElement('span');
        strip.className = 'stat-odo-strip';
        for (let k = 0; k < 30; k++) {
          const digit = document.createElement('span');
          digit.textContent = String(k % 10);
          strip.append(digit);
        }
        strip.dataset.to = String(20 + Number(ch));
        strip.style.transitionDelay = `${item * 140 + i * 110}ms`;
        col.append(strip);
        el.append(col);
      });
    });
    const io = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      io.unobserve(entry.target);
      window.setTimeout(() => {
        entry.target.querySelectorAll<HTMLElement>('.stat-odo-strip').forEach((strip) => {
          strip.style.transform = `translateY(${-Number(strip.dataset.to)}em)`;
        });
      }, 300);
    }), { threshold: 0.6 });
    nums.forEach((el) => io.observe(el));

    // Coming back with the Back button restores the page from bfcache with
    // the drums already stopped: spin them again from zero.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      nums.forEach((el) => {
        el.querySelectorAll<HTMLElement>('.stat-odo-strip').forEach((strip) => {
          const delay = strip.style.transitionDelay;
          strip.style.transition = 'none';
          strip.style.transform = '';
          void strip.offsetHeight;
          strip.style.transition = '';
          strip.style.transitionDelay = delay;
        });
        io.observe(el);
      });
    });
  }

  runStatCounters();
  document.addEventListener('astro:after-swap', runStatCounters);
</script>
