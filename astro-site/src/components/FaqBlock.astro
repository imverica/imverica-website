---
/**
 * Visible FAQ section. The matching FAQPage JSON-LD must be passed to
 * BaseLayout via `jsonLd={[faqSchema(items)]}` by the page (schemas belong
 * in <head>); this component only renders the on-page markup from the SAME
 * items array, so the visible text and the schema can never diverge.
 */
import type { FaqItem } from '~/data/orgSchema';

interface Props {
  heading: string;
  items: FaqItem[];
}
const { heading, items } = Astro.props;
---
<section class="faq-block">
  <div class="faq-inner">
    <h2>{heading}</h2>
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-block {
    padding: 56px 1.5rem;
  }
  .faq-inner {
    max-width: 860px;
    margin: 0 auto;
  }
  .faq-block h2 {
    font-size: var(--fs-h2);
    margin: 0 0 20px;
  }
  .faq-item {
    border-bottom: 1px solid rgba(40, 30, 20, 0.1);
  }
  .faq-item summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 600;
    font-size: 15.5px;
    color: var(--navy);
    list-style: none;
    position: relative;
    padding-right: 28px;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 2px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 20px;
    font-weight: 500;
  }
  .faq-item[open] summary::after {
    content: '−';
  }
  .faq-item p {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.65;
    color: #3d4b58;
  }
</style>
