---
/**
 * Parameterized FAQ section. Same markup shape and GLOBAL .faq-* classes as
 * the original FAQSection.astro (site.css owns the card design: white cards,
 * gold border when open, terracotta +/− badge) — no scoped styles here, so
 * every FAQ on the site stays visually identical.
 *
 * The matching FAQPage JSON-LD must be passed to BaseLayout via
 * `jsonLd={[faqSchema(items)]}` by the page (schemas belong in <head>);
 * this component renders the on-page markup from the SAME items array, so
 * the visible text and the schema can never diverge.
 */
import type { FaqItem } from '~/data/orgSchema';

interface Props {
  heading: string;
  /** Optional one-line subtitle under the heading. */
  sub?: string;
  items: FaqItem[];
}
const { heading, sub, items } = Astro.props;
---
<section class="faq-section">
  <div class="faq-inner">
    <h2>{heading}</h2>
    {sub && <p class="faq-sub">{sub}</p>}
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <div class="faq-body">
          <p>{item.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>
