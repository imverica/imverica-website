---
/**
 * v2 version of the "what we do" form grid on the RU / UA / MX homepages:
 * same copy, links and forms as the live section, laid out as tiles. Form
 * names stay in English; the translation goes in parentheses.
 * Rendered inside <template data-v2-new="services"> (see V2Swap).
 */
import type { Locale } from '~/data/i18n';

interface Props {
  lang: Exclude<Locale, 'en'>;
}
const { lang } = Astro.props;

const PREFIX: Record<Props['lang'], string> = { ru: '/ru', uk: '/ua', es: '/mx' };
const p = PREFIX[lang];

const COPY: Record<Props['lang'], { kicker: string; heading: string; lead: string; more: string }> = {
  ru: {
    kicker: 'Что мы делаем',
    heading: 'USCIS, EOIR и калифорнийские формы — готовим под ключ',
    lead: 'Помощь с подготовкой документов на русском, английском, украинском и испанском. Не юридическая фирма, юридические консультации не даём — готовим формы аккуратно и по поручению клиента.',
    more: 'Полный список USCIS, EOIR и калифорнийских форм — на странице'
  },
  uk: {
    kicker: 'Що ми робимо',
    heading: 'USCIS, EOIR і каліфорнійські форми — готуємо під ключ',
    lead: 'Допомога з підготовкою документів українською, російською, англійською та іспанською. Не юридична фірма, юридичних порад не надаємо — готуємо форми акуратно за дорученням клієнта.',
    more: 'Повний перелік форм USCIS, EOIR і Каліфорнії — на сторінці'
  },
  es: {
    kicker: 'Lo que hacemos',
    heading: 'USCIS, EOIR y formularios de California — preparados al detalle',
    lead: 'Preparación de documentos en español, inglés, ruso y ucraniano. No somos un bufete de abogados ni brindamos asesoría legal — preparamos los formularios con precisión bajo la dirección del cliente.',
    more: 'Lista completa de formularios USCIS, EOIR y California en la página'
  }
};

// [code, English form name, translations, link]
const FORMS: Array<[string, string, Record<Props['lang'], string>, string]> = [
  ['I-485', 'Adjustment of Status', { ru: 'корректировка статуса', uk: 'коригування статусу', es: 'ajuste de estatus' }, `${p}/i-485-help`],
  ['I-589', 'Application for Asylum', { ru: 'заявление о предоставлении убежища', uk: 'заява про надання притулку', es: 'solicitud de asilo' }, `${p}/i-589-asylum-help`],
  ['N-400', 'Application for Naturalization', { ru: 'заявление о натурализации', uk: 'заява про натуралізацію', es: 'solicitud de naturalización' }, `${p}/n-400-citizenship-help`],
  ['I-130', 'Petition for Alien Relative', { ru: 'петиция для родственника-иностранца', uk: 'петиція для родича-іноземця', es: 'petición para familiar extranjero' }, '/immigration#immigration-consultant-california'],
  ['I-765', 'Application for Employment Authorization', { ru: 'заявление на разрешение на работу', uk: 'заява на дозвіл на роботу', es: 'solicitud de autorización de empleo' }, '/immigration#immigration-consultant-california'],
  ['I-131', 'Application for Travel Document', { ru: 'заявление на проездной документ', uk: 'заява на проїзний документ', es: 'solicitud de documento de viaje' }, '/immigration#immigration-consultant-california'],
  ['EOIR-28 / 42A / 42B', 'Immigration Court', { ru: 'иммиграционный суд', uk: 'імміграційний суд', es: 'tribunal de inmigración' }, '/immigration#eoir-documents'],
  ['UD-100', 'Unlawful Detainer', { ru: 'выселение', uk: 'виселення', es: 'desalojo' }, `${p}/california-unlawful-detainer`],
  ['DE-295', 'Probate Closing', { ru: 'закрытие наследственного дела', uk: 'закриття спадкової справи', es: 'cierre de sucesión' }, `${p}/california-probate`],
  ['CR-180', 'Expungement', { ru: 'снятие судимости', uk: 'зняття судимості', es: 'eliminación de antecedentes penales' }, `${p}/california-expungement`]
];
const t = COPY[lang];
---
<section class="hf2">
  <div class="hf2-inner">
    <p class="hf2-kicker">{t.kicker}</p>
    <h2 class="hf2-h2">{t.heading}</h2>
    <p class="hf2-lead">{t.lead}</p>
    <div class="hf2-grid">
      {FORMS.map(([code, name, tr, href]) => (
        <a class="hf2-tile" href={href}>
          <span class="hf2-code">{code}</span>
          <span class="hf2-name">{name}</span>
          <span class="hf2-tr">({tr[lang]})</span>
        </a>
      ))}
    </div>
    <p class="hf2-more">{t.more} <a href="/immigration">USCIS | EOIR</a>.</p>
  </div>
</section>

<style is:global>
  .hf2 {
    padding: clamp(72px, 9vw, 120px) 0;
    background: #fff;
    color: #1d1d1f;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-align: center;
  }
  .hf2-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 max(16px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px));
  }
  .hf2 p { margin: 0; }
  .hf2-kicker { font-size: 17px; font-weight: 600; letter-spacing: -0.022em; color: #6e6e73; }
  html.v2 .hf2 .hf2-h2 {
    max-width: 900px;
    margin: 12px auto 0;
    font-family: inherit;
    font-size: clamp(32px, 4.2vw, 56px);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1d1d1f;
    text-wrap: balance;
  }
  .hf2-lead { max-width: 780px; margin: 18px auto 0 !important; font-size: 21px; line-height: 1.381; letter-spacing: 0.011em; color: #424245; }
  .hf2-grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 20px;
    text-align: left;
  }
  .hf2 .hf2-tile,
  html.v2 .hf2 .hf2-tile:hover {
    min-height: 170px;
    padding: 28px 28px 26px;
    border-radius: 28px;
    background: #f5f5f7;
    color: #1d1d1f;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    transition: scale 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s ease;
  }
  .hf2 .hf2-tile:hover { scale: 1.015; background: #ededf0; }
  .hf2 .hf2-tile:first-child,
  html.v2 .hf2 .hf2-tile:first-child:hover { background: #143254; color: #fff; }
  .hf2-code { font-size: 28px; line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; }
  .hf2-name { margin-top: auto; font-size: 17px; line-height: 1.3; font-weight: 600; letter-spacing: -0.022em; }
  .hf2-tr { font-size: 15px; line-height: 1.4; color: #6e6e73; }
  .hf2 .hf2-tile:first-child .hf2-tr { color: rgba(255, 255, 255, 0.74); }
  .hf2-more { margin-top: 28px !important; font-size: 14px; color: #6e6e73; }
  .hf2-more a { color: #143254; }
  html.hv2-motion .hf2 .hf2-tile { opacity: 0; transform: translateY(48px); transition: opacity 0.9s ease, transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1), scale 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  html.hv2-motion .hf2 .hf2-tile.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.hv2-motion .hf2 .hf2-tile { opacity: 1; transform: none; transition: none; }
  }
</style>
