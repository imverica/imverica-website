---
// "See the result first": a filled sample of the form with invented data
// (built by scripts/build-form-samples.js into /samples), with page previews
// and the full watermarked PDF.
type Lang = 'en' | 'ru' | 'uk' | 'es';
interface Props { form: 'i-485' | 'fl-150'; lang?: Lang }
const { form, lang = 'en' } = Astro.props;

const SAMPLES = {
  'i-485': { code: 'I-485', pages: 24, previews: [1, 3, 5] },
  'fl-150': { code: 'FL-150', pages: 4, previews: [1, 2, 3, 4] }
};
const sample = SAMPLES[form];

const COPY = {
  en: {
    kicker: 'See the result first',
    heading: `A sample ${sample.code}, filled the way we prepare it`,
    'i-485': 'Every name, number and address in this sample is invented. It shows what you get: the current USCIS edition, every answer in its own box, dates as mm/dd/yyyy, and extra pages when the form runs out of space.',
    'fl-150': 'Every name and number in this sample is invented. It shows what you get: the current Judicial Council revision, totals that add up, and the attachments the form asks for listed for you.',
    open: `Open the full sample (PDF, ${sample.pages} pages)`,
    page: 'page',
    note: 'A sample only: not legal advice, and not a form for anyone’s real case.'
  },
  ru: {
    kicker: 'Сначала посмотрите результат',
    heading: `Образец ${sample.code} — так мы его заполняем`,
    'i-485': 'Все имена, номера и адреса в образце вымышленные. Видно, что вы получите: актуальную редакцию USCIS, каждый ответ в своём поле, даты в формате mm/dd/yyyy и дополнительные страницы, если в форме не хватает места.',
    'fl-150': 'Все имена и цифры в образце вымышленные. Видно, что вы получите: актуальную редакцию Judicial Council, сходящиеся итоги и список приложений, которые требует форма.',
    open: `Открыть весь образец (PDF, ${sample.pages} стр.)`,
    page: 'стр.',
    note: 'Только образец: не юридическая консультация и не форма по чьему-то реальному делу.'
  },
  uk: {
    kicker: 'Спершу подивіться результат',
    heading: `Зразок ${sample.code} — так ми його заповнюємо`,
    'i-485': 'Усі імена, номери й адреси у зразку вигадані. Видно, що ви отримаєте: актуальну редакцію USCIS, кожну відповідь у своєму полі, дати у форматі mm/dd/yyyy і додаткові сторінки, якщо у формі бракує місця.',
    'fl-150': 'Усі імена й цифри у зразку вигадані. Видно, що ви отримаєте: актуальну редакцію Judicial Council, підсумки, що сходяться, і перелік додатків, яких вимагає форма.',
    open: `Відкрити весь зразок (PDF, ${sample.pages} стор.)`,
    page: 'стор.',
    note: 'Лише зразок: не юридична консультація і не форма у чиїйсь реальній справі.'
  },
  es: {
    kicker: 'Vea el resultado primero',
    heading: `Un ejemplo de ${sample.code}, llenado como lo preparamos`,
    'i-485': 'Todos los nombres, números y direcciones del ejemplo son inventados. Muestra lo que recibe: la edición vigente de USCIS, cada respuesta en su casilla, fechas en formato mm/dd/aaaa y páginas adicionales cuando falta espacio.',
    'fl-150': 'Todos los nombres y cifras del ejemplo son inventados. Muestra lo que recibe: la revisión vigente del Judicial Council, totales que cuadran y la lista de anexos que pide el formulario.',
    open: `Abrir el ejemplo completo (PDF, ${sample.pages} páginas)`,
    page: 'pág.',
    note: 'Solo un ejemplo: no es asesoría legal ni un formulario de un caso real.'
  }
}[lang];
---
<section class="sample-section" id="sample">
  <div class="sample-inner">
    <div class="sample-copy">
      <div class="sample-kicker">{COPY.kicker}</div>
      <h2>{COPY.heading}</h2>
      <p>{COPY[form]}</p>
      <a class="sample-open" href={`/samples/${form}-sample.pdf`} target="_blank" rel="noopener">{COPY.open} <span aria-hidden="true">→</span></a>
      <p class="sample-note">{COPY.note}</p>
    </div>
    <div class="sample-pages">
      {sample.previews.map((page) => (
        <a class="sample-page" href={`/samples/${form}-sample-p${page}.webp`} target="_blank" rel="noopener">
          <img src={`/samples/${form}-sample-p${page}.webp`} width="900" height="1165" loading="lazy" decoding="async"
            alt={`${sample.code} sample, ${COPY.page} ${page} (fictional data)`} />
          <span>{sample.code} · {COPY.page} {page}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .sample-section {
    background: var(--paper-alt, #f5f5f7);
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
    padding: var(--space-section) 1.5rem;
  }
  .sample-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(320px, 1.2fr);
    gap: 32px;
    align-items: start;
  }
  .sample-kicker {
    color: var(--terracotta-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .sample-copy h2 { font-size: var(--fs-h2); margin-bottom: 14px; text-wrap: balance; }
  .sample-copy p { color: #3a4a5e; font-size: 15px; line-height: 1.7; margin: 0 0 18px; }
  .sample-copy .sample-note { font-size: 12.5px; color: var(--muted, #6b7280); margin: 14px 0 0; }
  .sample-open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--navy);
    color: #fff;
    font-weight: 700;
    font-size: 14.5px;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 999px;
  }
  .sample-open:hover { background: var(--navy-dark, var(--navy)); }
  .sample-pages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;
  }
  .sample-page {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: #3a4a5e;
    font-size: 12.5px;
    font-weight: 600;
  }
  .sample-page img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 8px 22px rgba(15, 22, 35, 0.08);
    background: #fff;
    transition: transform 0.18s ease;
  }
  .sample-page:hover img { transform: translateY(-2px); }
  @media (max-width: 820px) {
    .sample-inner { grid-template-columns: 1fr; }
    .sample-section { padding: var(--space-section) 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sample-page img { transition: none; }
  }
</style>
