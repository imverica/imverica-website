---
/**
 * v2 homepage opening: the hero with the Ask Imverica finder (HomeSearch,
 * the Claude-backed bot, unchanged), page 1 of three real forms (I-485,
 * SC-100, FL-100) that rise and fan out on scroll, and a statement that
 * lights up word by word. Everything below it on the homepage is the
 * current production sections.
 *
 * The headline alternates between the current homepage copy (A, the real
 * <h1>) and the prototype line (B, decorative, aria-hidden). Form names stay
 * in English everywhere; translations go in parentheses.
 *
 * Pages render this inside a <template> that V2Swap swaps in before first
 * paint only when <html class="v2"> (the per-browser preview flag), so
 * regular visitors and crawlers keep the current hero until cutover.
 */
import HomeSearch from '~/components/HomeSearch.astro';
import type { Locale } from '~/data/i18n';

interface Props {
  lang?: Locale;
  eyebrow: string;
  heading: string;
  sub: string;
}
const { lang = 'en', eyebrow, heading, sub } = Astro.props;

const COPY: Record<Locale, { altHeading: string; altSub: string; capA: string; capB: string; statement: string; scroll: string }> = {
  en: {
    altHeading: 'Paperwork, done right.',
    altSub: 'USCIS, EOIR and California court documents, prepared at your direction in English, Russian, Ukrainian and Spanish.',
    capA: 'Official USCIS and California court forms.',
    capB: 'Current editions, prepared at your direction.',
    statement: 'We prepare USCIS, EOIR and California court documents accurately, on time, and at your direction. In English, Russian, Ukrainian and Spanish.',
    scroll: 'Scroll'
  },
  ru: {
    altHeading: 'Документы — по всем правилам.',
    altSub: 'Документы USCIS, EOIR и судов Калифорнии, подготовленные по вашему поручению на английском, русском, украинском и испанском.',
    capA: 'Официальные формы USCIS и судов Калифорнии.',
    capB: 'Актуальные редакции, подготовленные по вашему поручению.',
    statement: 'Мы готовим документы USCIS, EOIR и судов Калифорнии точно, в срок и по вашему поручению. На английском, русском, украинском и испанском.',
    scroll: 'Листайте'
  },
  uk: {
    altHeading: 'Документи — за всіма правилами.',
    altSub: 'Документи USCIS, EOIR і судів Каліфорнії, підготовлені за вашим дорученням англійською, російською, українською та іспанською.',
    capA: 'Офіційні форми USCIS і судів Каліфорнії.',
    capB: 'Актуальні редакції, підготовлені за вашим дорученням.',
    statement: 'Ми готуємо документи USCIS, EOIR і судів Каліфорнії точно, вчасно та за вашим дорученням. Англійською, російською, українською та іспанською.',
    scroll: 'Гортайте'
  },
  es: {
    altHeading: 'Su papeleo, bien hecho.',
    altSub: 'Documentos de USCIS, EOIR y de los tribunales de California, preparados bajo su dirección en inglés, ruso, ucraniano y español.',
    capA: 'Formularios oficiales de USCIS y de los tribunales de California.',
    capB: 'Ediciones vigentes, preparadas bajo su dirección.',
    statement: 'Preparamos documentos de USCIS, EOIR y de los tribunales de California con precisión, a tiempo y bajo su dirección. En inglés, ruso, ucraniano y español.',
    scroll: 'Desplácese'
  }
};
const t = COPY[lang] || COPY.en;
const words = heading.split(/\s+/);
---
<section class="hv2-hero" aria-labelledby="hv2-title">
  <div class="hv2-pin">
    <div class="hv2-dim" aria-hidden="true"></div>
    <div class="hv2-copy">
      <p class="hv2-eyebrow">{eyebrow}</p>
      <div class="hv2-swap" data-hv2-swap>
        <div class="hv2-variant is-on">
          <h1 class="hv2-h1" id="hv2-title">{words.map((word, i) => <><span class="w" style={`--i: ${i}`}>{word}</span>{i < words.length - 1 ? ' ' : ''}</>)}</h1>
          <p class="hv2-sub">{sub}</p>
        </div>
        <div class="hv2-variant" aria-hidden="true">
          <p class="hv2-h1">{t.altHeading}</p>
          <p class="hv2-sub">{t.altSub}</p>
        </div>
      </div>
      <div class="hv2-finder">
        <HomeSearch lang={lang} />
      </div>
    </div>

    <div class="hv2-stack-move" aria-hidden="true">
      <div class="hv2-stack-in">
        <div class="hv2-stack">
          <div class="hv2-sheet hv2-sheet--l"><img src="/img/forms/sc-100-page-1.webp" srcset="/img/forms/sc-100-page-1-480.webp 480w, /img/forms/sc-100-page-1.webp 760w" sizes="(max-width: 733px) 240px, 380px" alt="" width="330" height="427" decoding="async" /></div>
          <div class="hv2-sheet hv2-sheet--r"><img src="/img/forms/fl-100-page-1.webp" srcset="/img/forms/fl-100-page-1-480.webp 480w, /img/forms/fl-100-page-1.webp 760w" sizes="(max-width: 733px) 240px, 380px" alt="" width="330" height="427" decoding="async" /></div>
          <div class="hv2-sheet hv2-sheet--c"><img src="/img/forms/i-485-page-1.webp" srcset="/img/forms/i-485-page-1-480.webp 480w, /img/forms/i-485-page-1.webp 760w" sizes="(max-width: 733px) 270px, 430px" alt="" width="380" height="492" decoding="async" /></div>
        </div>
      </div>
    </div>

    <p class="hv2-cap" aria-hidden="true">{t.capA}<br /><span>{t.capB}</span></p>
    <div class="hv2-hint" aria-hidden="true">
      {t.scroll}
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
    </div>
  </div>
</section>

<section class="hv2-statement">
  <div class="hv2-statement-inner">
    <p class="hv2-statement-eyebrow">Imverica Legal Solutions</p>
    <p class="hv2-reveal" data-hv2-reveal>{t.statement}</p>
  </div>
</section>

<style is:global>
  .hv2-hero {
    --hv2-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --hv2-bar: 48px;
    position: relative;
    background: #07111f;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .hv2-hero p { margin: 0; }
  .hv2-hero .hv2-pin { position: relative; overflow: hidden; padding-top: 64px; }
  .hv2-hero .hv2-dim { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }
  .hv2-hero .hv2-copy {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 max(16px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px));
    text-align: center;
    will-change: transform, opacity;
  }
  .hv2-hero .hv2-eyebrow { font-size: 17px; font-weight: 600; letter-spacing: -0.022em; color: #9fb9de; }
  html.v2 .hv2-hero .hv2-h1 {
    max-width: 1000px;
    margin: 16px auto 0;
    font-family: inherit;
    font-size: clamp(44px, 6vw, 88px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.028em;
    color: #fff;
    text-wrap: balance;
  }
  .hv2-hero .hv2-h1 .w { display: inline-block; }
  .hv2-hero .hv2-swap { display: grid; }
  .hv2-hero .hv2-variant {
    grid-area: 1 / 1;
    align-self: center;
    transition: opacity 0.9s ease, transform 1s var(--hv2-ease), filter 0.9s ease;
  }
  .hv2-hero .hv2-variant:not(.is-on) { opacity: 0; transform: translateY(14px); filter: blur(8px); pointer-events: none; }
  .hv2-hero .hv2-sub {
    max-width: 680px;
    margin: 22px auto 0;
    font-size: 21px;
    line-height: 1.381;
    letter-spacing: 0.011em;
    color: rgba(255, 255, 255, 0.74);
  }
  /* The Ask Imverica finder keeps its own look (white field, navy arrow);
     only the pieces around it are recoloured for the dark ground. */
  .hv2-hero .hv2-finder .ai-finder { margin-top: 30px; }
  .hv2-hero .hv2-finder .ai-finder-form { box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45); border-color: transparent; }
  html.v2 .hv2-hero .hv2-finder .ai-example {
    min-height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }
  html.v2 .hv2-hero .hv2-finder .ai-example:hover { background: rgba(255, 255, 255, 0.14); border-color: rgba(255, 255, 255, 0.4); color: #fff; }
  html.v2 .hv2-hero .hv2-finder .ai-finder-meta { margin-top: 20px; color: rgba(255, 255, 255, 0.6); }
  .hv2-hero .hv2-finder .ai-finder-meta span::before { background: #9fb9de; }
  .hv2-hero .hv2-finder .hero-phone,
  html.v2 .hv2-hero .hv2-finder .hero-phone:hover { color: #fff; }
  html.v2 .hv2-hero .hv2-finder .ai-services-link,
  html.v2 .hv2-hero .hv2-finder .ai-services-link:hover { color: rgba(255, 255, 255, 0.74); border-bottom-color: rgba(255, 255, 255, 0.3); }

  .hv2-hero .hv2-stack-move { position: relative; height: 500px; margin-top: 40px; transform-origin: 50% 0; will-change: transform; }
  .hv2-hero .hv2-stack-in { position: absolute; inset: 0; }
  .hv2-hero .hv2-stack { --fan: 270; --rot: 9; position: absolute; inset: 0; }
  .hv2-hero .hv2-sheet {
    position: absolute;
    left: 50%;
    top: 70px;
    width: 330px;
    height: 427px;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
  }
  .hv2-hero .hv2-sheet img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hv2-hero .hv2-sheet--l { transform: translateX(calc(-50% - var(--fan) * 1px)) rotate(calc(var(--rot) * -1deg)); }
  .hv2-hero .hv2-sheet--r { transform: translateX(calc(-50% + var(--fan) * 1px)) rotate(calc(var(--rot) * 1deg)); }
  .hv2-hero .hv2-sheet--l img, .hv2-hero .hv2-sheet--r img { filter: brightness(0.93); }
  .hv2-hero .hv2-sheet--c { top: 0; width: 380px; height: 492px; transform: translateX(-50%); box-shadow: 0 50px 110px rgba(0, 0, 0, 0.6); }
  .hv2-hero .hv2-cap {
    position: absolute;
    left: 0;
    right: 0;
    top: 72px;
    z-index: 1;
    padding: 0 16px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    font-size: clamp(32px, 3.6vw, 52px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.022em;
    color: #fff;
  }
  .hv2-hero .hv2-cap span { color: #9fb9de; }
  .hv2-hero .hv2-hint {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    pointer-events: none;
  }
  .hv2-hero .hv2-hint svg { animation: hv2-nudge 1.8s ease-in-out infinite; }

  .hv2-statement {
    background: #000;
    color: #fff;
    padding: 150px 0 160px;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .hv2-statement-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 max(16px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px));
  }
  .hv2-statement p { margin: 0; }
  .hv2-statement-eyebrow { margin-bottom: 22px !important; font-size: 17px; font-weight: 600; letter-spacing: -0.022em; color: #9fb9de; }
  .hv2-statement .hv2-reveal { max-width: 1020px; font-size: clamp(32px, 4.6vw, 64px); line-height: 1.12; font-weight: 700; letter-spacing: -0.022em; }

  @media (max-width: 733px) {
    .hv2-statement { padding: 96px 0 104px; }
    .hv2-hero .hv2-stack-move { height: 330px; margin-top: 32px; }
    .hv2-hero .hv2-stack { transform: scale(0.6); transform-origin: 50% 0; }
    html.v2 .hv2-hero .hv2-h1 { font-size: clamp(36px, 10.5vw, 56px); }
    .hv2-hero .hv2-sub { font-size: 17px; line-height: 1.47; letter-spacing: -0.022em; }
  }

  @keyframes hv2-fade-up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes hv2-word-up { from { opacity: 0; transform: translateY(0.42em); } to { opacity: 1; transform: none; } }
  @keyframes hv2-stack-in { from { opacity: 0; transform: translateY(90px); } to { opacity: 1; transform: none; } }
  @keyframes hv2-nudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  html.hv2-motion .hv2-hero .hv2-h1 .w { animation: hv2-word-up 0.6s var(--hv2-ease) both; animation-delay: calc(var(--i) * 45ms + 40ms); }
  html.hv2-motion .hv2-hero .hv2-sub { animation: hv2-fade-up 0.6s var(--hv2-ease) 0.2s both; }
  html.hv2-motion .hv2-hero .hv2-finder { animation: hv2-fade-up 0.6s var(--hv2-ease) 0.28s both; }
  html.hv2-motion .hv2-hero .hv2-stack-in { animation: hv2-stack-in 0.85s var(--hv2-ease) 0.22s both; }
  @media (min-width: 734px) {
    html.hv2-motion:not(.hv2-calm) .hv2-hero:not(.is-static) { height: 225vh; }
    html.hv2-motion:not(.hv2-calm) .hv2-hero:not(.is-static) .hv2-hint { display: flex; }
    html.hv2-motion:not(.hv2-calm) .hv2-hero:not(.is-static) .hv2-pin {
      position: sticky;
      top: var(--hv2-bar);
      height: calc(100vh - var(--hv2-bar));
      height: calc(100svh - var(--hv2-bar));
    }
  }
  /* The caption only exists inside the pinned scroll; without it, hide it. */
  html:not(.hv2-motion) .hv2-hero .hv2-cap,
  html.hv2-calm .hv2-hero .hv2-cap,
  .hv2-hero.is-static .hv2-cap { display: none; }
</style>

<script>
  import { initHeroV2 } from '~/scripts/hero-v2';
  initHeroV2();
</script>
