---
/**
 * v2 preview text pass (does nothing without html.v2):
 *  - keeps form numbers (I-485, EOIR-42B, SC-100 …), the phone number and
 *    statute ranges (§§6400-6415) on one line: each match is wrapped in <span class="v2-fno"> (white-space:
 *    nowrap in site-v2.css);
 *  - swaps colour emoji (📞, 💬, 🛂 …) for the matching monochrome line icon
 *    from styles/v2-icons.css: <span class="v2-ico" data-ico="phone">. Emoji
 *    without an icon are hidden. Rating stars, arrows and © stay as text.
 * The words themselves are unchanged, so copy, search and SEO see the same
 * text. Also covers content added later (finder answers, chat, modals).
 */
---
<script is:inline>
(function () {
  var root = document.documentElement;
  if (!root.classList.contains('v2') || !window.MutationObserver) return;
  var FNO = /\b[A-Z]{1,5}-\d{1,4}[A-Z]{0,2}\b|\+1 \(\d{3}\) \d{3}-\d{4}|§§?\s?\d{3,5}[-–]\d{3,5}/g;
  var EMO;
  try {
    EMO = new RegExp('\\p{Regional_Indicator}{2}|(?:\\p{Emoji_Presentation}|\\p{Extended_Pictographic}\\uFE0F|[\\u2709\\u2696\\u23F1\\u260E])(?:\\u200D\\p{Extended_Pictographic}\\uFE0F?|[\\u{1F3FB}-\\u{1F3FF}]|\\uFE0F)*', 'gu');
  } catch (e) { EMO = null; }
  var ICONS = {
    phone: '📞☎', mobile: '📱', chat: '💬🗨', mail: '✉📨📧📩', doc: '📄📋📑📃🧾📜',
    folder: '📂📁', search: '🔍🔎', upload: '📤', scale: '⚖', ring: '💍', id: '🛂🪪',
    building: '🏛🏢🏦', home: '🏠🏡', shield: '🛡', sparkle: '🤖✨🧹', person: '👤🧑',
    people: '👨👩👪👥🤝', bell: '🔔', question: '❓', clock: '⏱⏰', calendar: '📅📆🗓',
    star: '⭐🌟', ruler: '📐', refresh: '🔁🔄♻↩', lock: '🔒', check: '✅✔', money: '💵💰',
    globe: '🌐🌍🌎🌏', briefcase: '💼', chart: '📊📈', pen: '✍✏📝', hash: '🔢',
    megaphone: '📣📢', book: '📚', clip: '📎', warning: '⚠', heart: '💔❤', bolt: '⚡',
    plane: '✈', car: '🚗', leaf: '🌿', child: '👶🧒', grad: '🎓', luggage: '🧳', dot: '🟢'
  };
  var BY = {};
  Object.keys(ICONS).forEach(function (name) { Array.from(ICONS[name]).forEach(function (ch) { BY[ch] = name; }); });
  function iconFor(seq) {
    if (seq.indexOf('⚖') >= 0) return 'scale';
    return BY[Array.from(seq)[0]] || '';
  }
  var SKIP = /^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE|TEXTAREA|INPUT|SELECT|OPTION|OPTGROUP|DATALIST|TITLE|svg)$/i;
  function skip(el) {
    for (; el && el !== document.body; el = el.parentElement) {
      if (SKIP.test(el.nodeName) || el.isContentEditable || (el.classList && (el.classList.contains('v2-fno') || el.classList.contains('v2-ico') || el.classList.contains('v2-txt'))) || el.namespaceURI === 'http://www.w3.org/2000/svg') return true;
    }
    return false;
  }
  function wants(text) {
    if (!text) return false;
    if (text.indexOf('-') >= 0) { FNO.lastIndex = 0; if (FNO.test(text)) return true; }
    if (EMO) { EMO.lastIndex = 0; if (EMO.test(text)) return true; }
    return false;
  }
  function wrap(node) {
    var text = node.nodeValue;
    if (!wants(text)) return;
    var hits = [];
    var m;
    FNO.lastIndex = 0;
    while ((m = FNO.exec(text))) hits.push({ at: m.index, end: m.index + m[0].length, text: m[0], kind: 'fno' });
    if (EMO) { EMO.lastIndex = 0; while ((m = EMO.exec(text))) hits.push({ at: m.index, end: m.index + m[0].length, text: m[0], kind: 'ico' }); }
    hits.sort(function (a, b) { return a.at - b.at; });
    var frag = document.createDocumentFragment();
    var at = 0;
    hits.forEach(function (h) {
      if (h.at < at) return;
      if (h.at > at) frag.appendChild(document.createTextNode(text.slice(at, h.at)));
      var span = document.createElement('span');
      if (h.kind === 'fno') {
        span.className = 'v2-fno';
        span.textContent = h.text;
      } else {
        var name = iconFor(h.text);
        span.className = name ? 'v2-ico' : 'v2-ico v2-ico-none';
        if (name) span.setAttribute('data-ico', name);
        span.setAttribute('aria-hidden', 'true');
      }
      frag.appendChild(span);
      at = h.end;
    });
    if (at < text.length) frag.appendChild(document.createTextNode(text.slice(at)));
    // In a flex / grid container every span would become its own item (and
    // lose the spaces between them), so keep the whole run in one span there.
    var parent = node.parentNode;
    if (/flex|grid/.test(getComputedStyle(parent).display)) {
      var run = document.createElement('span');
      run.className = 'v2-txt';
      run.appendChild(frag);
      frag = run;
    }
    parent.replaceChild(frag, node);
  }
  function scan(el) {
    if (!el) return;
    if (el.nodeType === 3) { if (!skip(el.parentElement)) wrap(el); return; }
    if (el.nodeType !== 1 || skip(el)) return;
    var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    var list = [];
    for (var n = walker.nextNode(); n; n = walker.nextNode()) if (wants(n.nodeValue)) list.push(n);
    for (var i = 0; i < list.length; i++) if (!skip(list[i].parentElement)) wrap(list[i]);
  }
  try {
    scan(document.body);
    new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i++) {
        var r = records[i];
        if (r.type === 'characterData') { scan(r.target); continue; }
        for (var j = 0; j < r.addedNodes.length; j++) scan(r.addedNodes[j]);
      }
    }).observe(document.body, { childList: true, subtree: true, characterData: true });
  } catch (e) {}
})();
</script>
