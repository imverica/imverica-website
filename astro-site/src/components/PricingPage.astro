---
/**
 * The pricing page in four languages (/pricing, /ru/pricing, /ua/pricing,
 * /mx/pricing). Content and every amount come from src/data/pricing.ts, so
 * the four pages always show the same prices.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import CTAStrip from '~/components/CTAStrip.astro';
import { LOCALES, type Locale } from '~/data/i18n';
import { CATEGORIES, DISCOUNTS, FAQ, LEGAL, PAGE, PRICING_SCHEMA, SUPPORT, UI, priceText, uscisFeeUrl, type Row } from '~/data/pricing';

interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props as Props;
const prefix = LOCALES[lang].prefix;
const slug = '/pricing';
const canonical = `https://imverica.com${prefix}${slug}`;
const t = (v: Record<Locale, string>) => v[lang];
const text = (v: string | Record<Locale, string> | undefined) => (v === undefined ? '' : typeof v === 'string' ? v : v[lang]);
const hasRest = (row: Row) => row.rest !== undefined;
---
<BaseLayout title={t(PAGE.title)} description={t(PAGE.description)} canonical={canonical}
  slug={slug} lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[PRICING_SCHEMA]}>
  <Hero
    lang={lang}
    eyebrow={t(PAGE.eyebrow)}
    heading={t(PAGE.heading)}
    headingHtml={t(PAGE.headingHtml)}
    sub={t(PAGE.sub)}
    ctaPrimary={{ href: `${prefix}/#get-started`, text: t(PAGE.ctaQuote) }}
    ctaSecondary={{ href: 'tel:+19163993992', text: '📞 +1 (916) 399-3992' }}
  />

  <section class="pricing-section">
    <div class="pricing-inner">

      {CATEGORIES.map((cat) => (
        <div class={`price-card price-card--${cat.color}`}>
          <div class="price-card-stripe"></div>
          <div class="price-card-head">
            <button type="button" class="price-card-icon price-card-icon-button" data-prefill={t(cat.iconPrefill)} aria-label={t(cat.iconAria)}><span aria-hidden="true">{cat.icon}</span></button>
            <div>
              <div class="price-card-kicker">{t(cat.kicker)}</div>
              <h2>{t(cat.title)}</h2>
              <p class="price-card-sub">{t(cat.sub)}</p>
            </div>
          </div>
          <table class="price-table">
            <thead>
              <tr><th>{t(UI.service)}</th><th class="num">{t(cat.feeHead || UI.fee)}</th><th class="num">{t(cat.govHead === 'court' ? UI.govCourt : UI.govFiling)}</th></tr>
            </thead>
            <tbody>
              {cat.rows.map((row, i) => (
                <>
                  {cat.divider && cat.divider.before === i && <tr><td colspan="3" class="price-table-divider">{t(cat.divider.label)}</td></tr>}
                  <tr class={row.popular ? 'price-row-popular' : undefined} data-prefill={row.prefill ? t(row.prefill) : undefined} data-formcode={row.formCode}>
                    <td>
                      <strong>{text(row.strong)}</strong>{hasRest(row) && ` ${text(row.rest)}`}
                      {row.meta && <><br /><span class="price-row-meta">{text(row.meta)}</span></>}
                    </td>
                    {row.price === 'quote'
                      ? <td class="num quote">{priceText(row.price, lang)}</td>
                      : <td class="num"><span class="price">{priceText(row.price, lang)}</span></td>}
                    <td class="num gov">{uscisFeeUrl(row)
                      ? <a class="gov-link" href={uscisFeeUrl(row)} target="_blank" rel="noopener" title={t(UI.uscisFeeTitle)}>{t(UI.uscisFee)}</a>
                      : t(UI.gov[row.gov])}</td>
                  </tr>
                </>
              ))}
            </tbody>
          </table>
          <p class="price-card-disclaimer" set:html={t(cat.disclaimerHtml)} />
        </div>
      ))}

      <div class="discounts-strip">
        <div class="discounts-strip-head">
          <h2>{t(DISCOUNTS.heading)}</h2>
          <p>{t(DISCOUNTS.sub)}</p>
        </div>
        <div class="discounts-grid">
          {DISCOUNTS.cards.map((card) => (
            <button type="button" class="discount-card" data-prefill={t(card.prefill)}>
              <div class="discount-pct">{card.pct}</div>
              <div class="discount-title">{t(card.title)}</div>
              <div class="discount-desc">{t(card.desc)}</div>
            </button>
          ))}
          <a class="discount-card discount-card--b2b" href="/for-attorneys">
            <div class="discount-pct">B2B</div>
            <div class="discount-title">{t(DISCOUNTS.b2b.title)}</div>
            <div class="discount-desc">{t(DISCOUNTS.b2b.desc)}</div>
            <div class="discount-action">{t(DISCOUNTS.b2b.action)}</div>
          </a>
        </div>
      </div>

      <div class="compare-strip">
        <h2>{t(SUPPORT.heading)}</h2>
        <p class="compare-intro">{t(SUPPORT.intro)}</p>
        <div class="compare-grid">
          {SUPPORT.cols.map((col) => (
            <div class={`compare-col compare-col--${col.kind}`}>
              <div class={col.featured ? 'compare-tier compare-tier--featured' : 'compare-tier'}>{t(col.tier)}</div>
              <div class="compare-name">{t(col.name)}</div>
              <ul>
                {col.items.map((item) => <li>{t(item)}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="pricing-faq">
        <h2>{t(FAQ.heading)}</h2>
        {FAQ.items.map((item) => (
          <details>
            <summary>{t(item.q)}</summary>
            <p>{t(item.a)}</p>
          </details>
        ))}
      </div>

      <div class="pricing-legal">
        <h3>{t(LEGAL.heading)}</h3>
        <p set:html={t(LEGAL.p1Html)} />
        <p set:html={t(LEGAL.p2Html)} />
      </div>

    </div>
  </section>

  <CTAStrip
    lang={lang}
    heading={t(PAGE.ctaHeading)}
    sub={t(PAGE.ctaSub)}
    primaryHref={`${prefix}/#get-started`}
    primaryText={t(PAGE.ctaPrimary)}
  />

  <!-- Wire price-table rows and discount cards to the QuickIntakeModal.
       Each row/card carries data-prefill (and optionally data-formcode);
       on click we open the intake with that text pre-filled into the
       situation field so the visitor's first message to us is already
       written. Falls back gracefully if openIntakeModal isn't ready. -->
  <script is:inline>
    (function () {
      function openIntake(prefill, formCode) {
        if (typeof window.openIntakeModal !== 'function') {
          // Modal hasn't loaded — fall back to the generic homepage CTA.
          window.location.href = '/#get-started';
          return;
        }
        window.openIntakeModal(prefill || '', formCode ? { formCode: formCode } : undefined);
      }

      // Price-table rows
      document.querySelectorAll('.price-table tr[data-prefill]').forEach(function (row) {
        row.classList.add('price-row-clickable');
        row.setAttribute('role', 'button');
        row.setAttribute('tabindex', '0');
        row.addEventListener('click', function (e) {
          // The USCIS fee link opens G-1055, not the intake.
          if (e.target && e.target.closest && e.target.closest('a')) return;
          openIntake(row.getAttribute('data-prefill'), row.getAttribute('data-formcode'));
        });
        row.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openIntake(row.getAttribute('data-prefill'), row.getAttribute('data-formcode'));
          }
        });
      });

      // Price-card icons
      document.querySelectorAll('.price-card-icon-button[data-prefill]').forEach(function (button) {
        button.addEventListener('click', function () {
          openIntake(button.getAttribute('data-prefill'));
        });
      });

      // Discount cards (the B2B card is a real <a href> link — skip)
      document.querySelectorAll('.discount-card[data-prefill]').forEach(function (card) {
        card.addEventListener('click', function () {
          openIntake(card.getAttribute('data-prefill'));
        });
      });
    })();
  </script>

  <style>
    /* ===== Hero overrides on this page only ===== */
    /* (none — default hero styling is fine) */

    /* ===== Outer section ===== */
    .pricing-section {
      background: linear-gradient(180deg, #fafaf7 0%, #fff 280px);
      padding: 56px 1.5rem 80px;
    }
    .pricing-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    /* ===== Category card ===== */
    .price-card {
      position: relative;
      background: #fff;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid rgba(40,30,20,0.08);
      box-shadow: 0 10px 28px rgba(40,30,20,0.06);
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .price-card:hover {
      box-shadow: 0 16px 38px rgba(40,30,20,0.10);
      transform: translateY(-2px);
    }
    .price-card-stripe {
      height: 6px;
      width: 100%;
    }
    .price-card--navy .price-card-stripe          { background: linear-gradient(90deg, var(--navy-dark) 0%, var(--navy) 100%); }
    .price-card--terracotta .price-card-stripe    { background: linear-gradient(90deg, #c46a3c 0%, var(--terracotta) 100%); }
    .price-card--terracotta-deep .price-card-stripe { background: linear-gradient(90deg, #8a3f1f 0%, var(--terracotta-deep) 100%); }
    .price-card--sage .price-card-stripe          { background: linear-gradient(90deg, #3a5a44 0%, var(--sage) 100%); }
    .price-card--gold .price-card-stripe          { background: linear-gradient(90deg, #b48a36 0%, var(--gold) 100%); }

    .price-card-head {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 18px;
      padding: 26px 28px 18px;
      align-items: start;
    }
    .price-card-icon {
      width: 56px; height: 56px;
      border-radius: 14px;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 28px;
      color: #fff;
      box-shadow: 0 6px 16px rgba(40,30,20,0.18);
    }
    .price-card-icon-button {
      border: 0;
      padding: 0;
      cursor: pointer;
      transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
    }
    .price-card-icon-button:hover {
      transform: translateY(-2px);
      filter: brightness(1.06);
      box-shadow: 0 10px 22px rgba(40,30,20,0.24);
    }
    .price-card-icon-button:focus-visible {
      outline: 3px solid rgba(212,175,86,0.75);
      outline-offset: 3px;
    }
    .price-card--navy .price-card-icon          { background: var(--navy-dark); }
    .price-card--terracotta .price-card-icon    { background: var(--terracotta); }
    .price-card--terracotta-deep .price-card-icon { background: var(--terracotta-deep); }
    .price-card--sage .price-card-icon          { background: #3a5a44; }
    .price-card--gold .price-card-icon          { background: #7a5a18; }

    .price-card-kicker {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--terracotta-deep);
      margin-bottom: 4px;
    }
    .price-card--navy .price-card-kicker     { color: var(--navy); }
    .price-card--sage .price-card-kicker     { color: #3a5a44; }
    .price-card--gold .price-card-kicker     { color: #7a5a18; }
    .price-card-head h2 {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 700;
      color: var(--navy-dark);
      margin: 0 0 4px;
      line-height: 1.15;
    }
    .price-card-sub {
      color: #4a5a6e;
      font-size: 14px;
      line-height: 1.55;
      margin: 4px 0 0;
    }

    /* ===== Price table ===== */
    .price-table {
      width: 100%;
      border-collapse: collapse;
      margin: 4px 0 0;
    }
    .price-table thead th {
      background: rgba(40,30,20,0.03);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      text-align: left;
      padding: 12px 20px;
      color: #6b7a8a;
      border-top: 1px solid rgba(40,30,20,0.07);
      border-bottom: 1px solid rgba(40,30,20,0.07);
    }
    .price-table thead th.num { text-align: right; }
    .price-table tbody td {
      padding: 14px 20px;
      font-size: 14.5px;
      line-height: 1.5;
      color: #2a3140;
      border-bottom: 1px solid rgba(40,30,20,0.06);
      vertical-align: middle;
    }
    .price-table tbody tr:last-child td { border-bottom: 0; }
    .price-table .num { text-align: right; white-space: nowrap; }

    /* Clickable rows — added by JS at runtime when data-prefill is set.
       Cursor, subtle hover, and a fade-in arrow on the first cell so
       the row reads as an actionable element. */
    .price-table tr.price-row-clickable { cursor: pointer; transition: background 0.15s ease; }
    .price-table tr.price-row-clickable td:first-child { position: relative; padding-right: 28px; }
    .price-table tr.price-row-clickable td:first-child::after {
      content: "→";
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translate(-6px, -50%);
      color: var(--terracotta-deep);
      font-weight: 700;
      font-size: 16px;
      opacity: 0;
      transition: opacity 0.15s ease, transform 0.15s ease;
    }
    .price-table tr.price-row-clickable:hover {
      background: rgba(164,91,52,0.05);
    }
    .price-table tr.price-row-clickable:hover td:first-child::after {
      opacity: 1;
      transform: translate(0, -50%);
    }
    .price-table tr.price-row-clickable:focus-visible {
      outline: 2px solid var(--terracotta-deep);
      outline-offset: -2px;
    }
    /* Popular rows keep their warm tint AND show the arrow */
    .price-table tr.price-row-popular.price-row-clickable:hover {
      background: rgba(255,237,210,0.75);
    }
    .price-table .price {
      display: inline-block;
      padding: 4px 12px;
      background: rgba(26,46,74,0.07);
      color: var(--navy-dark);
      border-radius: 999px;
      font-weight: 700;
      font-size: 14px;
      font-feature-settings: 'tnum';
    }
    .price-card--terracotta .price-table .price,
    .price-card--terracotta-deep .price-table .price {
      background: rgba(164,91,52,0.10);
      color: var(--terracotta-deep);
    }
    .price-card--sage .price-table .price {
      background: rgba(125,156,122,0.16);
      color: #2c4633;
    }
    .price-card--gold .price-table .price {
      background: rgba(212,175,86,0.20);
      color: #6f4f10;
    }
    .price-table .gov {
      color: #8a93a3;
      font-size: 13px;
      font-feature-settings: 'tnum';
    }
    .price-table .gov-link {
      color: var(--navy);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 2px;
      white-space: nowrap;
    }
    .price-table .gov-link:hover { color: var(--navy-dark); }
    .price-table .quote {
      font-style: italic;
      color: #6b7a8a;
      font-size: 13px;
    }
    .price-row-popular { background: rgba(255,247,235,0.55); }
    .price-row-popular td:first-child {
      position: relative;
      padding-right: 110px;
    }
    .price-popular-pill {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      background: var(--terracotta-deep);
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 999px;
      white-space: nowrap;
    }
    .price-row-meta {
      display: block;
      font-size: 12.5px;
      color: #6b7a8a;
      font-weight: 400;
      margin-top: 2px;
    }
    .price-table-divider {
      background: rgba(40,30,20,0.04);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #6b7a8a;
      padding: 10px 20px;
    }

    .price-card-disclaimer {
      padding: 14px 28px 24px;
      margin: 0;
      font-size: 12.5px;
      line-height: 1.6;
      color: #6b7a8a;
      background: rgba(40,30,20,0.025);
      border-top: 1px solid rgba(40,30,20,0.06);
    }

    /* ===== Mobile — collapse tables to vertical card rows ===== */
    @media (max-width: 640px) {
      .price-card-head {
        grid-template-columns: 52px 1fr;
        gap: 14px;
        padding: 22px 18px 14px;
      }
      .price-card-icon { width: 48px; height: 48px; font-size: 24px; border-radius: 12px; }
      .price-card-head h2 { font-size: 20px; }
      .price-table thead { display: none; }
      .price-table, .price-table tbody, .price-table tr, .price-table td { display: block; width: 100%; }
      .price-table tr {
        padding: 14px 18px;
        border-bottom: 1px solid rgba(40,30,20,0.06);
      }
      .price-table tr:last-child { border-bottom: 0; }
      .price-table td {
        padding: 4px 0;
        border: 0;
        text-align: left;
      }
      .price-table td.num { text-align: left; }
      .price-row-popular td:first-child { padding-right: 0; }
      .price-popular-pill {
        position: static;
        transform: none;
        display: inline-block;
        margin-top: 6px;
      }
      .price-card-disclaimer { padding: 12px 18px 20px; }
    }

    /* ===== Discounts strip ===== */
    .discounts-strip {
      background: linear-gradient(135deg, #fffaf2 0%, #fff5e8 100%);
      border: 1px solid rgba(164,91,52,0.18);
      border-radius: 18px;
      padding: 32px 30px;
    }
    .discounts-strip-head { text-align: center; margin-bottom: 22px; }
    .discounts-strip-head h2 {
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 700;
      color: var(--navy-dark);
      margin: 0 0 6px;
    }
    .discounts-strip-head p {
      color: #6b7a8a;
      font-size: 14.5px;
      margin: 0;
    }
    .discounts-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    @media (max-width: 860px) { .discounts-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) { .discounts-grid { grid-template-columns: 1fr; } }
    .discount-card {
      background: #fff;
      border-radius: 12px;
      padding: 18px 18px 16px;
      border: 1px solid rgba(40,30,20,0.08);
      box-shadow: 0 6px 16px rgba(40,30,20,0.04);
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
      /* Button reset — these cards are real <button>s for click-to-intake. */
      cursor: pointer;
      font-family: inherit;
      text-align: left;
      width: 100%;
      display: block;
      text-decoration: none;
      color: inherit;
    }
    .discount-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 28px rgba(40,30,20,0.12);
      border-color: rgba(164,91,52,0.30);
    }
    .discount-card:focus-visible {
      outline: 2px solid var(--terracotta-deep);
      outline-offset: 2px;
    }
    .discount-card--b2b {
      background: linear-gradient(135deg, #fff 0%, #f8fbff 100%);
      border-color: rgba(26,46,74,0.22);
      color: inherit;
    }
    .discount-card--b2b:hover {
      border-color: rgba(26,46,74,0.40);
      box-shadow: 0 14px 28px rgba(26,46,74,0.14);
    }
    .discount-card--b2b .discount-title,
    .discount-card--b2b .discount-pct { color: var(--navy-dark); }
    .discount-card--b2b .discount-desc { color: #4a5a6e; }
    .discount-action {
      display: inline-flex;
      align-items: center;
      margin-top: 10px;
      color: var(--terracotta-deep);
      font-weight: 700;
      font-size: 13px;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .discount-pct {
      font-family: var(--font-display);
      font-size: 32px;
      font-weight: 700;
      color: var(--terracotta-deep);
      line-height: 1;
      margin-bottom: 6px;
    }
    .discount-title {
      font-weight: 700;
      font-size: 14.5px;
      color: var(--navy-dark);
      margin-bottom: 4px;
    }
    .discount-desc {
      font-size: 13px;
      line-height: 1.55;
      color: #4a5a6e;
    }

    /* ===== Compare strip ===== */
    .compare-strip {
      background: var(--navy-dark);
      color: #e8eef7;
      border-radius: 18px;
      padding: 36px 30px;
    }
    .compare-strip h2 {
      font-family: var(--font-display);
      color: #fff;
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 6px;
      text-align: center;
    }
    .compare-intro {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 26px;
      color: #c5d1e0;
      font-size: 14.5px;
      line-height: 1.65;
    }
    .compare-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    @media (max-width: 820px) { .compare-grid { grid-template-columns: 1fr; } }
    .compare-col {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 12px;
      padding: 22px 20px;
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }
    .compare-col:hover {
      transform: translateY(-4px);
      border-color: rgba(212,175,86,0.42);
      box-shadow: 0 16px 30px rgba(0,0,0,0.22);
      background: rgba(255,255,255,0.07);
    }
    .compare-col--imverica {
      background: rgba(212,175,86,0.10);
      border-color: var(--gold);
      box-shadow: 0 0 0 1px rgba(212,175,86,0.18) inset, 0 12px 24px rgba(0,0,0,0.18);
    }
    .compare-col--imverica:hover {
      background: rgba(212,175,86,0.14);
    }
    .compare-tier {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: #8a93a3;
      margin-bottom: 4px;
    }
    .compare-tier--featured {
      color: var(--gold);
    }
    .compare-name {
