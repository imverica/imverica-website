---
// "Already using ChatGPT?": what a prepared filing adds over a chat answer.
type Lang = 'en' | 'ru' | 'uk' | 'es';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;

const COPY = {
  en: {
    kicker: 'Already using ChatGPT?',
    heading: 'AI can draft text. What you file is the official form, filled in correctly.',
    intro: 'Chat assistants are useful for questions. What we deliver is different:',
    points: [
      ['The current official edition', 'USCIS and Judicial Council forms change. We fill the edition in effect when you file, not an old PDF.'],
      ['Every answer in its own box', 'Answers go into the exact fields, in the form’s own date and number formats, with extra pages when space runs out.'],
      ['Numbers that add up', 'Totals, related items and required attachments are checked before you sign.'],
      ['A registered, bonded preparer', 'California Legal Document Assistant and Immigration Consultant registration with a bond: someone accountable for the paperwork, in English, Russian, Ukrainian or Spanish.']
    ],
    foot: 'Flat fee agreed before we start. We prepare documents at your direction and do not give legal advice.'
  },
  ru: {
    kicker: 'Уже пользуетесь ChatGPT?',
    heading: 'ИИ напишет текст. А подаёте вы официальную форму, заполненную правильно.',
    intro: 'Чат-боты полезны для вопросов. Мы даём другое:',
    points: [
      ['Актуальная официальная редакция', 'Формы USCIS и Judicial Council меняются. Мы заполняем редакцию, действующую на момент подачи, а не старый PDF.'],
      ['Каждый ответ — в своём поле', 'Ответы стоят в нужных полях, в формате дат и чисел самой формы, с дополнительными страницами, если не хватает места.'],
      ['Цифры сходятся', 'Итоги, связанные пункты и обязательные приложения проверяются до того, как вы подпишете.'],
      ['Зарегистрированный подготовщик с бондом', 'Регистрация Legal Document Assistant и Immigration Consultant в Калифорнии и бонд: за документы отвечает конкретный человек — на русском, украинском, английском или испанском.']
    ],
    foot: 'Цена фиксируется до начала работы. Мы готовим документы по вашим указаниям и не даём юридических консультаций.'
  },
  uk: {
    kicker: 'Уже користуєтеся ChatGPT?',
    heading: 'ШІ напише текст. А подаєте ви офіційну форму, заповнену правильно.',
    intro: 'Чат-боти корисні для запитань. Ми даємо інше:',
    points: [
      ['Чинна офіційна редакція', 'Форми USCIS і Judicial Council змінюються. Ми заповнюємо редакцію, чинну на момент подання, а не старий PDF.'],
      ['Кожна відповідь — у своєму полі', 'Відповіді стоять у потрібних полях, у форматі дат і чисел самої форми, з додатковими сторінками, якщо бракує місця.'],
      ['Цифри сходяться', 'Підсумки, пов’язані пункти й обов’язкові додатки перевіряються до того, як ви підпишете.'],
      ['Зареєстрований підготовник із бондом', 'Реєстрація Legal Document Assistant та Immigration Consultant у Каліфорнії і бонд: за документи відповідає конкретна людина — українською, російською, англійською чи іспанською.']
    ],
    foot: 'Ціну фіксуємо до початку роботи. Ми готуємо документи за вашими вказівками й не надаємо юридичних консультацій.'
  },
  es: {
    kicker: '¿Ya usa ChatGPT?',
    heading: 'La IA redacta texto. Lo que usted presenta es el formulario oficial, bien llenado.',
    intro: 'Los chats sirven para preguntas. Lo que entregamos es otra cosa:',
    points: [
      ['La edición oficial vigente', 'Los formularios de USCIS y del Judicial Council cambian. Llenamos la edición vigente al presentar, no un PDF viejo.'],
      ['Cada respuesta en su casilla', 'Las respuestas van en los campos exactos, con el formato de fechas y números del formulario y hojas adicionales cuando falta espacio.'],
      ['Cifras que cuadran', 'Totales, puntos relacionados y anexos obligatorios se revisan antes de que usted firme.'],
      ['Un preparador registrado y con fianza', 'Registro como Legal Document Assistant e Immigration Consultant en California, con fianza: alguien responde por los documentos, en español, inglés, ruso o ucraniano.']
    ],
    foot: 'Precio fijo acordado antes de empezar. Preparamos documentos según sus instrucciones y no damos asesoría legal.'
  }
}[lang];
---
<section class="ai-section" id="why-not-chatgpt">
  <div class="ai-inner">
    <div class="ai-copy">
      <div class="ai-kicker">{COPY.kicker}</div>
      <h2>{COPY.heading}</h2>
      <p>{COPY.intro}</p>
    </div>
    <div class="ai-grid">
      {COPY.points.map(([title, body]) => (
        <article class="ai-card">
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
    <p class="ai-foot">{COPY.foot}</p>
  </div>
</section>

<style>
  .ai-section {
    background: #fff;
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
    padding: var(--space-section) 1.5rem;
  }
  .ai-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(340px, 1.2fr);
    gap: 28px 32px;
    align-items: start;
  }
  .ai-kicker {
    color: var(--terracotta-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .ai-copy h2 { font-size: var(--fs-h2); margin-bottom: 14px; text-wrap: balance; }
  .ai-copy p, .ai-card p { color: #3a4a5e; font-size: 15px; line-height: 1.7; margin: 0; }
  .ai-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .ai-card {
    background: var(--paper-alt, #f5f5f7);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
    padding: 20px;
  }
  .ai-card h3 { font-family: var(--font-system); font-size: 17px; font-weight: 700; margin: 0 0 8px; }
  .ai-foot { grid-column: 1 / -1; color: var(--muted, #6b7280); font-size: 13px; margin: 0; }
  @media (max-width: 820px) {
    .ai-inner, .ai-grid { grid-template-columns: 1fr; }
    .ai-section { padding: var(--space-section) 1.25rem; }
  }
</style>
