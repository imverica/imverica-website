  '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `${canonical}#faq`,
  mainEntity: T.faqs.map(([question, answer]) => ({
    '@type': 'Question', name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---
<BaseLayout title={T.title} description={T.description} canonical={canonical} slug={slug}
  lang={lang} availableLocales={['en', 'ru', 'uk', 'es']} jsonLd={[serviceSchema, faqSchema]}>
  <Hero lang={lang} eyebrow={T.eyebrow} heading={T.heading} sub={T.hero}
    ctaPrimary={{ href: intakeHref, text: T.start }} />
  <LandingBody lang={lang} related={[
    { href: `${prefix}/i-765-work-permit-help`, label: T.related[0] },
    { href: `${prefix}/uscis-document-review`, label: T.related[1] },
    { href: `${prefix}/lda`, label: T.related[2] }
  ]}>
    <p class="lead">{T.lead}</p>
    <h2>{T.officialHeading}</h2><p>{T.officialText}</p>
    <h2>{T.scopeHeading}</h2>
    <div class="form-list"><ul>{T.scope.map(([label, text]) => <li><strong>{label}:</strong> {text}</li>)}</ul></div>
    <h2>{T.limitsHeading}</h2><ul>{T.limits.map((item) => <li>{item}</li>)}</ul>
    <h2>{T.attorneyHeading}</h2><p>{T.attorneyText}</p>
    <h2>{T.processHeading}</h2><ol>{T.process.map(([label, text]) => <li><strong>{label}.</strong> {text}</li>)}</ol>
    <h2>{T.faqHeading}</h2>
    {T.faqs.map(([question, answer]) => <section class="u4u-faq"><h3>{question}</h3><p>{answer}</p></section>)}
    <h2>{T.sourcesHeading}</h2><p>{T.sourcesIntro}</p>
    <ul>
      <li><a href="https://www.uscis.gov/ukraine">USCIS — Ukraine</a></li>
      <li><a href="https://www.uscis.gov/forms/all-forms">USCIS — All Forms</a></li>
      <li><a href="https://www.uscis.gov/g-1055">USCIS — Fee Schedule (Form G-1055)</a></li>
      <li><a href="https://www.uscis.gov/scams-fraud-and-misconduct/avoid-scams/find-legal-services">USCIS — Find Legal Services</a></li>
    </ul>
    <cite>Official links reviewed November 14, 2026. Imverica is not a law firm and provides only client-directed document preparation to California consumers.</cite>
  </LandingBody>
  <CTAStrip lang={lang} heading={T.ctaHeading} sub={T.ctaSub}
    primaryHref={intakeHref} primaryText={T.start} />
</BaseLayout>

<style is:global>
  .u4u-faq { margin: 0 0 18px; padding: 18px 20px; background: #fffaf2; border: 1px solid rgba(40,30,20,0.08); border-radius: 10px; }
  .u4u-faq h3 { margin: 0 0 7px; color: var(--navy-dark); }
  .u4u-faq p { margin: 0; }
</style>
