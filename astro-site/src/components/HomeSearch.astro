    'DEMAND-LETTER': { en: 'Pre-suit Demand Letter', ru: 'Досудебная претензия', uk: 'Досудова претензія', es: 'Carta de Demanda Previa' },
    'TRANSLATION': { en: 'Certified Document Translation', ru: 'Заверенный перевод документа', uk: 'Засвідчений переклад документа', es: 'Traducción Certificada' },
    'NOTARY': { en: 'Notary Service', ru: 'Нотариальное заверение', uk: 'Нотаріальне засвідчення', es: 'Servicio de notary public' },
    'G-639': { en: 'FOIA — USCIS Records Request', ru: 'FOIA — запрос иммиграционных записей', uk: 'FOIA — запит імміграційних записів', es: 'FOIA — Solicitud de Archivo USCIS' },
    'NC-100': { en: 'Legal Name Change (California)', ru: 'Юридическая смена имени (Калифорния)', uk: 'Юридична зміна імені (Каліфорнія)', es: 'Cambio Legal de Nombre' },
    'DMV': { en: 'California DMV forms (license | title)', ru: 'Документы DMV Калифорнии (права | тайтл)', uk: 'Документи DMV Каліфорнії (права | тайтл)', es: 'Formularios DMV de California' },
    'DS-11': { en: 'U.S. Passport (new)', ru: 'Паспорт США (новый)', uk: 'Паспорт США (новий)', es: 'Pasaporte de EE. UU. (nuevo)' },
    'DS-82': { en: 'U.S. Passport (renewal)', ru: 'Паспорт США (продление)', uk: 'Паспорт США (поновлення)', es: 'Pasaporte de EE. UU. (renovación)' }
  };

  // Per-language sentence templates so the answer feels native, not
  // machine-translated. Plain text — no HTML — the page renders them.
  // Informational framing only — an LDA/Immigration Consultant may NOT tell a
  // client which form they "need" (that is choosing the form for them = UPL).
  // Present forms as commonly-associated options; the client decides; always
  // carry the not-legal-advice line.
  // A form is shown only when the visitor wrote its number: confirm their
  // choice with the official name, without saying it fits their situation.
  const ANSWER_TEMPLATE: Record<string, string> = {
    en: 'You chose <strong>{form}</strong> — {name}. Press Continue and we will prepare it at your direction. General information, not legal advice.',
    ru: 'Вы выбрали форму <strong>{form}</strong> — {name}. Нажмите «Продолжить», и мы подготовим её по вашему указанию. Общая информация, не юридическая консультация.',
    uk: 'Ви обрали форму <strong>{form}</strong> — {name}. Натисніть «Продовжити», і ми підготуємо її за вашою вказівкою. Загальна інформація, не юридична консультація.',
    es: 'Usted eligió el formulario <strong>{form}</strong> — {name}. Pulse Continuar y lo prepararemos bajo su dirección. Información general, no asesoría legal.'
  };
  const LOW_CONFIDENCE_TEMPLATE: Record<string, string> = ANSWER_TEMPLATE;

  function setResult(html: string, open = true) {
    if (!result) return;
    result.innerHTML = html;
    result.classList.toggle('open', open);
  }

  // Escaped text with the phone number and email as tel: / mailto: links.
  function linkify(html: string) {
    return html
      .replace(/(?:\+?1[\s.-]?)?\(?916\)?[\s.-]?399[\s.-]?3992/g, (m) => `<a href="tel:+19163993992">${m}</a>`)
      .replace(/info@imverica\.com/gi, (m) => `<a href="mailto:info@imverica.com">${m}</a>`);
  }
  function escapeHtml(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[character] || character));
  }

  // No form number in the request: point to the official pages for the
  // topic the visitor named and to the official form directories. The
  // visitor picks the form there and comes back with its number; we never
  // pick a form from a description (Cal. Bus. & Prof. Code § 6400(g)).
