    en: {
      lead: 'Choose your form there (opens in a new tab) and enter its number here:',
      topics: 'Official information on this topic',
      directories: 'Official form lists',
      numberLabel: 'Form number you chose',
      numberPlaceholder: 'e.g. {ex}',
      start: 'Start preparing',
      badNumber: 'Please enter a form number, for example {ex}.',
