    },
    es: {
      checking: 'Revisando posibles formularios...',
      countyQuestion: '¿En qué condado de California presentará los documentos?',
      countyHelp: 'Los formularios locales del Superior Court varían por condado. Seleccione el tribunal de presentación.',
      countyPlaceholder: 'Seleccione el condado',
      countyContinue: 'Revisar formularios locales',
