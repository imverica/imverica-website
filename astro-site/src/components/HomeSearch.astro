      back: 'You searched: «{q}». Chose your form? Enter its number:',
      hide: 'Hide',
      startShort: 'Start'
    },
    ru: {
      lead: 'Выберите там свою форму (откроется в новой вкладке) и введите её номер здесь:',
      topics: 'Официальная информация по теме',
      directories: 'Официальные списки форм',
      numberLabel: 'Номер выбранной формы',
      numberPlaceholder: 'например, {ex}',
      start: 'Начать подготовку',
      badNumber: 'Введите номер формы, например {ex}.',
      callback: 'Удобнее поговорить? Оставьте телефон',
      freeHelp: 'Бесплатная помощь с выбором',
      note: 'Общая информация, не юридическая консультация. Imverica готовит выбранную вами форму и не является юридической фирмой.',
      resume: 'Вы смотрели',
      back: 'Вы искали: «{q}». Выбрали форму? Введите её номер:',
      hide: 'Скрыть',
      startShort: 'Начать'
    },
    uk: {
      lead: 'Оберіть там свою форму (відкриється в новій вкладці) і введіть її номер тут:',
      topics: 'Офіційна інформація за темою',
      directories: 'Офіційні списки форм',
      numberLabel: 'Номер обраної форми',
      numberPlaceholder: 'наприклад, {ex}',
      start: 'Почати підготовку',
      badNumber: 'Введіть номер форми, наприклад {ex}.',
      callback: 'Зручніше поговорити? Залиште телефон',
      freeHelp: 'Безкоштовна допомога з вибором',
      note: 'Загальна інформація, не юридична консультація. Imverica готує обрану вами форму і не є юридичною фірмою.',
      resume: 'Ви переглядали',
      back: 'Ви шукали: «{q}». Обрали форму? Введіть її номер:',
      hide: 'Сховати',
      startShort: 'Почати'
    },
    es: {
      lead: 'Elija allí su formulario (se abre en una pestaña nueva) y escriba su número aquí:',
      topics: 'Información oficial sobre este tema',
      directories: 'Listas oficiales de formularios',
      numberLabel: 'Número del formulario que eligió',
      numberPlaceholder: 'p. ej. {ex}',
      start: 'Empezar la preparación',
      badNumber: 'Escriba un número de formulario, por ejemplo {ex}.',
      callback: '¿Prefiere hablar? Deje su teléfono',
      freeHelp: 'Ayuda gratuita para elegir',
      note: 'Información general, no asesoría legal. Imverica prepara el formulario que usted elige y no es un bufete de abogados.',
      resume: 'Estaba viendo',
      back: 'Usted buscó: «{q}». ¿Ya eligió su formulario? Escriba su número:',
      hide: 'Ocultar',
      startShort: 'Empezar'
    }
  };
  const PENDING_KEY = 'imv-finder-pending';
  type NavLink = { id?: string; url: string; label: string };
  function navLinks(items: NavLink[]) {
    return items.map((i) => `<li><a href="${escapeHtml(i.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(i.label)} ↗</a></li>`).join('');
  }
  function renderNavigation(routeData: any, lang: string, query = '') {
    const n = NAV_T[lang] || NAV_T.en;
    const nav = routeData?.navigation || {};
    const topics: NavLink[] = Array.isArray(nav.topics) ? nav.topics : [];
    const dirs: NavLink[] = Array.isArray(nav.directories) ? nav.directories : [];
    const help: NavLink[] = Array.isArray(nav.freeHelp) ? nav.freeHelp : [];
    const example = String(nav.example || 'G-1145 | POS-010').replace(' | ', lang === 'en' ? ' or ' : lang === 'es' ? ' o ' : lang === 'uk' ? ' або ' : ' или ');
    setResult(`
      <ul class="ai-nav-list ai-nav-first">${navLinks([...topics, ...dirs])}</ul>
      <p class="ai-nav-lead">${escapeHtml(n.lead)}</p>
      <form class="ai-nav-form" data-ai-nav-form>
        <label>${escapeHtml(n.numberLabel)}
          <input type="text" name="code" autocomplete="off" spellcheck="false" placeholder="${escapeHtml(n.numberPlaceholder.replace('{ex}', example))}" />
        </label>
        <button type="submit" class="dark">${escapeHtml(n.start)}</button>
      </form>
      <p class="ai-nav-error" data-ai-nav-error hidden>${escapeHtml(n.badNumber.replace('{ex}', example))}</p>
      <div class="ai-result-actions">
        <button type="button" data-ai-callback>${escapeHtml(n.callback)}</button>
        <a href="tel:+19163993992">${(labels as any)[lang]?.call || labels.en.call}</a>
      </div>
      ${help.length ? `<p class="ai-nav-small">${escapeHtml(n.freeHelp)}: ${help.map((h) => `<a href="${escapeHtml(h.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(h.label)}</a>`).join(' · ')}</p>` : ''}
      <p class="ai-nav-small">${escapeHtml(n.note)}</p>
    `);
    const formEl = result?.querySelector('[data-ai-nav-form]') as HTMLFormElement | null;
    formEl?.addEventListener('submit', (event) => {
      event.preventDefault();
      const code = String((formEl.elements.namedItem('code') as HTMLInputElement)?.value || '').trim();
      const err = result?.querySelector('[data-ai-nav-error]') as HTMLElement | null;
      if (!/^[A-Za-z]{1,5}[\s._-]?\d{1,4}[A-Za-z]{0,4}$/.test(code)) { if (err) err.hidden = false; return; }
      if (err) err.hidden = true;
      try { localStorage.removeItem(PENDING_KEY); } catch { /* ignore */ }
      submitQuery(code);
    });
    result?.querySelector('[data-ai-callback]')?.addEventListener('click', () => {
      const w = window as Window & { openQuickIntake?: () => void };
      if (typeof w.openQuickIntake === 'function') w.openQuickIntake();
      else window.location.href = 'tel:+19163993992';
    });
  }
  // Nothing from an earlier visit is shown: the finder opens empty every
  // time. Older versions saved the last search; forget it.
  function forgetSavedSearch() {
    try { localStorage.removeItem(PENDING_KEY); } catch { /* storage may be blocked */ }
  }

  function renderIntentPrompt(query: string, routeData: any, lang: keyof typeof labels) {
    const t = labels[lang] || labels.en;
    const options = Array.isArray(routeData?.intentOptions) ? routeData.intentOptions : [];
    setResult(`
      <div class="ai-intent-step">
        <h3>${t.intentQuestion}</h3>
        <p>${t.intentHelp}</p>
        <div class="ai-intent-options">
          ${options.map((option: any) => `
            <button type="button" data-ai-intent="${escapeHtml(option.id)}">
              <strong>${escapeHtml(option.label)}</strong>
              <span>${escapeHtml(option.description)}</span>
            </button>
          `).join('')}
        </div>
      </div>
    `);
    result?.querySelectorAll('[data-ai-intent]').forEach((button) => {
      button.addEventListener('click', () => {
        const intent = button.getAttribute('data-ai-intent') || '';
        if (intent) submitQuery(query, '', intent);
      });
    });
  }

  function renderCountyPrompt(query: string, routeData: any, lang: keyof typeof labels, intent = '') {
    const t = labels[lang] || labels.en;
    const counties = Array.isArray(routeData?.counties) ? routeData.counties : [];
    const mismatch = routeData?.countyMismatch ? `<p class="ai-county-warning">${t.countyMismatch}</p>` : '';
    const options = counties.map((county: any) =>
      `<option value="${escapeHtml(county.slug)}">${escapeHtml(county.name)} County</option>`
    ).join('');
    setResult(`
      ${mismatch}
      <div class="ai-county-step">
        <label for="aiCountySelect">${t.countyQuestion}</label>
        <p>${t.countyHelp}</p>
        <div class="ai-county-controls">
          <select id="aiCountySelect" data-ai-county>
            <option value="">${t.countyPlaceholder}</option>
            ${options}
          </select>
          <button type="button" class="dark" data-ai-county-continue disabled>${t.countyContinue}</button>
        </div>
      </div>
    `);
    const select = result?.querySelector('[data-ai-county]') as HTMLSelectElement | null;
    const button = result?.querySelector('[data-ai-county-continue]') as HTMLButtonElement | null;
    select?.addEventListener('change', () => { if (button) button.disabled = !select.value; });
    button?.addEventListener('click', () => { if (select?.value) submitQuery(query, select.value, intent); });
  }

  // Fire-and-forget analytics beacon — never blocks or breaks the UX.
  // What the visitor typed is never sent: only the language, the page and a
  // recognised form number (the server drops anything else too).
  const FORM_CODE_RE = /^[A-Z]{1,5}-\d{1,4}[A-Z]{0,4}$/;
  function logSearchEvent(type: 'search' | 'start', query: string, formCode: string, confidence: number) {
    try {
      const code = String(formCode || '').trim().toUpperCase();
      const payload = JSON.stringify({ type, lang: detectLang(query), page: location.pathname, formCode: FORM_CODE_RE.test(code) ? code : '', confidence });
      if (navigator.sendBeacon) navigator.sendBeacon('/api/analytics', new Blob([payload], { type: 'application/json' }));
      else fetch('/api/analytics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
    } catch { /* analytics must never break search */ }
  }

  // "Continue" opens the question-by-question wizard (wizard.ts) with what
  // the visitor typed; it finds a form number in the text itself. A form the
  // router recognized from words alone ("divorce" -> FL-100) is passed as
  // the form.
  function continueToWizard(query: string, formCode = '') {
    logSearchEvent('start', query, formCode, 0);
    const opener = (window as Window & { openIntakeModal?: (prefill?: string, mode?: string) => void }).openIntakeModal;
    if (typeof opener === 'function') {
      if (formCode && !query.toUpperCase().includes(formCode)) opener(formCode, 'form');
      else opener(query);
      return;
    }
    window.location.hash = 'get-started';
  }

  async function submitQuery(query: string, county = '', intent = '') {
    const lang = detectLang(query);
    const t = labels[lang] || labels.en;
    setResult(`<p>${t.checking}</p>`);

    // Primary: our deterministic catalog router (/api/route). 35 multilang
    // rules cover all major USCIS / family / civil / business /
    // probate forms — runs in <100ms, no AI cost, never times out. We
    // ALSO kick off the chat call in parallel so we can append an AI
    // explanation paragraph when it succeeds, but if chat 502s the user
    // still gets a working answer.
    const routePromise = fetch(routeEndpoint(query, county, intent), {
      headers: { 'Accept': 'application/json' }
    }).then((r) => (r.ok ? r.json() : null)).catch(() => null);

    const routeData = await routePromise;
    // Relief we don't prepare (felony reduction, record sealing, Prop 64):
    // say so plainly and offer a call, no intake.
    if (routeData?.attorneyOnly) {
      logSearchEvent('search', query, '', 0);
      // A Spanish query without accents reads as English: fall back to the
      // page language for the note.
      const pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      const noteLang = lang !== 'en' ? lang : (['ru', 'uk', 'es'].includes(pageLang) ? pageLang : 'en');
      const note = routeData.messages?.[noteLang] || routeData.message || '';
      setResult(`
        <p>${linkify(escapeHtml(note))}</p>
        <div class="ai-result-actions">
          <a href="https://t.me/imverica" target="_blank" rel="noopener">${t.telegram}</a>
          <a href="tel:+19163993992">${t.call}</a>
        </div>
      `);
      return;
    }
    if (routeData?.clientMustChoose || (routeData && !routeData?.route?.formCode && !routeData?.needsCounty && !routeData?.needsIntent)) {
      logSearchEvent('search', query, '', 0);
      renderNavigation(routeData, lang, query);
      return;
    }
    if (routeData?.needsIntent) {
      renderIntentPrompt(query, routeData, lang);
      return;
    }
    if (routeData?.needsCounty) {
      renderCountyPrompt(query, routeData, lang, intent);
      return;
    }
    const countyName = String(routeData?.county?.name || routeData?.route?.county || '').trim();
    const countySlug = String(routeData?.county?.slug || routeData?.route?.countySlug || '').trim();
    if (countySlug) {
      try {
        localStorage.setItem('imverica_court_county', countySlug);
        localStorage.setItem('imverica_court_route', JSON.stringify({
          county: countyName,
          countySlug,
          formCode: routeData?.route?.formCode || '',
          localFormId: routeData?.route?.localFormId || ''
        }));
      } catch { /* Storage may be unavailable in privacy-restricted browsers. */ }
    } else {
      try {
        localStorage.removeItem('imverica_court_route');
      } catch { /* Storage may be unavailable in privacy-restricted browsers. */ }
    }
    const enrichedQuery = countyName ? `${query}\nFiling county: ${countyName} County, California.` : query;
    if (routeData?.route?.flowStatus === 'county-known-no-local-form') {
      logSearchEvent('search', query, '', Number(routeData?.route?.confidence || 0));
      const countyLine = countyName ? `<p class="ai-result-county">${t.filingCourt}: <strong>${escapeHtml(countyName)} County Superior Court</strong></p>` : '';
      setResult(`
        <p><strong>${t.noLocalTitle}</strong></p>
        <p>${t.noLocalHelp}</p>
        ${countyLine}
        <div class="ai-result-actions">
          <button type="button" class="dark" data-ai-continue>${t.continue}</button>
          <a href="https://t.me/imverica" target="_blank" rel="noopener">${t.telegram}</a>
          <a href="tel:+19163993992">${t.call}</a>
        </div>
      `);
      result?.querySelector('[data-ai-continue]')?.addEventListener('click', () => continueToWizard(enrichedQuery));
      return;
    }
    const chatPromise = fetch(chatEndpoint(), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: [{ role: 'user', content: enrichedQuery }] })
    }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
    const formCode = String(routeData?.route?.formCode || '').toUpperCase();
    const confidence = Number(routeData?.route?.confidence || 0);
    logSearchEvent('search', query, formCode, confidence);
    const matched = FORM_NAMES[formCode];
    const routedTitle = String(routeData?.route?.formTitle || '').trim();

    if (formCode && (matched || routedTitle)) {
      const tmpl = confidence >= 0.7 ? ANSWER_TEMPLATE[lang] : LOW_CONFIDENCE_TEMPLATE[lang];
      const name = matched
        ? (matched[lang as 'en' | 'ru' | 'uk' | 'es'] || matched.en)
        : routedTitle;
      const headline = (tmpl || ANSWER_TEMPLATE.en)
        .replace('{form}', formCode)
        .replace('{name}', name);

      // Render the catalog answer immediately, then asynchronously append
      // the AI elaboration once chat finishes (if it ever does).
      const countyLine = countyName ? `<p class="ai-result-county">${t.filingCourt}: <strong>${escapeHtml(countyName)} County Superior Court</strong></p>` : '';
      setResult(`
        <p>${headline}</p>
        ${countyLine}
        <p id="aiExtra" class="ai-result-extra"></p>
        <div class="ai-result-actions">
          <button type="button" class="dark" data-ai-continue>${t.continue}</button>
          <a href="https://t.me/imverica" target="_blank" rel="noopener">${t.telegram}</a>
          <a href="tel:+19163993992">${t.call}</a>
        </div>
      `);
      result?.querySelector('[data-ai-continue]')?.addEventListener('click', () => continueToWizard(enrichedQuery, formCode));

      const chatData = await chatPromise;
      const reply = String(chatData?.reply || '').trim();
      const extra = document.getElementById('aiExtra');
      if (reply && extra) extra.innerHTML = linkify(escapeHtml(reply)).replace(/\n/g, '<br>');
      return;
    }

    // Catalog router couldn't identify the form — fall back to chat-only.
    const chatData = await chatPromise;
    const answer = String(chatData?.reply || chatData?.answer || '').trim();
    if (answer) {
      setResult(`
        <p>${linkify(escapeHtml(answer)).replace(/\n/g, '<br>')}</p>
        <div class="ai-result-actions">
          <button type="button" class="dark" data-ai-continue>${t.continue}</button>
          <a href="https://t.me/imverica" target="_blank" rel="noopener">${t.telegram}</a>
          <a href="tel:+19163993992">${t.call}</a>
        </div>
      `);
      result?.querySelector('[data-ai-continue]')?.addEventListener('click', () => continueToWizard(enrichedQuery));
      return;
    }

    // Both router and chat returned nothing usable — last-resort error.
    setResult(`<p>${t.error}</p>`);
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value?.trim();
    if (!query) return;
    submitQuery(query);
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  document.querySelectorAll('[data-ai-example]').forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.getAttribute('data-ai-example') || '';
      if (input) input.value = value;
      submitQuery(value);
    });
  });

  forgetSavedSearch();
</script>
