    ],
    sourcesHeading: 'Fuentes oficiales que debe verificar',
    sourcesIntro: 'Enlaces oficiales de USCIS revisados el 14 de noviembre de 2026. Su contenido vigente controla; verifíquelo de nuevo inmediatamente antes de presentar.',
    ctaHeading: '¿Ya eligió el documento relacionado con TPS?',
    ctaSub: 'Indique el formulario, la categoría y el alcance exactos que eligió. Confirmamos por escrito la tarifa y el plazo estimado después de la entrevista completa.'
  }
} as const;

const T = COPY[lang];
const canonical = `https://imverica.com${prefix}${slug}`;
const intakeHref = `${prefix}/#get-started`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: T.heading,
  serviceType: 'Client-directed TPS-related document preparation',
  url: canonical,
  provider: { '@id': 'https://imverica.com/#organization' },
  areaServed: { '@type': 'State', name: 'California' },
  audience: { '@type': 'Audience', audienceType: 'California self-represented consumers who already selected the requested forms and documents' },
  availableLanguage: ['English', 'Russian', 'Ukrainian', 'Spanish'],
  description: T.description
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: T.faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---
<BaseLayout
  title={T.title}
  description={T.description}
  canonical={canonical}
  slug={slug}
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Hero
    lang={lang}
    eyebrow={T.eyebrow}
    heading={T.heading}
    sub={T.hero}
    ctaPrimary={{ href: intakeHref, text: T.start }}
  />

  <LandingBody lang={lang} related={[
    { href: `${prefix}/i-765-work-permit-help`, label: 'I-765 — Employment Authorization' },
    { href: `${prefix}/uscis-document-review`, label: 'USCIS clerical completeness check' },
    { href: `${prefix}/lda`, label: 'California Legal Document Assistant' }
  ]}>
    <p class="lead">{T.lead}</p>

    <h2>{T.currentHeading}</h2>
    <p>{T.currentP1}</p>
    <p>{T.currentP2}</p>

    <h2>{T.scopeHeading}</h2>
    <div class="form-list">
      <ul>{T.scope.map(([label, text]) => <li><strong>{label}:</strong> {text}</li>)}</ul>
    </div>

    <h2>{T.limitsHeading}</h2>
    <ul>{T.limits.map((item) => <li>{item}</li>)}</ul>

    <h2>{T.processHeading}</h2>
    <ol>{T.process.map(([label, text]) => <li><strong>{label}.</strong> {text}</li>)}</ol>

    <h2>{T.faqHeading}</h2>
    {T.faqs.map(([question, answer]) => (
      <section class="tps-faq">
        <h3>{question}</h3>
        <p>{answer}</p>
      </section>
    ))}

    <h2>{T.sourcesHeading}</h2>
    <p>{T.sourcesIntro}</p>
    <ul>
      <li><a href="https://www.uscis.gov/humanitarian/temporary-protected-status">USCIS — Temporary Protected Status hub</a></li>
      <li><a href="https://www.uscis.gov/i-821">USCIS — Form I-821</a></li>
      <li><a href="https://www.uscis.gov/i-765">USCIS — Form I-765</a></li>
      <li><a href="https://www.uscis.gov/sites/default/files/document/forms/g-1055.pdf">USCIS — Form G-1055 Fee Schedule (PDF)</a></li>
      <li><a href="https://www.uscis.gov/scams-fraud-and-misconduct/avoid-scams/find-legal-services">USCIS — Find Legal Services</a></li>
    </ul>
    <cite>
      Official source links were reviewed on November 14, 2026. Imverica is not a law firm and does not provide legal advice. Documents are prepared only at the client’s specific direction.
    </cite>
  </LandingBody>

  <CTAStrip
    lang={lang}
    heading={T.ctaHeading}
    sub={T.ctaSub}
    primaryHref={intakeHref}
    primaryText={T.start}
  />
</BaseLayout>

<style is:global>
  .tps-faq { margin: 0 0 18px; padding: 18px 20px; background: #fffaf2; border: 1px solid rgba(40,30,20,0.08); border-radius: 10px; }
  .tps-faq h3 { margin: 0 0 7px; color: var(--navy-dark); }
  .tps-faq p { margin: 0; }
</style>
