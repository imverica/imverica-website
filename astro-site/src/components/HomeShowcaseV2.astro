---
/**
 * v2 homepage showcase, after apple.com:
 *  1. two big tiles — USCIS | EOIR and California Courts — each with its
 *     sections underneath as smaller tiles;
 *  2. a slider ("Endless entertainment" layout): wide slides that move
 *     right to left with the neighbours peeking in, dots and a pause
 *     button, then an endless row of form cards.
 * Replaces the services block on the four homepages, inside
 * <template data-v2-new="services"> (see V2Swap). Behaviour:
 * scripts/showcase-v2.ts. Form names stay in English; other languages get
 * the translation in parentheses.
 */
import { localizedPathSafe, type Locale } from '~/data/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const L = (en: string, ru: string, uk: string, es: string) => ({ en, ru, uk, es }[lang]);
const path = (slug: string) => localizedPathSafe(lang, slug);
const start = (q: string) => `#get-started${q ? '?' + q : ''}`;
// English form name; elsewhere "English (translation)".
const formName = (en: string, ru: string, uk: string, es: string) => (lang === 'en' ? en : `${en} (${L(en, ru, uk, es)})`);

const T = {
  more: L('Learn more', 'Подробнее', 'Детальніше', 'Más información'),
  start: L('Start', 'Начать', 'Почати', 'Empezar'),
  all: L('See all', 'Все разделы', 'Усі розділи', 'Ver todo')
};

const groups = [
  {
    id: 'hs-uscis',
    dark: true,
    title: 'USCIS | EOIR',
    sub: L('Immigration forms, prepared at your direction.', 'Иммиграционные формы — по вашему поручению.', 'Імміграційні форми — за вашим дорученням.', 'Formularios de inmigración, preparados bajo su dirección.'),
    note: L('Green card, work permit, citizenship, asylum, immigration court.', 'Грин-карта, разрешение на работу, гражданство, убежище, иммиграционный суд.', 'Грін-карта, дозвіл на роботу, громадянство, притулок, імміграційний суд.', 'Green card, permiso de trabajo, ciudadanía, asilo, corte de inmigración.'),
    more: { href: path('/immigration'), label: T.more },
    startQ: '',
    images: ['/img/forms/i-485-page-1'],
    sheets: ['N-400', 'I-765'],
    tiles: [
      { code: 'I-485', title: L('Green Card', 'Грин-карта', 'Грін-карта', 'Green Card'), sub: formName('Adjustment of Status', 'корректировка статуса', 'коригування статусу', 'ajuste de estatus'), href: path('/i-485-help'), q: 'form=I-485' },
      { code: 'I-765', title: L('Work Permit | EAD', 'Разрешение на работу | EAD', 'Дозвіл на роботу | EAD', 'Permiso de trabajo | EAD'), sub: formName('Employment Authorization', 'разрешение на работу', 'дозвіл на роботу', 'autorización de empleo'), href: path('/i-765-work-permit-help'), q: 'form=I-765' },
      { code: 'N-400', title: L('Citizenship', 'Гражданство', 'Громадянство', 'Ciudadanía'), sub: formName('Application for Naturalization', 'заявление о натурализации', 'заява про натуралізацію', 'solicitud de naturalización'), href: path('/n-400-citizenship-help'), q: 'form=N-400' },
      { code: 'I-130', title: L('Family Petition', 'Семейная петиция', 'Сімейна петиція', 'Petición familiar'), sub: formName('Petition for Alien Relative', 'петиция для родственника', 'петиція для родича', 'petición para familiar'), href: path('/i-130-family-petition'), q: 'form=I-130' },
      { code: 'I-589', title: L('Asylum', 'Убежище', 'Притулок', 'Asilo'), sub: formName('Application for Asylum', 'заявление об убежище', 'заява про притулок', 'solicitud de asilo'), href: path('/i-589-asylum-help'), q: 'form=I-589' },
      { code: 'EOIR', title: L('Immigration Court', 'Иммиграционный суд', 'Імміграційний суд', 'Corte de inmigración'), sub: 'EOIR-28 | 42A | 42B', href: path('/eoir-immigration-court'), q: 'topic=EOIR' }
    ]
  },
  {
    id: 'hs-courts',
    dark: false,
    title: L('California Courts', 'Суды Калифорнии', 'Суди Каліфорнії', 'Tribunales de California'),
    sub: L('Court forms you file yourself, prepared by us.', 'Судебные формы, которые вы подаёте сами, — готовим мы.', 'Судові форми, які ви подаєте самі, — готуємо ми.', 'Formularios judiciales que usted presenta; nosotros los preparamos.'),
    note: L('Family law, restraining orders, small claims, eviction, probate, record clearing.', 'Семейное право, защитные ордера, малые иски, выселение, наследство, снятие судимости.', 'Сімейне право, захисні ордери, малі позови, виселення, спадщина, зняття судимості.', 'Derecho familiar, órdenes de restricción, reclamos menores, desalojo, sucesión, antecedentes penales.'),
    more: { href: '#hs-courts-tiles', label: T.all },
    startQ: '',
    images: ['/img/forms/fl-100-page-1', '/img/forms/sc-100-page-1'],
    sheets: [],
    tiles: [
      { code: 'FL-100', title: L('Divorce', 'Развод', 'Розлучення', 'Divorcio'), sub: formName('Dissolution of Marriage', 'расторжение брака', 'розірвання шлюбу', 'disolución del matrimonio'), href: path('/fl'), q: 'form=FL-100' },
      { code: 'DV-100', title: L('Restraining Orders', 'Защитные ордера', 'Захисні ордери', 'Órdenes de restricción'), sub: formName('Domestic Violence Restraining Order', 'ордер о защите от домашнего насилия', 'захисний ордер від домашнього насильства', 'orden de restricción por violencia doméstica'), href: path('/california-restraining-orders'), q: 'form=DV-100' },
      { code: 'SC-100', title: L('Small Claims', 'Малые иски', 'Малі позови', 'Reclamos menores'), sub: formName("Plaintiff's Claim", 'иск истца', 'позов позивача', 'reclamo del demandante'), href: path('/sc'), q: 'form=SC-100' },
      { code: 'UD-100', title: L('Eviction', 'Выселение', 'Виселення', 'Desalojo'), sub: formName('Unlawful Detainer', 'иск о выселении', 'позов про виселення', 'demanda de desalojo'), href: path('/california-unlawful-detainer'), q: 'form=UD-100' },
      { code: 'DE-111', title: L('Probate', 'Наследство', 'Спадщина', 'Sucesión'), sub: formName('Petition for Probate', 'заявление о наследовании', 'заява про спадкування', 'petición de sucesión'), href: path('/california-probate'), q: 'form=DE-111' },
      { code: 'CR-180', title: L('Record Clearing', 'Снятие судимости', 'Зняття судимості', 'Limpiar antecedentes'), sub: formName('Petition for Dismissal', 'ходатайство о прекращении дела', 'клопотання про закриття справи', 'petición de desestimación'), href: lang === 'en' ? '/criminal' : path('/california-expungement'), q: 'form=CR-180' }
    ]
  }
];

const slides = [
  { tone: 'navy', title: L('Green Card', 'Грин-карта', 'Грін-карта', 'Green Card'), images: ['/img/forms/i-485-page-1'], sheets: [], pill: `${T.start} | I-485`, q: 'form=I-485',
    text: L('Green card | I-485: the full adjustment packet, assembled at your direction.', 'Грин-карта | I-485: полный пакет на корректировку статуса — по вашему поручению.', 'Грін-карта | I-485: повний пакет на коригування статусу — за вашим дорученням.', 'Green card | I-485: el paquete completo de ajuste, armado bajo su dirección.') },
  { tone: 'slate', title: L('Divorce', 'Развод', 'Розлучення', 'Divorcio'), images: ['/img/forms/fl-100-page-1'], sheets: [], pill: `${T.start} | FL-100`, q: 'form=FL-100',
    text: L('Divorce in California | FL-100: your papers, ready for you to file.', 'Развод в Калифорнии | FL-100: документы готовы, подаёте вы сами.', 'Розлучення в Каліфорнії | FL-100: документи готові, подаєте ви самі.', 'Divorcio en California | FL-100: sus documentos, listos para que usted los presente.') },
  { tone: 'ink', title: L('Citizenship', 'Гражданство', 'Громадянство', 'Ciudadanía'), images: [], sheets: ['N-400'], pill: `${T.start} | N-400`, q: 'form=N-400',
    text: L('Citizenship | N-400: the naturalization application, checked line by line.', 'Гражданство | N-400: заявление на натурализацию, выверенное построчно.', 'Громадянство | N-400: заява на натуралізацію, вивірена порядково.', 'Ciudadanía | N-400: la solicitud de naturalización, revisada línea por línea.') },
  { tone: 'langs', title: L('Four languages', 'Четыре языка', 'Чотири мови', 'Cuatro idiomas'), images: [], sheets: [], pill: T.start, q: '',
    text: L('English · Русский · Українська · Español: forms in English, help in your language.', 'English · Русский · Українська · Español: формы на английском, помощь на вашем языке.', 'English · Русский · Українська · Español: форми англійською, допомога вашою мовою.', 'English · Русский · Українська · Español: formularios en inglés, ayuda en su idioma.') },
  { tone: 'steel', title: L('Small Claims', 'Малые иски', 'Малі позови', 'Reclamos menores'), images: ['/img/forms/sc-100-page-1'], sheets: [], pill: `${T.start} | SC-100`, q: 'form=SC-100',
    text: L('Small claims | SC-100: your claim and proof of service, ready for court.', 'Малые иски | SC-100: иск и подтверждение вручения — готовы для суда.', 'Малі позови | SC-100: позов і підтвердження вручення — готові для суду.', 'Reclamos menores | SC-100: su reclamo y la prueba de entrega, listos para el tribunal.') },
  { tone: 'deep', title: L('Immigration Court', 'Иммиграционный суд', 'Імміграційний суд', 'Corte de inmigración'), images: [], sheets: ['EOIR-42B', 'EOIR-28'], pill: `${T.start} | EOIR`, q: 'topic=EOIR',
    text: L('Immigration court | EOIR: motions, declarations and evidence, organized.', 'Иммиграционный суд | EOIR: ходатайства, декларации и доказательства — в порядке.', 'Імміграційний суд | EOIR: клопотання, декларації та докази — впорядковано.', 'Corte de inmigración | EOIR: mociones, declaraciones y pruebas, en orden.') }
];

// [code, English name, ru, uk, es]
const CARDS: Array<[string, string, string, string, string]> = [
  ['I-485', 'Adjustment of Status', 'корректировка статуса', 'коригування статусу', 'ajuste de estatus'],
  ['I-765', 'Employment Authorization', 'разрешение на работу', 'дозвіл на роботу', 'autorización de empleo'],
  ['N-400', 'Naturalization', 'натурализация', 'натуралізація', 'naturalización'],
  ['I-130', 'Petition for Alien Relative', 'петиция для родственника', 'петиція для родича', 'petición para familiar'],
  ['I-589', 'Asylum', 'убежище', 'притулок', 'asilo'],
  ['I-131', 'Travel Document', 'проездной документ', 'проїзний документ', 'documento de viaje'],
  ['I-90', 'Green Card Renewal', 'замена грин-карты', 'заміна грін-карти', 'renovación de green card'],
  ['I-751', 'Remove Conditions', 'снятие условий', 'зняття умов', 'eliminar condiciones'],
  ['I-864', 'Affidavit of Support', 'спонсорство', 'спонсорство', 'declaración de patrocinio'],
  ['EOIR-42B', 'Cancellation of Removal', 'отмена депортации', 'скасування депортації', 'cancelación de deportación'],
  ['FL-100', 'Dissolution of Marriage', 'расторжение брака', 'розірвання шлюбу', 'disolución del matrimonio'],
  ['FL-300', 'Request for Order', 'запрос о судебном приказе', 'запит про судовий наказ', 'solicitud de orden'],
  ['DV-100', 'Restraining Order', 'защитный ордер', 'захисний ордер', 'orden de restricción'],
  ['SC-100', "Plaintiff's Claim", 'малый иск', 'малий позов', 'reclamo menor'],
  ['UD-100', 'Unlawful Detainer', 'выселение', 'виселення', 'desalojo'],
  ['DE-111', 'Petition for Probate', 'наследство', 'спадщина', 'sucesión'],
  ['CR-180', 'Petition for Dismissal', 'снятие судимости', 'зняття судимості', 'limpiar antecedentes'],
  ['LLC-1', 'Articles of Organization', 'регистрация LLC', 'реєстрація LLC', 'constitución de LLC']
];
const cardName = (c: (typeof CARDS)[number]) => (lang === 'en' ? c[1] : `${c[1]} (${L(c[1], c[2], c[3], c[4])})`);

const H = {
  slider: L('Every form. In your language.', 'Любая форма. На вашем языке.', 'Будь-яка форма. Вашою мовою.', 'Cualquier formulario. En su idioma.'),
  prev: L('Previous slide', 'Предыдущий слайд', 'Попередній слайд', 'Diapositiva anterior'),
  next: L('Next slide', 'Следующий слайд', 'Наступний слайд', 'Diapositiva siguiente'),
  pause: L('Pause', 'Пауза', 'Пауза', 'Pausa'),
  play: L('Play', 'Воспроизвести', 'Відтворити', 'Reproducir'),
  slide: L('Slide', 'Слайд', 'Слайд', 'Diapositiva'),
  of: L('of', 'из', 'з', 'de'),
  forms: L('Forms we prepare', 'Формы, которые мы готовим', 'Форми, які ми готуємо', 'Formularios que preparamos')
};
---
<section class="hs" id="services" aria-label={L('Services', 'Услуги', 'Послуги', 'Servicios')}>
  <div class="hs-groups">
    {groups.map((g) => (
      <div class="hs-group" id={g.id}>
        <article class:list={['hs-big', g.dark && 'hs-big--dark']}>
          <div class="hs-copy">
            <h2 class="hs-big-title">{g.title}</h2>
            <p class="hs-big-sub">{g.sub}</p>
            <p class="hs-big-note">{g.note}</p>
            <div class="hs-ctas">
              <a class="hs-btn hs-btn--fill" href={g.more.href}>{g.more.label}</a>
              <a class="hs-btn hs-btn--line" href={start(g.startQ)}>{T.start}</a>
            </div>
          </div>
          <div class="hs-art" aria-hidden="true">
            {g.sheets.map((code, i) => <span class={`hs-sheet hs-sheet--back hs-sheet--${i}`}><b>{code}</b><i></i><i></i><i></i><i></i></span>)}
            {g.images.map((src, i) => (
              <img class={`hs-page hs-page--${i}`} src={`${src}.webp`} srcset={`${src}-480.webp 480w, ${src}.webp 760w`} sizes="(max-width: 734px) 46vw, 260px" alt="" width="330" height="427" loading="lazy" decoding="async" />
            ))}
          </div>
        </article>
        <ul class="hs-tiles" id={g.id === 'hs-courts' ? 'hs-courts-tiles' : undefined}>
          {g.tiles.map((t) => (
            <li class="hs-tile">
              <span class="hs-mini" aria-hidden="true"><b>{t.code}</b><i></i><i></i><i></i></span>
              <h3 class="hs-tile-title"><a href={t.href}>{t.title}</a></h3>
              <p class="hs-tile-sub">{t.sub}</p>
              <div class="hs-ctas hs-ctas--sm">
                <a class="hs-btn hs-btn--fill" href={t.href} aria-label={`${T.more}: ${t.title}`}>{T.more}</a>
                <a class="hs-btn hs-btn--line" href={start(t.q)} aria-label={`${T.start}: ${t.code}`}>{T.start}</a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="hs-slider" data-hs-slider aria-roledescription="carousel" aria-label={H.slider}>
    <h2 class="hs-slider-title">{H.slider}</h2>
    <div class="hs-viewport">
      <div class="hs-track" data-hs-track>
        {slides.map((s, i) => (
          <div class={`hs-slide hs-slide--${s.tone}`} data-hs-slide role="group" aria-roledescription="slide" aria-label={`${H.slide} ${i + 1} ${H.of} ${slides.length}`}>
            <div class="hs-slide-art" aria-hidden="true">
              {s.tone === 'langs' && <span class="hs-langs"><b>EN</b><b>RU</b><b>UA</b><b>ES</b></span>}
              {s.sheets.map((code, k) => <span class={`hs-sheet hs-sheet--slide hs-sheet--${k}`}><b>{code}</b><i></i><i></i><i></i><i></i></span>)}
              {s.images.map((src) => <img class="hs-slide-page" src={`${src}.webp`} srcset={`${src}-480.webp 480w, ${src}.webp 760w`} sizes="(max-width: 734px) 52vw, 340px" alt="" width="330" height="427" loading="lazy" decoding="async" />)}
            </div>
            <p class="hs-slide-title">{s.title}</p>
            <div class="hs-cap">
              <a class="hs-pill" href={start(s.q)}>{s.pill}</a>
              <p class="hs-cap-text">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="hs-controls">
      <button type="button" class="hs-arrow" data-hs-prev aria-label={H.prev}><span aria-hidden="true">‹</span></button>
      <div class="hs-dots" role="group" aria-label={H.slider}>
        {slides.map((_, i) => <button type="button" class="hs-dot" data-hs-dot={i} aria-label={`${H.slide} ${i + 1} ${H.of} ${slides.length}`}></button>)}
      </div>
      <button type="button" class="hs-arrow" data-hs-next aria-label={H.next}><span aria-hidden="true">›</span></button>
      <button type="button" class="hs-play" data-hs-play data-label-pause={H.pause} data-label-play={H.play} aria-label={H.pause}>
        <svg class="hs-ico-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="3" y="2" width="3" height="10" rx="1" fill="currentColor"/><rect x="8" y="2" width="3" height="10" rx="1" fill="currentColor"/></svg>
        <svg class="hs-ico-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2.5v9l7.5-4.5z" fill="currentColor"/></svg>
      </button>
    </div>

    <div class="hs-marquee" aria-label={H.forms}>
      <ul class="hs-belt">
        {[0, 1].map((copy) => CARDS.map((c) => (
          <li class="hs-card" aria-hidden={copy === 1 ? 'true' : undefined}>
            <span class="hs-card-code">{c[0]}</span>
            <span class="hs-card-name">{cardName(c)}</span>
            <a class="hs-card-btn" href={start('form=' + c[0])} tabindex={copy === 1 ? -1 : undefined}>{T.start}</a>
          </li>
        )))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hs {
    --hs-ink: #1d1d1f;
    --hs-muted: #6e6e73;
    --hs-tile: #f5f5f7;
    --hs-navy: #143254;
    --hs-blue: #0b4f9c;
    background: #fff;
    padding: 12px 0 72px;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
    color: var(--hs-ink);
    -webkit-font-smoothing: antialiased;
  }
  .hs h2, .hs h3, .hs p { margin: 0; }

  /* ---- tiles ---------------------------------------------------------- */
  .hs-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 0 max(12px, env(safe-area-inset-right, 0px)) 0 max(12px, env(safe-area-inset-left, 0px));
  }
  .hs-group { display: grid; gap: 12px; align-content: start; min-width: 0; }
  .hs-big {
    position: relative;
    overflow: hidden;
    background: var(--hs-tile);
    min-height: 580px;
    display: grid;
    grid-template-rows: auto 1fr;
    text-align: center;
  }
  .hs-big--dark { background: radial-gradient(120% 90% at 50% 100%, #1c4170 0%, #0d1f38 55%, #0a1628 100%); color: #f5f5f7; }
  .hs-copy { padding: 52px 24px 0; display: grid; gap: 8px; justify-items: center; position: relative; z-index: 2; }
  .hs-big-title { font-size: clamp(34px, 3.6vw, 48px); line-height: 1.08; font-weight: 600; letter-spacing: -0.015em; }
  .hs-big-sub { font-size: clamp(19px, 1.7vw, 24px); line-height: 1.2; letter-spacing: 0.005em; }
  .hs-big-note { font-size: 15px; line-height: 1.4; color: var(--hs-muted); max-width: 30em; }
  .hs-big-title, .hs-tile-title, .hs-slider-title { color: var(--hs-ink); }
  .hs-big--dark .hs-big-title, .hs-big--dark .hs-big-sub { color: #f5f5f7; }
  .hs-big--dark .hs-big-note { color: rgba(245, 245, 247, 0.72); }
  .hs-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 10px; }
  .hs-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 40px; padding: 0 20px; border-radius: 980px;
    font-size: 15px; font-weight: 500; text-decoration: none; white-space: nowrap;
    border: 1px solid var(--hs-navy);
    transition: background 0.2s, color 0.2s;
  }
  .hs-btn--fill { background: var(--hs-navy); color: #fff; }
  .hs-btn--fill:hover { background: #1c4170; color: #fff; }
  .hs-btn--line { color: var(--hs-navy); background: transparent; }
  .hs-btn--line:hover { background: var(--hs-navy); color: #fff; }
  .hs-big--dark .hs-btn--fill { background: #fff; border-color: #fff; color: var(--hs-navy); }
  .hs-big--dark .hs-btn--fill:hover { background: #e8eef6; color: var(--hs-navy); }
  .hs-big--dark .hs-btn--line { border-color: rgba(255, 255, 255, 0.85); color: #fff; }
  .hs-big--dark .hs-btn--line:hover { background: #fff; color: var(--hs-navy); }
  .hs-btn:focus-visible, .hs-pill:focus-visible, .hs-card-btn:focus-visible, .hs-tile-title a:focus-visible,
