    faqs: [
      ['¿Puede Imverica elegir mi categoría de elegibilidad de I-765?', 'No. El cliente debe proporcionar la categoría que ya seleccionó. Si tiene dudas, consulte a un abogado de inmigración con licencia o representante acreditado por DOJ.'],
      ['¿Puede Imverica decirme qué evidencia presentar?', 'No. Usted selecciona los documentos. Imverica puede organizar lo que identifica y señalar vacíos administrativos, pero no decide suficiencia legal.'],
      ['¿Cuál es la tarifa gubernamental?', 'El monto puede depender de la categoría y las circunstancias de presentación y puede cambiar. Revise la página I-765, las instrucciones de USCIS y G-1055 vigentes inmediatamente antes de presentar.'],
      ['¿Cuánto tarda la preparación?', 'Imverica confirma por escrito un plazo estimado después de recibir la entrevista y materiales completos. No promete ni controla el tiempo de USCIS.'],
      ['¿Imverica me representará ante USCIS?', 'No. Imverica no comparece, no firma G-28 y no se comunica como su representante legal.']
    ],
    sourcesHeading: 'Fuentes oficiales',
    sourcesIntro: 'Use las páginas y documentos vigentes de USCIS inmediatamente antes de presentar. Esta página no afirma una tarifa, edición, categoría, lista de evidencia o dirección de presentación como dato vigente.',
    cite: 'Imverica no es un bufete de abogados y no brinda asesoría legal. Los servicios directos de preparación son para clientes de California y siguen instrucciones específicas del cliente.',
    ctaHeading: '¿Ya eligió I-765 y la categoría?',
    ctaSub: 'Indique el alcance de preparación que seleccionó. Después de la entrevista completa, confirmamos por escrito la tarifa y el plazo estimado.'
  }
} as const;

const T = COPY[lang];
const canonical = `https://imverica.com${prefix}${slug}`;
const intakeHref = `${prefix}/#get-started?form=I-765`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: T.heading,
  serviceType: 'Form I-765 client-directed document preparation',
  url: canonical,
  description: T.description,
  areaServed: { '@type': 'State', name: 'California' },
  provider: { '@id': 'https://imverica.com/#organization' }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: T.faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---
<BaseLayout
  title={T.title}
  description={T.description}
  canonical={canonical}
  slug={slug}
  lang={lang}
  availableLocales={['en', 'ru', 'uk', 'es']}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Hero
    lang={lang}
    eyebrow={T.eyebrow}
    heading={T.heading}
    sub={T.hero}
    ctaPrimary={{ href: intakeHref, text: T.start }}
  />

  <LandingBody lang={lang} related={[
    { href: `${prefix}/uscis-document-review`, label: 'USCIS document review' },
    { href: `${prefix}/direct-document-preparation-vs-attorney-supervised-paralegal`, label: 'Direct preparation vs. attorney-supervised work' },
    { href: `${prefix}/lda`, label: 'California Legal Document Assistant' }
  ]}>
    <p class="lead">{T.lead}</p>

    <h2>{T.officialHeading}</h2>
    <p>{T.officialP1}</p>
    <p>{T.officialP2}</p>

    <h2>{T.scopeHeading}</h2>
    <div class="form-list">
      <strong>{T.scopeLabel}</strong>
      <ul>{T.scope.map(([label, text]) => <li><strong>{label}:</strong> {text}</li>)}</ul>
    </div>

    <h2>{T.limitsHeading}</h2>
    <ul>{T.limits.map((item) => <li>{item}</li>)}</ul>

    <h2>{T.processHeading}</h2>
    <ol>{T.process.map(([label, text]) => <li><strong>{label}.</strong> {text}</li>)}</ol>

    <h2>{T.faqHeading}</h2>
    {T.faqs.map(([question, answer]) => (
      <section class="i765-faq">
        <h3>{question}</h3>
        <p>{answer}</p>
      </section>
    ))}

    <h2>{T.sourcesHeading}</h2>
    <p>{T.sourcesIntro}</p>
    <ul>
      <li><a href="https://www.uscis.gov/i-765">USCIS — Form I-765 page</a></li>
      <li><a href="https://www.uscis.gov/sites/default/files/document/forms/i-765instr.pdf">USCIS — Form I-765 Instructions (PDF)</a></li>
      <li><a href="https://www.uscis.gov/sites/default/files/document/forms/g-1055.pdf">USCIS — Form G-1055 Fee Schedule (PDF)</a></li>
      <li><a href="https://www.uscis.gov/scams-fraud-and-misconduct/avoid-scams/find-legal-services">USCIS — Find Legal Services</a></li>
    </ul>
    <cite>{T.cite}</cite>
  </LandingBody>

  <CTAStrip
    lang={lang}
    heading={T.ctaHeading}
    sub={T.ctaSub}
    primaryHref={intakeHref}
    primaryText={T.start}
  />
</BaseLayout>

<style is:global>
  .i765-faq { margin: 0 0 18px; padding: 18px 20px; background: #fffaf2; border: 1px solid rgba(40,30,20,0.08); border-radius: 10px; }
  .i765-faq h3 { margin: 0 0 7px; color: var(--navy-dark); }
  .i765-faq p { margin: 0; }
</style>
