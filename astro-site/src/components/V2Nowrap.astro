---
/**
 * v2 preview: keeps form numbers (I-485, EOIR-42B, SC-100, CR-180 …) and the
 * phone number on one line. Wraps each match in <span class="v2-fno">
 * (white-space: nowrap in site-v2.css); the text itself is unchanged, so
 * copy, search and SEO see the same characters. Also covers content added
 * later (finder answers, chat replies). Does nothing without html.v2.
 */
---
<script is:inline>
(function () {
  var root = document.documentElement;
  if (!root.classList.contains('v2') || !window.MutationObserver) return;
  var RE = /\b[A-Z]{1,5}-\d{1,4}[A-Z]{0,2}\b|\+1 \(\d{3}\) \d{3}-\d{4}/g;
  var SKIP = /^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE|TEXTAREA|INPUT|SELECT|OPTION|OPTGROUP|DATALIST|TITLE|svg)$/i;
  function skip(el) {
    for (; el && el !== document.body; el = el.parentElement) {
      if (SKIP.test(el.nodeName) || el.isContentEditable || (el.classList && el.classList.contains('v2-fno')) || el.namespaceURI === 'http://www.w3.org/2000/svg') return true;
    }
    return false;
  }
  function wrap(node) {
    var text = node.nodeValue;
    RE.lastIndex = 0;
    if (!text || text.indexOf('-') < 0 || !RE.test(text)) return;
    RE.lastIndex = 0;
    var frag = document.createDocumentFragment();
    var at = 0;
    var m;
    while ((m = RE.exec(text))) {
      if (m.index > at) frag.appendChild(document.createTextNode(text.slice(at, m.index)));
      var span = document.createElement('span');
      span.className = 'v2-fno';
      span.textContent = m[0];
      frag.appendChild(span);
      at = m.index + m[0].length;
    }
    if (at < text.length) frag.appendChild(document.createTextNode(text.slice(at)));
    node.parentNode.replaceChild(frag, node);
  }
  function scan(el) {
    if (!el) return;
    if (el.nodeType === 3) { if (!skip(el.parentElement)) wrap(el); return; }
    if (el.nodeType !== 1 || skip(el)) return;
    var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    var list = [];
    for (var n = walker.nextNode(); n; n = walker.nextNode()) if (n.nodeValue.indexOf('-') >= 0) list.push(n);
    for (var i = 0; i < list.length; i++) if (!skip(list[i].parentElement)) wrap(list[i]);
  }
  try {
    scan(document.body);
    new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i++) {
        var r = records[i];
        if (r.type === 'characterData') { scan(r.target); continue; }
        for (var j = 0; j < r.addedNodes.length; j++) scan(r.addedNodes[j]);
      }
    }).observe(document.body, { childList: true, subtree: true, characterData: true });
  } catch (e) {}
})();
</script>
