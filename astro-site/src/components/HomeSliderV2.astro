---
/**
 * v2 homepage slider, after apple.com's "Endless entertainment": wide
 * slides that move right to left with the neighbours peeking in, dots,
 * arrows and a pause button, then an endless row of form cards.
 * Sits under the services block on the four homepages, inside
 * <template data-v2-new="slider"> (see V2Swap). Behaviour:
 * scripts/showcase-v2.ts. Form names stay in English; other languages get
 * the translation in parentheses.
 */
import type { Locale } from '~/data/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const L = (en: string, ru: string, uk: string, es: string) => ({ en, ru, uk, es }[lang]);
const start = (q: string) => `#get-started${q ? '?' + q : ''}`;
const T = { start: L('Start', 'Начать', 'Почати', 'Empezar') };

const slides = [
  { tone: 'navy', title: L('Green Card', 'Грин-карта', 'Грін-карта', 'Green Card'), images: ['/img/forms/i-485-page-1'], sheets: [], pill: `${T.start} | I-485`, q: 'form=I-485',
    text: L('Green card | I-485: the full adjustment packet, assembled at your direction.', 'Грин-карта | I-485: полный пакет на корректировку статуса — по вашему поручению.', 'Грін-карта | I-485: повний пакет на коригування статусу — за вашим дорученням.', 'Green card | I-485: el paquete completo de ajuste, armado bajo su dirección.') },
  { tone: 'slate', title: L('Divorce', 'Развод', 'Розлучення', 'Divorcio'), images: ['/img/forms/fl-100-page-1'], sheets: [], pill: `${T.start} | FL-100`, q: 'form=FL-100',
    text: L('Divorce in California | FL-100: your papers, ready for you to file.', 'Развод в Калифорнии | FL-100: документы готовы, подаёте вы сами.', 'Розлучення в Каліфорнії | FL-100: документи готові, подаєте ви самі.', 'Divorcio en California | FL-100: sus documentos, listos para que usted los presente.') },
  { tone: 'ink', title: L('Citizenship', 'Гражданство', 'Громадянство', 'Ciudadanía'), images: [], sheets: ['N-400'], pill: `${T.start} | N-400`, q: 'form=N-400',
    text: L('Citizenship | N-400: the naturalization application, checked line by line.', 'Гражданство | N-400: заявление на натурализацию, выверенное построчно.', 'Громадянство | N-400: заява на натуралізацію, вивірена порядково.', 'Ciudadanía | N-400: la solicitud de naturalización, revisada línea por línea.') },
  { tone: 'langs', title: L('Four languages', 'Четыре языка', 'Чотири мови', 'Cuatro idiomas'), images: [], sheets: [], pill: T.start, q: '',
    text: L('English · Русский · Українська · Español: forms in English, help in your language.', 'English · Русский · Українська · Español: формы на английском, помощь на вашем языке.', 'English · Русский · Українська · Español: форми англійською, допомога вашою мовою.', 'English · Русский · Українська · Español: formularios en inglés, ayuda en su idioma.') },
  { tone: 'steel', title: L('Small Claims', 'Малые иски', 'Малі позови', 'Reclamos menores'), images: ['/img/forms/sc-100-page-1'], sheets: [], pill: `${T.start} | SC-100`, q: 'form=SC-100',
    text: L('Small claims | SC-100: your claim and proof of service, ready for court.', 'Малые иски | SC-100: иск и подтверждение вручения — готовы для суда.', 'Малі позови | SC-100: позов і підтвердження вручення — готові для суду.', 'Reclamos menores | SC-100: su reclamo y la prueba de entrega, listos para el tribunal.') },
  { tone: 'deep', title: L('Immigration Court', 'Иммиграционный суд', 'Імміграційний суд', 'Corte de inmigración'), images: [], sheets: ['EOIR-42B', 'EOIR-28'], pill: `${T.start} | EOIR`, q: 'topic=EOIR',
    text: L('Immigration court | EOIR: motions, declarations and evidence, organized.', 'Иммиграционный суд | EOIR: ходатайства, декларации и доказательства — в порядке.', 'Імміграційний суд | EOIR: клопотання, декларації та докази — впорядковано.', 'Corte de inmigración | EOIR: mociones, declaraciones y pruebas, en orden.') }
];

// [code, English name, ru, uk, es]
const CARDS: Array<[string, string, string, string, string]> = [
  ['I-485', 'Adjustment of Status', 'корректировка статуса', 'коригування статусу', 'ajuste de estatus'],
  ['I-765', 'Employment Authorization', 'разрешение на работу', 'дозвіл на роботу', 'autorización de empleo'],
  ['N-400', 'Naturalization', 'натурализация', 'натуралізація', 'naturalización'],
  ['I-130', 'Petition for Alien Relative', 'петиция для родственника', 'петиція для родича', 'petición para familiar'],
  ['I-589', 'Asylum', 'убежище', 'притулок', 'asilo'],
  ['I-131', 'Travel Document', 'проездной документ', 'проїзний документ', 'documento de viaje'],
  ['I-90', 'Green Card Renewal', 'замена грин-карты', 'заміна грін-карти', 'renovación de green card'],
  ['I-751', 'Remove Conditions', 'снятие условий', 'зняття умов', 'eliminar condiciones'],
  ['I-864', 'Affidavit of Support', 'спонсорство', 'спонсорство', 'declaración de patrocinio'],
  ['EOIR-42B', 'Cancellation of Removal', 'отмена депортации', 'скасування депортації', 'cancelación de deportación'],
  ['FL-100', 'Dissolution of Marriage', 'расторжение брака', 'розірвання шлюбу', 'disolución del matrimonio'],
  ['FL-300', 'Request for Order', 'запрос о судебном приказе', 'запит про судовий наказ', 'solicitud de orden'],
  ['DV-100', 'Restraining Order', 'защитный ордер', 'захисний ордер', 'orden de restricción'],
  ['SC-100', "Plaintiff's Claim", 'малый иск', 'малий позов', 'reclamo menor'],
  ['UD-100', 'Unlawful Detainer', 'выселение', 'виселення', 'desalojo'],
  ['DE-111', 'Petition for Probate', 'наследство', 'спадщина', 'sucesión'],
  ['CR-180', 'Petition for Dismissal', 'снятие судимости', 'зняття судимості', 'limpiar antecedentes'],
  ['LLC-1', 'Articles of Organization', 'регистрация LLC', 'реєстрація LLC', 'constitución de LLC']
];
const cardName = (c: (typeof CARDS)[number]) => (lang === 'en' ? c[1] : `${c[1]} (${L(c[1], c[2], c[3], c[4])})`);

const H = {
  slider: L('Every form. In your language.', 'Любая форма. На вашем языке.', 'Будь-яка форма. Вашою мовою.', 'Cualquier formulario. En su idioma.'),
  prev: L('Previous slide', 'Предыдущий слайд', 'Попередній слайд', 'Diapositiva anterior'),
  next: L('Next slide', 'Следующий слайд', 'Наступний слайд', 'Diapositiva siguiente'),
  pause: L('Pause', 'Пауза', 'Пауза', 'Pausa'),
  play: L('Play', 'Воспроизвести', 'Відтворити', 'Reproducir'),
  slide: L('Slide', 'Слайд', 'Слайд', 'Diapositiva'),
  of: L('of', 'из', 'з', 'de'),
  forms: L('Forms we prepare', 'Формы, которые мы готовим', 'Форми, які ми готуємо', 'Formularios que preparamos')
};
---
<section class="hs" id="forms-slider">
  <div class="hs-slider" data-hs-slider aria-roledescription="carousel" aria-label={H.slider}>
    <h2 class="hs-slider-title">{H.slider}</h2>
    <div class="hs-viewport">
      <div class="hs-track" data-hs-track>
        {slides.map((s, i) => (
          <div class={`hs-slide hs-slide--${s.tone}`} data-hs-slide role="group" aria-roledescription="slide" aria-label={`${H.slide} ${i + 1} ${H.of} ${slides.length}`}>
            <div class="hs-slide-art" aria-hidden="true">
              {s.tone === 'langs' && <span class="hs-langs"><b>EN</b><b>RU</b><b>UA</b><b>ES</b></span>}
              {s.sheets.map((code, k) => <span class={`hs-sheet hs-sheet--slide hs-sheet--${k}`}><b>{code}</b><i></i><i></i><i></i><i></i></span>)}
              {s.images.map((src) => <img class="hs-slide-page" src={`${src}.webp`} srcset={`${src}-480.webp 480w, ${src}.webp 760w`} sizes="(max-width: 734px) 52vw, 340px" alt="" width="330" height="427" loading="lazy" decoding="async" />)}
            </div>
            <p class="hs-slide-title">{s.title}</p>
            <div class="hs-cap">
              <a class="hs-pill" href={start(s.q)}>{s.pill}</a>
              <p class="hs-cap-text">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="hs-controls">
      <button type="button" class="hs-arrow" data-hs-prev aria-label={H.prev}><span aria-hidden="true">‹</span></button>
      <div class="hs-dots" role="group" aria-label={H.slider}>
        {slides.map((_, i) => <button type="button" class="hs-dot" data-hs-dot={i} aria-label={`${H.slide} ${i + 1} ${H.of} ${slides.length}`}></button>)}
      </div>
      <button type="button" class="hs-arrow" data-hs-next aria-label={H.next}><span aria-hidden="true">›</span></button>
      <button type="button" class="hs-play" data-hs-play data-label-pause={H.pause} data-label-play={H.play} aria-label={H.pause}>
        <svg class="hs-ico-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="3" y="2" width="3" height="10" rx="1" fill="currentColor"/><rect x="8" y="2" width="3" height="10" rx="1" fill="currentColor"/></svg>
        <svg class="hs-ico-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2.5v9l7.5-4.5z" fill="currentColor"/></svg>
      </button>
    </div>

    <div class="hs-marquee" aria-label={H.forms}>
      <ul class="hs-belt">
        {[0, 1].map((copy) => CARDS.map((c) => (
          <li class="hs-card" aria-hidden={copy === 1 ? 'true' : undefined}>
            <span class="hs-card-code">{c[0]}</span>
            <span class="hs-card-name">{cardName(c)}</span>
            <a class="hs-card-btn" href={start('form=' + c[0])} tabindex={copy === 1 ? -1 : undefined}>{T.start}</a>
          </li>
        )))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hs {
    --hs-ink: #1d1d1f;
    --hs-muted: #6e6e73;
    --hs-tile: #f5f5f7;
    --hs-navy: #143254;
    --hs-blue: #0b4f9c;
    background: #fff;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
    color: var(--hs-ink);
    -webkit-font-smoothing: antialiased;
  }
  .hs h2, .hs h3, .hs p { margin: 0; }

  /* ---- slider --------------------------------------------------------- */
  .hs-slider-title { color: var(--hs-ink); }
  .hs-pill:focus-visible, .hs-card-btn:focus-visible, .hs-dot:focus-visible, .hs-arrow:focus-visible, .hs-play:focus-visible { outline: 2px solid #3a7bd5; outline-offset: 3px; }
  .hs-slider { background: var(--hs-tile); padding: 56px 0 44px; overflow: hidden; }
  .hs-slider-title { text-align: center; font-size: clamp(30px, 3.4vw, 48px); font-weight: 600; letter-spacing: -0.015em; line-height: 1.1; padding: 0 16px 34px; }
  .hs-viewport { --hs-sw: min(980px, 82vw); --hs-gap: 12px; position: relative; overflow: hidden; touch-action: pan-y; }
  .hs-track {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: var(--hs-gap);
    transform: translate3d(calc((100vw - var(--hs-sw)) / 2), 0, 0);
    will-change: transform;
  }
  .hs-track.is-anim { transition: transform 0.9s cubic-bezier(.45,.05,.25,1); }
  .hs-slide {
    flex: 0 0 var(--hs-sw); position: relative; overflow: hidden;
    aspect-ratio: 16 / 8.4; border-radius: 0;
    color: #fff; isolation: isolate;
  }
  /* neighbours: dimmed art, caption hidden (it returns when the slide is centred) */
  .hs-slide:not(.is-current) .hs-slide-art { opacity: 0.5; }
  .hs-slide-art { transition: opacity 0.6s; }
  .hs-cap { transition: opacity 0.5s, visibility 0.5s; }
  .hs-slide:not(.is-current) .hs-cap { opacity: 0; visibility: hidden; }
  .hs-slide--navy { background: linear-gradient(135deg, #0d1f38 0%, #143254 55%, #1f4f86 100%); }
  .hs-slide--slate { background: linear-gradient(135deg, #2b3440 0%, #46586d 60%, #6f8299 100%); }
  .hs-slide--ink { background: radial-gradient(90% 120% at 70% 30%, #23466f 0%, #0b1628 70%); }
  .hs-slide--langs { background: linear-gradient(120deg, #143254 0%, #3a5f8f 50%, #9db4d2 100%); }
  .hs-slide--steel { background: linear-gradient(135deg, #1b2a3c 0%, #2e4a69 50%, #557aa3 100%); }
  .hs-slide--deep { background: linear-gradient(160deg, #060d18 0%, #12294a 60%, #1d3d66 100%); }
  .hs-slide-art { position: absolute; inset: 0; z-index: -1; }
  .hs-slide-page {
    position: absolute; right: 9%; top: 7%; width: min(300px, 30%); height: auto;
    background: #fff; border-radius: 6px; transform: rotate(4deg);
    box-shadow: 0 40px 80px -24px rgba(0, 0, 0, 0.6);
  }
  .hs-sheet {
    position: absolute; aspect-ratio: 8.5 / 11; background: #fff; border-radius: 6px;
    box-shadow: 0 24px 50px -22px rgba(8, 20, 40, 0.5), 0 1px 4px rgba(8, 20, 40, 0.14);
    display: grid; align-content: start; gap: 9px; padding: 18px 16px;
    color: #143254;
  }
  .hs-sheet b { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
  .hs-sheet i { display: block; height: 6px; border-radius: 3px; background: #e3e7ee; }
  .hs-sheet i:nth-of-type(2) { width: 82%; }
  .hs-sheet i:nth-of-type(3) { width: 64%; }
  .hs-sheet i:nth-of-type(4) { width: 74%; }
  .hs-sheet--slide { width: min(300px, 30%); top: 10%; right: 12%; }
  .hs-sheet--slide.hs-sheet--1 { right: 30%; top: 16%; transform: rotate(-7deg); opacity: 0.9; z-index: -1; }
  .hs-sheet--slide.hs-sheet--0 { transform: rotate(5deg); }
  .hs-langs { position: absolute; right: 8%; top: 50%; transform: translateY(-58%); display: grid; grid-template-columns: repeat(2, auto); gap: 14px; }
  .hs-langs b {
    display: grid; place-items: center; width: clamp(64px, 9vw, 120px); aspect-ratio: 1;
    border-radius: 24%; background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.35);
    font-size: clamp(22px, 3vw, 40px); font-weight: 600; letter-spacing: 0.02em; color: #fff;
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .hs-slide-title {
    position: absolute; left: 6%; top: 11%; max-width: 46%;
    font-size: clamp(30px, 4.2vw, 56px); line-height: 1.04; font-weight: 600; letter-spacing: -0.02em;
    color: #fff; text-wrap: balance;
  }
  .hs-cap {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; gap: 14px; padding: 22px 26px;
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.38) 100%);
  }
  .hs-pill {
    flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 36px; padding: 0 16px;
    border-radius: 980px; background: #fff; color: #1d1d1f; font-size: 14px; font-weight: 500; text-decoration: none; white-space: nowrap;
  }
  .hs-pill:hover { background: #e8eef6; color: #1d1d1f; }
  .hs-cap-text { font-size: 15px; line-height: 1.35; color: rgba(255, 255, 255, 0.92); min-width: 0; }

  .hs-controls { display: flex; justify-content: center; align-items: center; gap: 10px; padding: 20px 16px 0; }
  .hs-dots { display: flex; gap: 2px; align-items: center; background: rgba(0, 0, 0, 0.06); border-radius: 980px; padding: 6px 10px; }
  .hs-dot {
    width: 24px; height: 24px; padding: 0; border: 0; background: transparent; cursor: pointer;
    display: grid; place-items: center;
  }
  .hs-dot::before { content: ""; width: 8px; height: 8px; border-radius: 4px; background: rgba(0, 0, 0, 0.32); transition: width 0.35s, background 0.35s; }
  .hs-dot[aria-current="true"]::before { width: 22px; background: #1d1d1f; }
  .hs-arrow, .hs-play {
    width: 36px; height: 36px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(0, 0, 0, 0.06); color: #1d1d1f; display: grid; place-items: center; font-size: 22px; line-height: 1;
  }
  .hs-arrow:hover, .hs-play:hover { background: rgba(0, 0, 0, 0.1); }
  .hs-play .hs-ico-play { display: none; }
  .hs-play.is-paused .hs-ico-play { display: block; }
  .hs-play.is-paused .hs-ico-pause { display: none; }

  .hs-marquee { margin-top: 30px; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%); }
  .hs-belt { list-style: none; margin: 0; padding: 0 0 4px; display: flex; gap: 12px; width: max-content; animation: hs-belt 70s linear infinite; }
  .hs-marquee:hover .hs-belt, .hs-marquee:focus-within .hs-belt, .hs-slider.is-paused .hs-belt { animation-play-state: paused; }
  @keyframes hs-belt { to { transform: translate3d(calc(-50% - 6px), 0, 0); } }
  .hs-card {
    flex: 0 0 auto; width: 236px; min-height: 132px; background: #fff; border-radius: 16px; padding: 16px 16px 14px;
    display: grid; grid-template-rows: auto 1fr auto; gap: 4px; justify-items: start;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .hs-card-code { font-size: 21px; font-weight: 700; color: #143254; letter-spacing: -0.01em; white-space: nowrap; }
  .hs-card-name { font-size: 13px; line-height: 1.35; color: var(--hs-muted); }
  .hs-card-btn {
    margin-top: 6px; display: inline-flex; align-items: center; min-height: 28px; padding: 0 12px; border-radius: 980px;
    border: 1px solid #143254; color: #143254; font-size: 12px; font-weight: 500; text-decoration: none;
  }
  .hs-card-btn:hover { background: #143254; color: #fff; }

  /* ---- tablet / phone ---------------------------------------------- */
  @media (max-width: 734px) {
    .hs-viewport { --hs-sw: 86vw; --hs-gap: 10px; }
    .hs-slide { aspect-ratio: 4 / 5; }
    .hs-slide-title { left: 20px; right: 20px; top: 20px; max-width: none; font-size: 28px; }
    .hs-slide-page { width: 46%; right: 50%; top: 24%; transform: translateX(50%) rotate(3deg); }
    .hs-sheet--slide { width: 44%; right: 50%; top: 25%; }
    .hs-sheet--slide.hs-sheet--0 { transform: translateX(50%) rotate(4deg); }
    .hs-sheet--slide.hs-sheet--1 { right: 62%; top: 14%; transform: translateX(50%) rotate(-8deg); }
    .hs-langs { right: 50%; top: 46%; transform: translate(50%, -50%); }
    .hs-cap { flex-direction: column; align-items: flex-start; gap: 10px; padding: 18px; }
    .hs-cap-text { font-size: 14px; }
    .hs-card { width: 200px; }
  }
</style>

<script>
  import { initShowcase } from '~/scripts/showcase-v2';
  initShowcase();
</script>
